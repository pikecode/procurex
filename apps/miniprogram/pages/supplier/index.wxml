<test-context wx:if="{{activeView === 'mine'}}" />
<wxs src="../../utils/labels.wxs" module="labels" />
<view class="page {{workspaceTabbarVisible ? 'has-workspace-tabbar' : ''}}{{activeView === 'orders' && selectedOrder && (selectedOrder.canShip || selectedOrder.canReject) || activeView === 'differences' && selectedDiscrepancy.canReplenish || activeView === 'payments' && selectedPayment.status === 'PENDING' ? 'has-action-bar' : ''}}">
  <view class="business-heading"><view><text class="business-title">供货管理</text><text class="muted">{{user.displayName}}</text></view><view class="heading-actions"><button class="ghost" bindtap="loadWork" loading="{{loading}}" disabled="{{loading}}">刷新</button></view></view>
  <view class="workspace-loading" wx:if="{{loading}}">正在更新供货信息</view>
  <view wx:if="{{error}}" class="error-banner"><text>{{error}}</text><button class="ghost" bindtap="loadWork" disabled="{{loading || shipping || rejecting || paying}}">刷新数据</button></view>
  <view wx:if="{{pendingCommand}}" class="command-recovery"><view><text class="row-title">{{pendingCommand.title}} · 结果待确认</text><text class="muted">{{pendingCommand.dateText}}</text></view><button class="secondary" bindtap="recoverCommand" disabled="{{recovering || shipping || rejecting || resolving || paying || freightRequesting}}" loading="{{recovering}}">确认提交结果</button></view>
  <view wx:if="{{statementReturnId && orderMode === 'detail'}}" class="source-return" bindtap="backToList">返回账单</view>
  <view wx:if="{{activeView === 'tasks' && objectionTasks.length}}"><view class="task-heading"><text>门店订单异议</text><text>{{objectionTasks.length}}</text></view><view class="card"><view class="task-entry" wx:for="{{objectionTasks}}" wx:key="id" data-id="{{item.id}}" bindtap="openTaskOrder"><view><text>{{item.storeName}}</text><text class="muted">{{item.supplierOrderNo}}</text></view><text>处理异议 ›</text></view></view></view>
  <view class="business-nav"><view class="nav-item {{activeView === 'tasks' || activeView === 'differences' ? 'is-active' : ''}}" data-view="tasks" bindtap="changeView">待办</view><view class="nav-item {{activeView === 'orders' ? 'is-active' : ''}}" data-view="orders" bindtap="changeView">订单</view><view class="nav-item {{activeView === 'payments' || activeView === 'reports' ? 'is-active' : ''}}" data-view="payments" bindtap="changeView">对账</view><view class="nav-item {{activeView === 'mine' ? 'is-active' : ''}}" data-view="mine" bindtap="changeView">我的</view></view>
  <block wx:if="{{activeView === 'tasks'}}"><view class="task-heading"><text>待发货订单</text><text>{{loading || error ? '—' : shippingTasks.length}}</text></view><view class="card task-list-card"><view class="task-entry supplier-task-entry pressable" wx:for="{{shippingTasks}}" wx:key="id" data-id="{{item.id}}" bindtap="openTaskOrder"><view class="supplier-task-main"><view class="supplier-task-heading"><text class="supplier-task-store">{{item.storeName || '供货订单'}}</text><text class="supplier-task-amount">¥{{labels.money(item.supplyGoodsAmount)}}</text></view><view class="supplier-task-products"><text class="supplier-task-count">{{item.itemCount}} 种商品</text><text class="supplier-task-preview">{{item.productPreview}}</text><text wx:if="{{item.productMoreCount > 0}}" class="supplier-task-more">另 {{item.productMoreCount}} 种</text></view><view class="supplier-task-meta"><text>{{item.supplierOrderNo}}</text><text>{{item.createdText}}</text></view></view><text class="supplier-task-chevron">›</text></view><view class="empty-state" wx:if="{{!shippingTasks.length && !loading && !error}}"><text>暂无待发货订单</text><button class="empty-action" data-view="orders" data-filter="SHIPPED" bindtap="gotoView">查看已发货订单 ›</button></view></view><view class="task-heading supplier-exception-heading"><text>少收与补发</text><text>{{loading || error ? '—' : differenceTasks.length}}</text></view><view class="card supplier-exception-card"><view class="task-entry pressable" wx:for="{{differenceTasks}}" wx:key="id" data-id="{{item.id}}" bindtap="openTaskDifference"><view><text>{{item.productName || '收货异常'}}</text><text class="muted">{{item.supplierOrderNo}}</text></view><text>{{item.status === 'OPEN' ? '核对少收' : '安排补发'}} ›</text></view><view class="supplier-exception-empty" wx:if="{{!differenceTasks.length && !loading && !error}}">暂无待处理异常</view><view class="supplier-history-link" wx:if="{{discrepancies.length > 0 && !loading && !error}}" data-view="differences" bindtap="changeView"><text>查看全部收货异常</text><text>{{discrepancies.length}} 条 ›</text></view></view></block>
  <view class="reconcile-tabs sticky-bar" wx:if="{{activeView === 'payments' || activeView === 'reports'}}"><view class="{{activeView === 'payments' ? 'selected' : ''}}" data-view="payments" bindtap="changeView">收款核对</view><view class="{{activeView === 'reports' ? 'selected' : ''}}" data-view="reports" bindtap="changeView">结算账单</view></view>
  <block wx:if="{{activeView === 'mine'}}"><view class="account-menu supplier-mine-menu"><view class="account-menu-item" bindtap="openProfile"><view><text>供应商资料</text><text class="account-menu-note">联系人、配送、结算与开票资料</text></view><text>›</text></view><view class="account-menu-item" bindtap="openProducts"><view><text>供货商品</text><text class="account-menu-note">查看关联商品并维护供货状态</text></view><text>›</text></view></view><button class="account-logout" bindtap="logout">退出登录</button></block>

  <view class="card" wx:if="{{activeView === 'orders' && (selectedOrder || orderLoading)}}">
    <view class="detail-heading"><text wx:if="{{!statementReturnId && orderMode === 'detail'}}" class="back-link" bindtap="backToList">‹ 返回订单</text><text wx:if="{{orderMode !== 'detail'}}" class="back-link" data-mode="detail" bindtap="changeOrderMode">‹ 返回订单详情</text><text class="card-title">{{orderMode === 'revise' ? '修改发货数量' : '订单详情'}}</text></view>
    <view wx:if="{{orderLoading}}" class="muted">正在读取订单明细</view>
    <view wx:if="{{selectedOrder}}">
      <view class="supplier-order-summary"><text class="summary-store">{{selectedOrder.destination.name || selectedOrder.storeName || '收货门店'}}</text><text class="status {{selectedOrder.listState === 'COMPLETED' ? 'tone-brand' : selectedOrder.status === 'REJECTED' ? 'tone-danger' : 'tone-warn'}}">{{selectedOrder.displayStatus}}</text></view>
      <view class="supplier-detail-number"><text>订单号</text><document-no wx:if="{{selectedOrder.supplierOrderNo}}" value="{{selectedOrder.supplierOrderNo}}" /><text wx:else>暂未获取</text></view>
      <view class="operation-title" wx:if="{{orderMode !== 'detail'}}">{{orderMode === 'ship' ? '填写本次发货' : orderMode === 'reject' ? '拒绝供货' : '修订发货数量'}}</view>
      <view class="destination"><text class="destination-label">收货信息</text><view class="detail-line">{{selectedOrder.destination.address || '收货地址未配置'}}</view><view class="muted">{{selectedOrder.destination.contactName || '联系人未配置'}} · <text class="contact-phone" bindtap="callContact">{{selectedOrder.destination.contactPhone || '联系电话未配置'}}</text></view></view>

<view class="section-band" wx:if="{{orderMode === 'revise'}}"><view class="row-title"><text>{{revisionShipment.shipmentNo}}</text><text class="status tone-warn">修订后数量不得超过订购数量</text></view><view class="revision-line" wx:for="{{revisionItems}}" wx:key="id"><view class="row-title"><text>{{item.productName}}</text><text class="muted">订购 {{item.orderedQuantity}}</text></view><view class="field"><text class="field-label">本批发货数量</text><input type="digit" value="{{item.revisedQuantity}}" data-id="{{item.id}}" bindinput="onRevisionQuantity" disabled="{{revising || revisionUploading}}" /></view></view><view class="field" wx:if="{{revisionNeedsEvidence}}"><text class="field-label">异常发货备注 · 必填</text><input maxlength="500" value="{{revisionNote}}" data-field="revisionNote" bindinput="onInput" disabled="{{revising || revisionUploading}}" placeholder="说明少发原因" /></view><view class="field" wx:if="{{revisionNeedsEvidence}}"><text class="field-label">发货凭证 · 必填</text><view class="revision-evidence-grid"><view class="revision-evidence-tile" wx:for="{{revisionEvidence}}" wx:key="id"><image src="{{item.path}}" mode="aspectFill" /><button class="evidence-remove" data-index="{{index}}" bindtap="removeRevisionEvidence" disabled="{{revising || revisionUploading}}">×</button></view><button class="evidence-add" wx:if="{{revisionEvidence.length < 6}}" bindtap="chooseRevisionEvidence" disabled="{{revising || revisionUploading}}">{{revisionUploading ? '上传中' : '+'}}</button></view></view><view class="button-row action-bar"><button data-mode="detail" bindtap="changeOrderMode" disabled="{{revising || revisionUploading}}">取消修改</button><button class="primary" bindtap="reviseShipment" disabled="{{revising || revisionUploading}}" loading="{{revising}}">保存发货修订</button></view></view>
      <view class="detail-section-heading" wx:if="{{orderMode !== 'revise'}}"><text>商品明细</text><text>{{shipmentItems.length}} 种</text></view>
      <view class="row supplier-shipment-item" wx:if="{{orderMode !== 'revise' && (orderMode !== 'ship' || item.remainingQuantity > 0)}}" wx:for="{{shipmentItems}}" wx:key="id">
        <view wx:if="{{orderMode === 'ship'}}" class="shipment-selection" data-id="{{item.id}}" bindtap="selectShipmentItem"><checkbox checked="{{item.selectedForShipment}}" disabled="{{shipping}}" color="#176b4c" />本批发货</view>
        <product-card product="{{item}}" bind:retryimage="retryProductImage"><view class="supplier-product-heading"><text>{{item.productName || '商品'}}</text><text wx:if="{{orderMode === 'ship'}}" class="status tone-brand">可发 {{item.remainingQuantity}} {{item.unitName}}</text></view>
          <view class="muted">订购 {{item.quantity}} · 已发 {{item.shippedQuantity}} · 实收 {{item.receivedQuantity}} {{item.unitName || '历史单位未记录'}}</view>
          <view class="muted" wx:if="{{item.unitSnapshot.purchaseUnitId}}">1 {{item.purchaseUnitName || item.unitSnapshot.purchaseUnitName}} = {{item.unitSnapshot.salesUnitsPerPurchaseUnit}} {{item.unitName}} · ¥{{labels.money(item.purchaseSupplyUnitPrice)}} / {{item.purchaseUnitName || item.unitSnapshot.purchaseUnitName}}</view>
          <view class="muted">供货单价 ¥{{labels.money(item.supplyUnitPrice)}} · 货款 ¥{{labels.money(item.supplyLineAmount)}}</view>
          <view class="field" wx:if="{{selectedOrder.canShip && orderMode === 'ship' && item.selectedForShipment}}"><text class="field-label">本次发货数量（{{item.unitName}}）</text><input type="digit" value="{{item.shipQuantity}}" data-id="{{item.id}}" disabled="{{shipping || rejecting}}" bindinput="onShipQuantity" /><text wx:if="{{item.shipQuantityError}}" class="shipment-quantity-error">{{item.shipQuantityError}}</text></view>
        </product-card>
      </view>
      <view class="list shipment-history" wx:if="{{orderMode === 'detail' && selectedOrder.shipments.length}}">
        <view class="detail-section-heading"><text>发货记录</text><text>{{selectedOrder.shipments.length}} 批</text></view>
        <view class="row shipment-history-row" wx:for="{{selectedOrder.shipments}}" wx:key="id">
          <view class="shipment-record-heading"><text>{{item.shippedDate}}</text><text class="status {{item.currentReceiptRevision ? 'tone-brand' : 'tone-warn'}}">{{item.currentReceiptRevision ? '门店已提交收货' : '待门店收货'}}</text></view>
          <view class="shipment-record-number"><text>{{item.kind === 'INITIAL' ? '发货单号' : '补发单号'}}</text><document-no value="{{item.shipmentNo}}" /></view>
          <view class="shipment-products">{{item.productPreview}}</view>
          <view class="field" wx:if="{{item.receiptHasException}}"><text class="status tone-warn">门店异常收货</text><text class="muted">{{item.receiptNote || '存在收货异常'}}</text><evidence-files files="{{item.receiptEvidenceFiles}}" /><view class="muted" wx:for="{{item.receiptDifferences}}" wx:for-item="difference" wx:key="productName">{{difference.productName}} · 发货 {{labels.quantity(difference.shippedQuantity)}} · 实收 {{labels.quantity(difference.receivedQuantity)}} · 少收 {{labels.quantity(difference.missingQuantity)}}</view></view>
          <view class="field" wx:if="{{item.receiptExceptionStatus}}">
            <text class="muted">{{item.receiptExceptionStatus === 'REGISTERED' ? '门店已登记，尚未提交处理' : item.receiptExceptionStatus === 'SUBMITTED' ? '待回复门店' : item.receiptExceptionStatus === 'RESPONDED' ? item.receiptExceptionDecision === 'REPLENISH' && item.canConfirmReceiptException === false ? '补发方案执行中' : '已回复，待门店确认' : '门店已确认解决'}}</text>
            <text class="muted" wx:if="{{item.receiptExceptionResolution}}">门店说明：{{item.receiptExceptionResolution}}</text>
            <view class="exception-reply-history" wx:for="{{item.receiptExceptionReplies}}" wx:for-item="reply" wx:key="id"><view class="row-title"><text>{{reply.decision === 'REPLENISH' ? '安排补发' : reply.decision === 'ACCEPT_SHORTAGE' ? '确认不再补发' : reply.decision === 'DECLINED' ? '回复无法处理' : '回复已处理'}}</text><text class="muted">{{reply.createdText}}</text></view><text class="muted">{{reply.actorName}} · {{reply.note}}</text><evidence-files files="{{reply.evidenceFiles}}" compact="{{true}}" /></view>
            <text class="muted" wx:if="{{!item.receiptExceptionReplies.length && item.receiptExceptionResponse}}">处理回复：{{item.receiptExceptionResponse}}</text>
            <view class="button-row" wx:if="{{item.receiptExceptionStatus === 'SUBMITTED' && exceptionReplyReceiptId !== item.receiptId}}"><button class="primary" data-receipt-id="{{item.receiptId}}" data-decision="{{item.receiptDifferences.length ? 'REPLENISH' : 'HANDLED'}}" bindtap="respondReceiptException" disabled="{{deliveryBusy || exceptionReplyUploading}}">{{item.receiptDifferences.length ? '安排补发' : '回复已处理'}}</button><button class="secondary" data-receipt-id="{{item.receiptId}}" data-decision="{{item.receiptDifferences.length ? 'ACCEPT_SHORTAGE' : 'DECLINED'}}" bindtap="respondReceiptException" disabled="{{deliveryBusy || exceptionReplyUploading}}">{{item.receiptDifferences.length ? '不再补发' : '无法处理'}}</button></view>
            <button class="secondary" wx:if="{{item.receiptExceptionStatus === 'RESPONDED' && item.receiptExceptionDecision === 'REPLENISH' && exceptionReplyReceiptId !== item.receiptId}}" data-receipt-id="{{item.receiptId}}" data-decision="ACCEPT_SHORTAGE" bindtap="respondReceiptException" disabled="{{deliveryBusy || exceptionReplyUploading}}">调整为不再补发</button>
            <view class="exception-reply-form" wx:if="{{exceptionReplyReceiptId === item.receiptId}}">
              <text class="card-title">{{exceptionReplyDecision === 'REPLENISH' ? '安排补发' : exceptionReplyDecision === 'ACCEPT_SHORTAGE' ? '确认不再补发' : exceptionReplyDecision === 'HANDLED' ? '回复已处理' : '回复无法处理'}}</text>
              <view class="field"><text class="field-label">处理说明 · 必填</text><textarea maxlength="500" value="{{exceptionReplyNote}}" data-field="exceptionReplyNote" bindinput="onInput" disabled="{{deliveryBusy || exceptionReplyUploading}}" placeholder="{{exceptionReplyDecision === 'REPLENISH' ? '说明补发安排' : exceptionReplyDecision === 'ACCEPT_SHORTAGE' ? '说明不再补发的原因，等待门店确认' : '填写处理结果或无法处理的原因'}}" /></view>
              <view class="row-title"><text class="field-label">处理凭证 · 选填</text><text class="muted">{{exceptionReplyEvidence.length}} / 6</text></view>
              <view class="revision-evidence-grid"><view class="revision-evidence-tile" wx:for="{{exceptionReplyEvidence}}" wx:for-item="proof" wx:key="id"><image src="{{proof.path}}" mode="aspectFill" /><button class="evidence-remove" data-index="{{index}}" bindtap="removeReceiptReplyEvidence" disabled="{{deliveryBusy || exceptionReplyUploading}}">×</button></view><button class="evidence-add" wx:if="{{exceptionReplyEvidence.length < 6}}" bindtap="chooseReceiptReplyEvidence" disabled="{{deliveryBusy || exceptionReplyUploading}}" loading="{{exceptionReplyUploading}}">+</button></view>
              <view class="button-row"><button class="secondary" bindtap="cancelReceiptExceptionReply" disabled="{{deliveryBusy || exceptionReplyUploading}}">取消</button><button class="primary" bindtap="submitReceiptExceptionReply" disabled="{{deliveryBusy || exceptionReplyUploading}}" loading="{{deliveryBusy}}">提交回复</button></view>
            </view>
          </view>
          <view class="muted" wx:if="{{item.carrierName || item.trackingNo}}">{{item.carrierName || '物流配送'}}<text wx:if="{{item.trackingNo}}"> · 运单号 {{item.trackingNo}}</text></view>
          <view class="field" wx:if="{{item.note || item.evidenceFiles.length}}"><text wx:if="{{item.note}}" class="muted">发货说明：{{item.note}}</text><evidence-files files="{{item.evidenceFiles}}" /></view>
          <view class="shipment-record-actions" wx:if="{{item.revision > 1 || item.canRevise}}"><text class="muted" wx:if="{{item.revision > 1}}">已修改 {{item.revision - 1}} 次</text><button wx:if="{{item.canRevise}}" class="secondary" data-id="{{item.id}}" bindtap="beginShipmentRevision">修改发货数量</button></view>
        </view>
      </view>
      <view wx:if="{{orderMode === 'detail' && selectedOrder.deliveryState}}" class="delivery-progress"><text class="card-title">{{selectedOrder.displayStatus}}</text><text wx:if="{{selectedOrder.deliveryNote}}" class="muted">发货说明：{{selectedOrder.deliveryNote}}</text><text wx:if="{{selectedOrder.deliveryReview}}" class="muted">门店异议：{{selectedOrder.deliveryReview.reason}}</text><view wx:for="{{selectedOrder.deliveryReview.items}}" wx:key="orderItemId"><block wx:for="{{shipmentItems}}" wx:for-item="product" wx:key="id"><text wx:if="{{product.id === item.orderItemId}}" class="muted">{{product.productName}} · 要求补发 {{labels.quantity(item.quantity)}} {{product.unitName}}</text></block></view><text wx:if="{{selectedOrder.deliveryReview.response}}" class="muted">处理意见：{{selectedOrder.deliveryReview.response}}</text><view class="button-row" wx:if="{{selectedOrder.deliveryState === 'DISPUTED'}}"><button class="primary" data-action="REPLENISH" bindtap="deliveryAction" disabled="{{deliveryBusy}}">安排补发</button><button class="secondary" data-action="DECLINE" bindtap="deliveryAction" disabled="{{deliveryBusy}}">拒绝补发</button></view><button wx:if="{{selectedOrder.canFinish}}" class="secondary" data-action="finish-delivery" bindtap="deliveryAction" disabled="{{deliveryBusy}}">结束本单发货</button></view>
      <view wx:if="{{orderMode === 'ship'}}" class="delivery-finish-option"><text>本批发完后结束发货</text><switch checked="{{completeDelivery}}" bindchange="toggleCompleteDelivery" disabled="{{shipping}}" color="#176b4c" /></view>
      <view class="field" wx:if="{{(selectedOrder.canShip && orderMode === 'ship' && shipmentNeedsExplanation) || (orderMode === 'detail' && finishNeedsMaterials)}}">
        <text class="field-label">异常发货备注 · 必填</text>
        <textarea maxlength="500" value="{{revisionNote}}" data-field="revisionNote" bindinput="onInput" disabled="{{shipping || revisionUploading}}" placeholder="填写未足量发货的原因" />
        <text class="field-label">发货凭证 · 必填</text><evidence-files files="{{revisionEvidence}}" /><view class="button-row"><button class="secondary" bindtap="chooseRevisionEvidence" loading="{{revisionUploading}}" disabled="{{shipping || revisionUploading || revisionEvidence.length >= 6}}">上传凭证</button></view>
        <button class="ghost" wx:for="{{revisionEvidence}}" wx:key="id" data-index="{{index}}" bindtap="removeRevisionEvidence" disabled="{{shipping || revisionUploading}}">移除凭证 {{index + 1}}</button>
      </view>
      <view class="field" wx:if="{{selectedOrder.canShip && orderMode === 'ship'}}"><text class="field-label">配送方式</text><picker class="freight-picker" range="{{deliveryChoices}}" range-key="label" value="{{deliveryIndex}}" disabled="{{shipping || rejecting}}" bindchange="selectDelivery"><view class="picker-value">{{deliveryChoices[deliveryIndex].label}}</view></picker></view>
      <view class="field" wx:if="{{selectedOrder.canShip && orderMode === 'ship' && deliveryIndex === 1}}"><text class="field-label">物流公司 *</text><picker range="{{carrierChoices}}" range-key="name" value="{{carrierIndex}}" disabled="{{shipping || rejecting || !logisticsCompanies.length}}" bindchange="selectCarrier"><view class="picker-value">{{carrierChoices[carrierIndex].name}}</view></picker><text class="muted" wx:if="{{!logisticsCompanies.length}}">暂无启用的物流公司，请联系管理员配置</text></view>
      <view class="field" wx:if="{{selectedOrder.canShip && orderMode === 'ship' && deliveryIndex === 1}}"><text class="field-label">物流单号</text><input maxlength="100" value="{{trackingNo}}" data-field="trackingNo" disabled="{{shipping || rejecting}}" bindinput="onInput" placeholder="选填" /></view>
      <view class="field" wx:if="{{selectedOrder.canReject && orderMode === 'reject'}}"><text class="field-label">拒单原因</text><input value="{{rejectionReason}}" data-field="rejectionReason" disabled="{{rejecting}}" bindinput="onInput" placeholder="请输入无法供货的原因" /></view>
      <view class="field" wx:if="{{selectedOrder.canShip && orderMode === 'ship'}}"><view class="section-head"><text class="field-label">本次运费</text><text wx:if="{{selectedOrder.canRequestFreight}}" class="contact-phone" bindtap="refreshFreight">{{freightRefreshing ? '刷新中' : '刷新运费'}}</text></view><text class="muted" wx:if="{{!selectedOrder.canRequestFreight}}">¥0.00 · 不收运费</text><picker wx:else class="freight-picker" range="{{freightChoices}}" range-key="label" value="{{freightIndex}}" disabled="{{shipping || rejecting}}" bindchange="selectFreight"><view class="picker-value">{{freightChoices[freightIndex].label}}</view></picker></view>
    </view>
    <view class="button-row action-bar" wx:if="{{selectedOrder && orderMode !== 'revise' && (selectedOrder.canShip || selectedOrder.canReject)}}">
      <button wx:if="{{orderMode === 'detail' && selectedOrder.canShip}}" class="primary" data-mode="ship" bindtap="changeOrderMode">去发货</button>
      <button wx:if="{{orderMode === 'detail' && selectedOrder.canReject}}" class="ghost action-secondary" data-mode="reject" bindtap="changeOrderMode">无法供货</button>
      <button wx:if="{{orderMode === 'ship'}}" class="primary" disabled="{{shipping || rejecting || freightRequesting || revisionUploading}}" loading="{{shipping}}" bindtap="shipOrder">确认发货</button>
      <button wx:if="{{orderMode === 'reject'}}" class="danger" disabled="{{rejecting || shipping}}" loading="{{rejecting}}" bindtap="rejectOrder">确认拒单</button>
    </view>
    <view wx:if="{{orderMode === 'ship' && selectedOrder.canShip && selectedOrder.canRequestFreight}}" class="freight-request">
      <text class="card-title">运费申请</text>
      <view class="field"><text class="field-label">金额</text><input class="freight-amount" type="digit" value="{{freightRequestAmount}}" data-field="freightRequestAmount" bindinput="onInput" placeholder="0.00" /></view>
      <view class="field"><text class="field-label">费用原因</text><input class="freight-reason" maxlength="300" value="{{freightRequestReason}}" data-field="freightRequestReason" bindinput="onInput" /></view>
      <view class="button-row"><button class="secondary freight-request-submit" disabled="{{freightRequesting || shipping || rejecting}}" loading="{{freightRequesting}}" bindtap="requestFreight">提交采购确认</button></view>
    </view>
    <view class="list" wx:if="{{selectedOrder.freightConfirmations.length}}"><view class="row" wx:for="{{selectedOrder.freightConfirmations}}" wx:key="id"><view class="row-title"><text class="amount">运费 ¥{{labels.money(item.amount)}}</text><text class="status {{item.usedAt ? 'tone-muted' : 'tone-warn'}}">{{item.usedAt ? '已使用' : labels.status(item.status)}}</text></view><view class="muted">{{item.reason}}</view></view></view>
  </view>

  <view class="card" wx:if="{{activeView === 'orders' && !selectedOrder && !orderLoading}}">
    <view id="order-list-controls" class="order-list-controls sticky-bar">
    <input class="business-search" value="{{search}}" bindinput="onSearch" confirm-type="search" placeholder="搜索门店、订单号或商品" />
    <view class="status-bar">
      <scroll-view scroll-x scroll-with-animation scroll-into-view="{{statusScrollTarget}}" show-scrollbar="{{false}}" class="status-scroll">
        <view class="status-track"><text id="supplier-status-{{item.value}}" wx:for="{{orderTabs}}" wx:key="value" class="status-tab {{statusFilter === item.value ? 'is-selected' : ''}}" data-filter="{{item.value}}" bindtap="filterStatus">{{item.label}} {{item.count}}</text></view>
      </scroll-view>
      <button class="status-toggle {{statusExpanded ? 'is-expanded' : ''}}" bindtap="toggleStatusExpanded" aria-label="{{statusExpanded ? '收起状态筛选' : '展开全部状态'}}"><view class="status-chevron" /></button>
    </view>
    <view wx:if="{{statusExpanded}}" class="status-grid">
      <view wx:for="{{orderTabs}}" wx:key="value" class="status-option {{statusFilter === item.value ? 'is-selected' : ''}}" data-filter="{{item.value}}" bindtap="filterStatus"><text>{{item.label}}</text><text>{{item.count}}</text></view>
    </view>
    <view class="supplier-order-sort-hint" wx:if="{{statusFilter === 'all'}}">待处理订单优先 · 处理中按下单时间从早到晚</view>
    </view>
    <view class="list supplier-orders-list">
      <view wx:for="{{visibleOrders}}" wx:key="id" class="row supplier-order-list-item pressable" bindtap="selectOrder" data-id="{{item.id}}">
        <view class="supplier-order-topline"><text class="supplier-order-store">{{item.storeName || '收货门店'}}</text><text class="status {{item.listState === 'COMPLETED' ? 'tone-brand' : item.listState === 'REJECTED' || item.listState === 'CANCELED' ? 'tone-danger' : 'tone-warn'}}">{{labels.status(item.displayStatus)}}</text></view>
        <view class="supplier-order-meta"><text class="supplier-order-no-label">订单号</text><document-no value="{{item.supplierOrderNo}}" /><text class="supplier-order-date">{{item.createdText}}</text></view>
        <view class="supplier-order-products" wx:if="{{item.itemCount}}"><view class="supplier-order-products-heading"><text>商品清单</text><text>{{item.itemCount}} 种</text></view><text class="supplier-order-preview">{{item.productPreview || item.productSummary}}</text><text wx:if="{{item.productMoreCount > 0}}" class="supplier-order-more">另有 {{item.productMoreCount}} 种商品</text></view>
        <view class="order-list-footer"><view class="supplier-order-total"><text>供货金额</text><text>¥{{labels.money(item.supplyGoodsAmount)}}</text></view><text class="order-open">查看详情 ›</text></view>
      </view>
      <view wx:if="{{!visibleOrders.length && !loading && !error}}" class="order-empty">{{orderEmptyText}}</view>
    </view>
  </view>

  <view class="card" wx:if="{{activeView === 'differences'}}">
    <view class="back-link" data-view="tasks" bindtap="changeView">‹ 返回待办</view>
    <text class="card-title">收货差异处理</text>
    <view wx:if="{{selectedDiscrepancy}}" class="back-link" bindtap="backToList">‹ 返回列表</view>
    <view wx:if="{{discrepancyLoading}}" class="muted">正在读取差异详情</view>
    <view wx:if="{{selectedDiscrepancy}}">
      <view class="row-title"><text>{{selectedDiscrepancy.productName}}</text><text class="status {{selectedDiscrepancy.status === 'RESOLVED' ? 'tone-brand' : 'tone-warn'}}">{{labels.status(selectedDiscrepancy.status)}}</text></view>
      <view class="muted">{{selectedDiscrepancy.supplierOrderNo}} · {{selectedDiscrepancy.shipmentNo}}</view>
      <view class="metric-grid"><view class="metric"><text class="metric-label">发货数量</text><text class="metric-value">{{selectedDiscrepancy.shippedQuantity}}</text></view><view class="metric"><text class="metric-label">实收数量</text><text class="metric-value">{{selectedDiscrepancy.receivedQuantity}}</text></view></view>
      <view class="detail-line">少收 {{selectedDiscrepancy.missingQuantity}}</view>
      <evidence-files files="{{selectedDiscrepancy.evidenceFiles}}" />
      <view class="field" wx:if="{{selectedDiscrepancy.status === 'OPEN'}}"><text class="field-label">处理说明</text><input maxlength="300" value="{{discrepancyReason}}" data-field="discrepancyReason" bindinput="onInput" placeholder="退回核对时必填" /></view>
      <view class="notice notice-info" wx:if="{{selectedDiscrepancy.status === 'OPEN'}}">等待门店确认处理方式。门店要求补发后，补发缺口会进入待发货订单。</view>
      <view class="button-row" wx:if="{{selectedDiscrepancy.status === 'OPEN'}}"><button class="secondary" disabled="{{resolving}}" loading="{{resolving}}" data-action="RETURN" bindtap="resolveDiscrepancy">退回门店核对</button></view>
      <view wx:if="{{selectedDiscrepancy.replenishmentGap}}" class="detail-line">待补发 {{selectedDiscrepancy.replenishmentGap.remainingQuantity}}</view>
      <view class="button-row action-bar" wx:if="{{selectedDiscrepancy.canReplenish}}"><button class="primary replenish-start" disabled="{{orderLoading || shipping || resolving || freightRequesting}}" loading="{{orderLoading}}" bindtap="startReplenishment">去补发 · {{selectedDiscrepancy.replenishmentGap.remainingQuantity}}</button></view>
      <view class="muted" wx:if="{{selectedDiscrepancy.returnRecord}}">退回核对原因：{{selectedDiscrepancy.returnRecord.reason}}</view>
    </view>
    <view class="button-row"><button class="secondary" loading="{{loading}}" bindtap="loadDiscrepancies">刷新差异</button></view>
    <view class="list">
      <view wx:if="{{!selectedDiscrepancy && !discrepancyLoading}}" wx:for="{{discrepancies}}" wx:key="id" class="row pressable" bindtap="selectDiscrepancy" data-id="{{item.id}}">
        <view class="row-title"><text>{{item.title}}</text><text class="status {{!item.status ? 'tone-muted' : item.status === 'RESOLVED' ? 'tone-brand' : 'tone-warn'}}">{{item.status ? labels.status(item.status) : '待查看'}}</text></view>
        <view class="muted">{{item.createdAt}}</view>
      </view>
      <view wx:if="{{!discrepancies.length}}" class="row"><view class="muted">暂无收货差异通知。</view></view>
    </view>
  </view>

  <view class="card" wx:if="{{activeView === 'reports' && !statementId && !adjustmentId}}">
    <view class="section-head"><text class="card-title">供应商账单</text><text class="reconcile-count">{{statements.length}} 张</text></view>
    <view class="list supplier-bill-list">
      <view wx:for="{{statements}}" wx:key="id" class="supplier-bill-item pressable" data-id="{{item.id}}" bindtap="selectStatement">
        <view class="supplier-finance-item-head"><view><text class="supplier-finance-title">{{labels.status(item.cycle)}}账单</text><text class="supplier-finance-period">{{item.periodText}}</text></view><text class="status {{item.settlementStatus === 'SETTLED' ? 'tone-brand' : 'tone-warn'}}">{{item.settlementStatus === 'SETTLED' ? '已结清' : '待结清'}}</text></view>
        <view class="supplier-bill-payable"><text>应付余额</text><text>¥{{labels.money(item.payableAmount)}}</text></view>
        <view class="supplier-bill-breakdown"><view><text>已确认收款</text><text>¥{{labels.money(item.confirmedPaidAmount)}}</text></view><view><text>待确认付款</text><text>¥{{labels.money(item.pendingPaymentAmount)}}</text></view></view>
        <view class="supplier-finance-open">查看账单明细 ›</view>
      </view>
      <view wx:if="{{!statements.length && !loading && !error}}" class="finance-empty">暂无供应商账单</view>
    </view>
  </view>

  <view class="card" wx:if="{{activeView === 'reports' && statementId}}">
    <text class="back-link" bindtap="backToList">{{statementKind === 'store' ? '返回供应商总账' : '返回账单列表'}}</text>
    <view wx:if="{{statementLoading}}" class="muted">正在读取账单</view>
    <button wx:if="{{!statementLoading && !selectedStatement}}" class="ghost" bindtap="retryStatement">重新读取账单</button>
    <view wx:if="{{selectedStatement}}">
      <text class="card-title">{{statementKind === 'store' ? selectedStatement.storeName || '分店账单' : labels.status(selectedStatement.cycle) + '账单'}}</text><view class="muted">{{selectedStatement.periodText}}</view>
      <view class="metric-grid"><view class="metric"><text class="metric-label">应付余额</text><text class="metric-value">¥{{labels.money(selectedStatement.payableAmount)}}</text></view><view class="metric"><text class="metric-label">已确认收款</text><text class="metric-value">¥{{labels.money(selectedStatement.confirmedPaidAmount)}}</text></view></view>
      <view class="detail-line">货款 ¥{{labels.money(selectedStatement.goodsAmount)}} · 运费 ¥{{labels.money(selectedStatement.freightAmount)}}</view>
      <view class="detail-line">调整 ¥{{labels.money(selectedStatement.adjustmentAmount)}} · 待确认付款 ¥{{labels.money(selectedStatement.pendingPaymentAmount)}}</view>
      <view wx:if="{{statementKind === 'total'}}" class="statement-stores">
        <text class="card-title">分店账单</text>
        <view wx:if="{{statementStoresLoading}}" class="muted">正在读取分店账单</view>
        <view wx:if="{{statementStoresError}}" class="muted">{{statementStoresError}}</view><button wx:if="{{statementStoresError}}" class="ghost" bindtap="retryStatementStores">重新读取分店账单</button>
        <view class="row statement-store-source pressable" wx:for="{{statementStores}}" wx:key="id" data-id="{{item.id}}" bindtap="selectStoreStatement"><view class="row-title"><text>{{item.storeName || '门店未命名'}}</text><text>¥{{labels.money(item.payableAmount)}} ›</text></view><view class="muted">货款 ¥{{labels.money(item.goodsAmount)}} · 运费 ¥{{labels.money(item.freightAmount)}}</view><view class="muted">已收 ¥{{labels.money(item.confirmedPaidAmount)}} · 待确认 ¥{{labels.money(item.pendingPaymentAmount)}} · 调整 ¥{{labels.money(item.adjustmentAmount)}}</view></view>
        <view wx:if="{{!statementStoresLoading && !statementStoresError && !statementStores.length}}" class="muted">暂无分店账单</view>
      </view>
      <text class="card-title">来源订单</text>
      <view class="statement-order" wx:for="{{selectedStatement.lines}}" wx:for-item="line" wx:key="settlementItemId">
        <view class="row statement-order-source pressable" data-id="{{line.supplierOrderId}}" data-kind="order" bindtap="openStatementSource"><view class="row-title"><text>{{line.supplierOrderNo}}</text><text>¥{{labels.money(line.totalAmount)}} ›</text></view><view class="muted">{{line.storeName}}</view><view class="muted">{{line.amountBasis === 'FROZEN' ? '冻结货款' : '货款'}} ¥{{labels.money(line.goodsAmount)}} · 运费 ¥{{labels.money(line.freightAmount)}}</view></view>
        <view class="statement-products-heading"><text>订单商品</text><button class="statement-products-toggle {{expandedStatementOrderId === line.supplierOrderId ? 'is-expanded' : ''}}" data-id="{{line.supplierOrderId}}" bindtap="toggleStatementProducts" aria-label="{{expandedStatementOrderId === line.supplierOrderId ? '收起商品明细' : '展开商品明细'}}">›</button></view>
        <view wx:if="{{expandedStatementOrderId === line.supplierOrderId}}" class="statement-products">
          <view class="row" wx:for="{{line.products}}" wx:for-item="product" wx:key="orderItemId"><view class="row-title"><text>{{product.productName}}</text><text>¥{{labels.money(product.supplyLineAmount)}}</text></view><view class="muted">{{product.sku}} · {{product.specification || product.unitName}}</view><view class="muted">订购 {{product.orderedText}} · 有效 {{product.effectiveText}} · 实收 {{product.receivedText}}</view><view class="muted">供货单价 ¥{{labels.money(product.priceText)}} / {{product.unitName}}</view></view>
          <view class="detail-line">当前商品货款 ¥{{labels.money(line.productGoodsAmount)}}</view><view class="muted" wx:if="{{line.goodsReconciliationAmount !== '0.00'}}">结算基准差额 ¥{{labels.money(line.goodsReconciliationAmount)}}</view>
          <view wx:if="{{!line.products.length}}" class="muted">暂无商品明细</view>
        </view>
      </view>
      <text wx:if="{{selectedStatement.adjustmentItems.length}}" class="card-title">结算调整</text>
      <view class="row statement-adjustment-source pressable" wx:for="{{selectedStatement.adjustmentItems}}" wx:key="settlementItemId" data-id="{{item.adjustmentId}}" data-kind="adjustment" bindtap="openStatementSource"><view class="row-title"><text>{{item.adjustmentId ? '调整明细' : '来源详情暂不可用'}}</text><text>¥{{labels.money(item.amount)}}</text></view></view>
      <text class="card-title">收款记录</text>
      <view wx:if="{{statementPaymentsLoading}}" class="muted">正在读取收款记录</view>
      <view wx:if="{{statementPaymentError}}" class="muted">{{statementPaymentError}}</view>
      <button wx:if="{{statementPaymentError}}" class="ghost" bindtap="retryStatementPayments">重新读取</button>
      <view class="row statement-payment-source pressable" wx:for="{{statementPayments}}" wx:for-item="payment" wx:key="id" data-id="{{payment.id}}" data-kind="payment" bindtap="openStatementSource"><view class="row-title"><text>{{payment.paymentNo}}</text><text class="status {{payment.status === 'PENDING' ? 'tone-warn' : payment.status === 'REJECTED' ? 'tone-danger' : 'tone-brand'}}">{{labels.status(payment.status)}}</text></view><view class="muted">整笔付款 ¥{{labels.money(payment.amount)}}</view><view wx:for="{{payment.statementAllocations}}" wx:key="id" class="muted">本账单关联 ¥{{labels.money(item.amount)}} · {{labels.status(item.state)}}</view></view>
      <view wx:if="{{!statementPaymentsLoading && !statementPaymentError && !statementPayments.length}}" class="muted">暂无关联收款记录</view>
    </view>
  </view>

  <view class="card" wx:if="{{activeView === 'reports' && adjustmentId}}">
    <text class="back-link" bindtap="backToList">‹ {{statementKind === 'store' ? '返回供应商总账' : '返回账单列表'}}</text>
    <view wx:if="{{adjustmentLoading}}" class="muted">正在读取调整详情</view>
    <view wx:if="{{selectedAdjustment}}"><text class="card-title">{{labels.status(selectedAdjustment.type)}}</text><view class="muted">{{selectedAdjustment.supplierOrderNo}} · {{selectedAdjustment.createdText}}</view>
      <view class="detail-line">调整金额 ¥{{labels.money(selectedAdjustment.adjustmentAmount)}}</view><view class="muted">{{labels.status(selectedAdjustment.processingStatus)}}</view>
      <view class="detail-line">原交易账期 {{selectedAdjustment.originalPeriodText}}</view><view class="detail-line">调整账期 {{selectedAdjustment.periodText}}</view>
      <view class="detail-line">待返还或抵扣 ¥{{labels.money(selectedAdjustment.pendingReturnOrOffsetAmount)}}</view>
      <view class="row" wx:for="{{selectedAdjustment.lines}}" wx:key="orderItemId"><view class="row-title"><text>{{item.productName}}</text><text>¥{{labels.money(item.supplyAdjustmentAmount)}}</text></view><view class="muted">数量 {{item.quantity}} · 单价 ¥{{labels.money(item.unitSupplyPrice)}}</view></view>
      <view wx:if="{{selectedAdjustment.disposal}}" class="detail-line">{{selectedAdjustment.disposal.disposalNo}} · {{labels.status(selectedAdjustment.disposal.status)}} · ¥{{labels.money(selectedAdjustment.disposal.amount)}}</view>
    </view>
  </view>

  <view class="card" wx:if="{{activeView === 'reports' && !statementId && !adjustmentId}}">
    <view class="section-head">
      <text class="card-title">统计概览</text>
      <button class="ghost" loading="{{loading}}" bindtap="loadReports">刷新</button>
    </view>
    <view class="muted">{{reportRange.from}} 至 {{reportRange.to}}</view>
    <view class="metric-grid" wx:if="{{reports.orderAmount}}">
      <view class="metric"><text class="metric-label">完成月份</text><text class="metric-value">{{reports.orderAmount.months[0].month || '-'}}</text></view>
      <view class="metric"><text class="metric-label">完成金额</text><text class="metric-value">¥{{labels.money(reports.orderAmount.months[0].totalAmount || '0.00')}}</text></view>
      <view class="metric"><text class="metric-label">完成单数</text><text class="metric-value">{{reports.orderAmount.months[0].orderCount || 0}}</text></view>
      <view class="metric"><text class="metric-label">商品种数</text><text class="metric-value">{{reports.productQuantity.products.length || 0}}</text></view>
    </view>
    <view class="list" wx:if="{{reports.productQuantity.products.length}}">
      <view class="row" wx:for="{{reports.productQuantity.products}}" wx:key="productId">
        <view class="row-title"><text>{{item.productName}}</text><text class="status tone-muted">{{labels.quantity(item.quantity)}} {{item.unit || ''}}</text></view>
      </view>
    </view>
  </view>

  <view class="card" wx:if="{{activeView === 'payments'}}">
    <view class="section-head"><text class="card-title">付款到账核对</text><text class="reconcile-count">{{payments.length}} 笔</text></view>
    <view wx:if="{{selectedPayment && !statementReturnId}}" class="back-link" bindtap="backToList">‹ 返回列表</view>
    <view wx:if="{{paymentLoading}}" class="muted">正在读取付款详情</view>
    <view wx:if="{{selectedPayment}}">
      <view class="row-title"><text>{{selectedPayment.paymentNo}}</text><text class="status {{selectedPayment.status === 'PENDING' ? 'tone-warn' : selectedPayment.status === 'REJECTED' ? 'tone-danger' : 'tone-brand'}}">{{labels.status(selectedPayment.status)}}</text></view>
      <view class="detail-line">付款金额 ¥{{labels.money(selectedPayment.amount)}}</view><view class="muted">业务日期 {{selectedPayment.businessDate}}</view>
      <view class="muted" wx:if="{{selectedPayment.remark}}">{{selectedPayment.remark}}</view>
      <view class="list"><view class="row" wx:for="{{selectedPayment.allocations}}" wx:key="id"><view class="row-title"><text>{{item.supplierOrderNo || '结算单'}}</text><text>¥{{labels.money(item.amount)}}</text></view></view></view>
      <evidence-files files="{{selectedPayment.evidenceFiles}}" />
      <view class="field" wx:if="{{selectedPayment.status === 'PENDING'}}"><text class="field-label">驳回原因</text><input maxlength="300" value="{{paymentReason}}" data-field="paymentReason" bindinput="onInput" placeholder="驳回时必填" /></view>
      <view class="button-row action-bar" wx:if="{{selectedPayment.status === 'PENDING'}}">
        <button class="primary payment-confirm" disabled="{{paying}}" loading="{{paying}}" data-action="confirm" bindtap="handlePayment">确认收款</button>
        <button class="danger" disabled="{{paying}}" loading="{{paying}}" data-action="reject" bindtap="handlePayment">驳回付款</button>
      </view>
      <view class="muted" wx:if="{{selectedPayment.rejectedReason}}">驳回原因：{{selectedPayment.rejectedReason}}</view>
    </view>
    <view class="list supplier-payment-list">
      <view wx:if="{{!selectedPayment && !paymentLoading}}" wx:for="{{payments}}" wx:key="id" class="supplier-payment-item pressable" bindtap="selectPayment" data-id="{{item.id}}">
        <view class="supplier-finance-item-head"><view><text class="supplier-finance-title">收款记录</text><text class="supplier-finance-period">{{item.paymentNo || item.id}}</text></view><text class="status {{item.status === 'PENDING' ? 'tone-warn' : item.status === 'REJECTED' ? 'tone-danger' : 'tone-brand'}}">{{labels.status(item.status)}}</text></view>
        <view class="supplier-payment-amount"><text>¥{{labels.money(item.amount)}}</text><text>{{item.businessDate || '日期未记录'}}</text></view>
        <view class="supplier-finance-open">查看收款详情 ›</view>
      </view>
      <view wx:if="{{!payments.length && !loading && !paymentLoading && !selectedPayment && !error}}" class="finance-empty">暂无待核对或历史付款记录</view>
    </view>
  </view>

  <button class="secondary" wx:if="{{activeView === 'orders' && !selectedOrder && !orderLoading && moreOrders}}" bindtap="nextOrders">加载更多</button>
</view>
