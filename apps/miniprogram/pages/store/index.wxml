<view class="page">
  <view class="hero">
    <text class="eyebrow">STORE</text>
    <text class="title">门店工作台</text>
    <view class="subtitle">面向 S01-S05：订货、订单进度、按批次收货和账款入口。当前切片接真实下单、待收货通知和收货提交。</view>
  </view>

  <view class="card">
    <text class="card-title">当前账号</text>
    <view class="metric-grid">
      <view class="metric"><text class="metric-label">用户</text><text class="metric-value">{{user.displayName || '未登录'}}</text></view>
      <view class="metric"><text class="metric-label">角色</text><text class="metric-value">{{roleText}}</text></view>
    </view>
  </view>

  <view class="card">
    <view class="section-head">
      <text class="card-title">账款入口</text>
      <button class="ghost" loading="{{accounting}}" bindtap="loadAccount">刷新</button>
    </view>
    <view class="field"><text class="field-label">门店 ID</text><input value="{{storeId}}" data-field="storeId" bindinput="onInput" placeholder="storeId" /></view>
    <view class="metric-grid" wx:if="{{account}}">
      <view class="metric"><text class="metric-label">余额</text><text class="metric-value">{{account.balance}}</text></view>
      <view class="metric"><text class="metric-label">可用额度</text><text class="metric-value">{{account.creditAvailable}}</text></view>
      <view class="metric"><text class="metric-label">授信额度</text><text class="metric-value">{{account.creditLimit}}</text></view>
      <view class="metric"><text class="metric-label">已用额度</text><text class="metric-value">{{account.creditUsed}}</text></view>
    </view>
    <view class="list" wx:if="{{ledgers.length}}">
      <view class="row" wx:for="{{ledgers}}" wx:key="id">
        <view class="row-title"><text>{{item.sourceType}}</text><text class="tag">{{item.direction}}</text></view>
        <view class="muted">金额 {{item.amount}}，发生后余额 {{item.balanceAfter}}</view>
      </view>
    </view>
  </view>

  <view class="card">
    <text class="card-title">快速订货</text>
    <view class="field"><text class="field-label">门店 ID</text><input value="{{storeId}}" data-field="storeId" bindinput="onInput" placeholder="storeId" /></view>
    <view class="field"><text class="field-label">商品 ID</text><input value="{{productId}}" data-field="productId" bindinput="onInput" placeholder="productId" /></view>
    <view class="field"><text class="field-label">数量</text><input type="digit" value="{{quantity}}" data-field="quantity" bindinput="onInput" /></view>
    <view class="button-row">
      <button class="secondary" loading="{{previewing}}" bindtap="previewOrder">预览金额</button>
      <button class="primary" loading="{{submitting}}" bindtap="submitOrder">提交订货</button>
    </view>
  </view>

  <view class="card" wx:if="{{preview}}">
    <text class="card-title">预览结果</text>
    <view class="metric-grid">
      <view class="metric"><text class="metric-label">销售商品额</text><text class="metric-value">{{preview.totals.salesGoodsAmount}}</text></view>
      <view class="metric"><text class="metric-label">供货商品额</text><text class="metric-value">{{preview.totals.supplyGoodsAmount}}</text></view>
    </view>
  </view>

  <view class="card" wx:if="{{created}}">
    <text class="card-title">订货结果</text>
    <view class="list">
      <view class="row"><view class="row-title"><text>{{created.requestNo}}</text><text class="tag">{{created.status}}</text></view><view class="muted">资金状态 {{created.paymentStatus}}，等待采购确认后推送供应商。</view></view>
    </view>
  </view>

  <view class="card">
    <view class="section-head">
      <text class="card-title">订单进度</text>
      <button class="ghost" loading="{{loading}}" bindtap="loadWork">刷新</button>
    </view>
    <view class="list">
      <view wx:for="{{requests}}" wx:key="id" class="row" bindtap="selectRequest" data-id="{{item.id}}" data-no="{{item.requestNo}}" data-status="{{item.status}}" data-payment-status="{{item.paymentStatus}}">
        <view class="row-title"><text>{{item.requestNo || item.id}}</text><text class="tag">{{item.status}}</text></view>
        <view class="muted">资金 {{item.paymentStatus || 'UNKNOWN'}}，销售额 {{item.salesGoodsAmount || '-'}}</view>
      </view>
      <view wx:if="{{!requests.length}}" class="row"><view class="muted">暂无订货记录或尚未刷新。</view></view>
    </view>
  </view>

  <view class="card">
    <view class="section-head">
      <text class="card-title">待收货通知</text>
      <button class="ghost" loading="{{loading}}" bindtap="loadWork">刷新</button>
    </view>
    <view class="list" wx:if="{{shipmentTodos.length}}">
      <view class="row" wx:for="{{shipmentTodos}}" wx:key="id" data-id="{{item.id}}" bindtap="selectShipment">
        <view class="row-title"><text>{{item.shipmentNo}}</text><text class="tag">待收货</text></view>
        <view class="muted">供应商单 {{item.supplierOrderId}}</view>
      </view>
    </view>
    <view class="muted" wx:else>暂无待收货通知，可手工输入发货单 ID。</view>
    <view class="field"><text class="field-label">发货单 ID</text><input value="{{shipmentId}}" data-field="shipmentId" bindinput="onInput" placeholder="shipmentId" /></view>
    <view class="field"><text class="field-label">少收数量</text><input type="digit" value="{{shortReceivedQuantity}}" data-field="shortReceivedQuantity" bindinput="onInput" /></view>
    <view class="button-row">
      <button class="primary" loading="{{receiving}}" data-mode="FULL" bindtap="receiveShipment">确认收货</button>
      <button class="secondary" loading="{{receiving}}" data-mode="SHORT" bindtap="receiveShipment">提交收货差异</button>
    </view>
  </view>

  <view class="card" wx:if="{{receiptResult}}">
    <text class="card-title">收货结果</text>
    <view class="list">
      <view class="row"><view class="row-title"><text>{{receiptResult.title}}</text><text class="tag">{{receiptResult.status}}</text></view><view class="muted">{{receiptResult.detail}}</view></view>
    </view>
  </view>

  <view wx:if="{{error}}" class="card"><text class="tag tag-fail">{{error}}</text></view>
</view>
