page { background: #f4f6f5; color: #24312a; }
.products-page { padding-bottom: calc(100px + env(safe-area-inset-bottom)); font-size: 14px; }
.products-heading, .editor-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 16px; background: #fff; border-bottom: 1px solid #e4eae6; }
.products-heading > text { font-size: 20px; font-weight: 600; }
.add-product, .back-product, .add-image, .remove-image { width: 38px; height: 38px; padding: 0; margin: 0; font-size: 25px; line-height: 36px; color: #167e5a; background: #edf5f0; border-radius: 4px; flex-shrink: 0; }
.editor-toolbar { justify-content: flex-start; }
.products-search { display: flex; align-items: center; gap: 10px; padding: 12px 16px; background: #fff; }
.products-search input { flex: 1; min-width: 0; height: 38px; border: 0; background: #f2f5f3; padding: 0 8px; }
.product-list-row { display: flex; align-items: center; gap: 12px; justify-content: space-between; padding: 16px; background: #fff; border-top: 1px solid #edf0ee; }
.product-list-row > view { min-width: 0; flex: 1; }
.product-title { display: block; font-size: 15px; font-weight: 600; overflow-wrap: anywhere; }
.product-state { flex-shrink: 0; color: #6e8076; font-size: 12px; }
.products-empty { padding: 40px 16px; text-align: center; color: #75867c; }
.product-fields, .product-image-section { padding: 0 16px; background: #fff; margin-top: 8px; }
.product-field { display: flex; align-items: center; gap: 12px; min-height: 54px; padding: 8px 0; border-bottom: 1px solid #edf0ee; box-sizing: border-box; }
.product-field > text { width: 76px; flex-shrink: 0; color: #586b5f; }
.product-field input { flex: 1; min-width: 0; width: 0; height: 36px; padding: 0 8px; font-size: 14px; border: 1px solid #e1e7e3; }
.product-field picker { flex: 1; min-width: 0; padding: 8px 0; overflow-wrap: anywhere; }
.product-field input + picker { flex: 0 0 48px; }
.brand-select { color: #167e5a; font-size: 12px; }
.product-image-section { padding-top: 16px; padding-bottom: 16px; }
.product-image-tools { display: flex; align-items: center; gap: 12px; margin-top: 12px; }
.product-image-tools image { width: 96px; height: 96px; border: 1px solid #e3e9e5; }
.product-save-bar { position: fixed; bottom: 0; left: 0; right: 0; z-index: 10; padding: 12px 16px calc(12px + env(safe-area-inset-bottom)); background: #fff; border-top: 1px solid #e3e9e5; }
.product-save-bar button { margin: 0; width: 100%; }
.crop-editor { padding: 20px 16px; background: #fff; }
.crop-frame { width: 240px; height: 240px; margin: 20px auto; overflow: hidden; background: #eaf0ed; }
.crop-actions { display: flex; gap: 12px; }
.crop-actions button { flex: 1; min-width: 0; }
.crop-canvas { position: fixed; left: -10000px; top: 0; }
.muted { overflow-wrap: anywhere; }
