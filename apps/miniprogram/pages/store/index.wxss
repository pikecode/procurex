/* ===========================================================================
   门店工作台
   与其他角色共用 app.wxss 的令牌与原语；这里只定义门店独有的
   商品目录、订货单、收货核对与账户视图。
   =========================================================================== */

@import "../../styles/workspace.wxss";

.notice-error > button { margin: 14rpx 0 0; font-size: 24rpx; }

/* Two fixed bars stack here: .store-nav (96rpx) plus .order-bar above it. */
.store-page {
  min-height: 100vh;
  padding-bottom: calc(276rpx + env(safe-area-inset-bottom));
  font-size: 26rpx;
}

/* ---------- 页头 ---------- */

/* 门店页页头同样接住原生导航栏，形成一整条品牌色带。 */
.store-heading {
  padding: 30rpx 28rpx 28rpx;
  background: var(--brand-deep);
}
.heading-main,
.entry-top,
.entry-progress,
.entry-bottom,
.amount-row,
.product-bottom,
.receipt-counts,
.section-caption {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.store-name {
  min-width: 0;
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.35;
  overflow-wrap: anywhere;
}
.heading-date { flex-shrink: 0; color: rgba(255, 255, 255, .78); font-size: 23rpx; }
.heading-caption { display: block; margin-top: 12rpx; color: rgba(255, 255, 255, .78); font-size: 24rpx; }

/* ---------- 区块与说明 ---------- */

.section-band {
  margin-top: 20rpx;
  padding: 28rpx;
  background: var(--surface);
}
.section-title {
  display: block;
  color: var(--ink-1);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.4;
  overflow-wrap: anywhere;
}
.section-caption { padding: 28rpx; color: var(--ink-3); font-size: 23rpx; }
.secondary-text { display: block; margin-top: 8rpx; color: var(--ink-3); font-size: 23rpx; line-height: 1.5; overflow-wrap: anywhere; }
.delivery-info > text { display: block; margin-top: 12rpx; line-height: 1.5; overflow-wrap: anywhere; }

/* ---------- 固定底部条 ---------- */

.store-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: var(--z-nav);
  display: flex;
  /* 同 .business-nav：border-box 下安全区要叠加在高度之外。 */
  height: calc(96rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: var(--surface);
  border-top: 1rpx solid var(--line);
}
.nav-item {
  position: relative;
  flex: 1;
  min-width: 0;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  color: var(--ink-3);
  font-size: 26rpx;
  border-top: 4rpx solid transparent;
}
.nav-selected { color: var(--brand); font-weight: 700; border-top-color: var(--brand); background: var(--brand-soft); }

.order-bar {
  position: fixed;
  bottom: calc(96rpx + env(safe-area-inset-bottom));
  left: 0;
  right: 0;
  z-index: var(--z-nav);
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 28rpx;
  background: var(--surface);
  border-top: 1rpx solid var(--line);
}
.cart-summary { min-width: 0; flex: 1; }
.cart-count { display: block; color: var(--ink-3); font-size: 23rpx; }
.cart-estimate {
  display: block;
  margin-top: 4rpx;
  color: var(--ink-1);
  font-size: 32rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  overflow-wrap: anywhere;
}
.order-bar button, .sheet-total button { flex: 0 0 272rpx; width: 272rpx; margin: 0; height: 80rpx; line-height: 80rpx; font-size: 26rpx; }

/* ---------- 商品目录 ---------- */

.catalog-tools { padding: 18rpx 28rpx 0; background: var(--surface); }
.search-field {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: var(--sunken);
}
.search-input { width: 100%; height: 76rpx; padding: 0; border: 0; background: transparent; font-size: 26rpx; }

.category-strip { white-space: nowrap; width: 100%; }
.category-track { display: inline-flex; gap: 32rpx; }
.category-option {
  padding: 28rpx 12rpx;
  border-left: 5rpx solid transparent;
  color: var(--ink-3);
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
  overflow-wrap: anywhere;
}
.category-sidebar .category-option {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  padding: 22rpx 12rpx;
  word-break: break-word;
}
.category-selected { color: var(--brand); border-color: var(--brand); background: var(--surface); font-weight: 700; }
.subcategory-strip { padding: 12rpx 0; border-top: 1rpx solid var(--line); }
.subcategory-strip .category-track { gap: 16rpx; }
.subcategory-option { padding: 10rpx 20rpx; border-radius: 10rpx; color: var(--ink-3); background: var(--sunken); font-size: 24rpx; }
.subcategory-selected { background: var(--brand-soft); color: var(--brand-ink); font-weight: 600; }

.catalog-page {
  height: 100vh;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding-bottom: calc(97rpx + env(safe-area-inset-bottom));
}
.catalog-page.has-checkout { padding-bottom: calc(226rpx + env(safe-area-inset-bottom)); }
.catalog-page .store-heading, .catalog-page .catalog-tools { flex-shrink: 0; }
.catalog-page .catalog-tools { padding: 18rpx 24rpx; border-bottom: 1rpx solid var(--line); }
.catalog-browser { flex: 1; min-height: 0; display: flex; overflow: hidden; }
/* 分类栏与右侧白色内容区同色会糊成一片，用右边线划清层级 */
.category-sidebar {
  flex: 0 0 154rpx;
  width: 154rpx;
  height: 100%;
  background: var(--sunken);
  border-right: 1rpx solid var(--line);
}
.catalog-content { flex: 1; min-width: 0; display: flex; flex-direction: column; background: var(--surface); }
.catalog-content .subcategory-strip { flex-shrink: 0; padding: 16rpx 0; border-top: 0; border-bottom: 1rpx solid var(--line-soft); }
.catalog-content .category-track { padding: 0 18rpx; }
.catalog-content .subcategory-option { padding: 10rpx 16rpx; font-size: 23rpx; }
.catalog-content .section-caption { padding: 16rpx 18rpx; flex-shrink: 0; font-size: 22rpx; }
.catalog-products { flex: 1; height: 0; min-height: 0; }
/* 列表末尾留白：最后一行不要紧贴结算栏的边界 */
.catalog-content .product-list { padding: 0 18rpx 32rpx; }
.catalog-content .product-row { gap: 16rpx; padding: 24rpx 0; }
.catalog-content .product-media { flex-basis: 94rpx; width: 94rpx; height: 94rpx; }
.catalog-content .missing-image { gap: 6rpx; font-size: 18rpx; }
.catalog-content .product-name { font-size: 27rpx; }
.catalog-content .product-bottom { align-items: center; gap: 12rpx; margin-top: 14rpx; }
.catalog-content .product-price { font-size: 29rpx; }
.catalog-content .quantity-stepper { flex-shrink: 0; margin-left: auto; }
.catalog-content .product-price-group { flex: 1; min-width: 0; }

/* ---------- 商品行 ---------- */

.product-list { padding: 0 28rpx; background: var(--surface); }
.product-row { display: flex; gap: 22rpx; padding: 28rpx 0; border-bottom: 1rpx solid var(--line); }
.product-media {
  position: relative;
  flex: 0 0 126rpx;
  width: 126rpx;
  height: 126rpx;
  overflow: hidden;
  border-radius: 12rpx;
  background: var(--sunken);
}
.product-media image { width: 100%; height: 100%; }
.missing-image {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  gap: 6rpx;
  padding-bottom: 12rpx;
  color: var(--ink-4);
  font-size: 18rpx;
}
.cart-badge {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  z-index: 2;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 8rpx;
  border-radius: 18rpx;
  background: var(--brand);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 36rpx;
  text-align: center;
  font-variant-numeric: tabular-nums;
}
.product-main { flex: 1; min-width: 0; }
.product-name { display: block; color: var(--ink-1); font-size: 28rpx; font-weight: 600; line-height: 1.4; overflow-wrap: anywhere; }
.product-meta { display: block; margin-top: 8rpx; color: var(--ink-3); font-size: 22rpx; line-height: 1.5; }
.product-bottom { margin-top: 18rpx; flex-wrap: wrap; gap: 14rpx; }
.product-price-group { display: flex; align-items: baseline; gap: 14rpx; flex-wrap: wrap; min-width: 0; }
.product-price {
  color: var(--ink-1);
  font-size: 32rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  overflow-wrap: anywhere;
}
.product-price-unit { color: var(--ink-3); font-size: 22rpx; font-weight: 400; }
/* 起订/倍数是硬性下单约束，用警示色提醒。
   但起订 1、倍数 1 意味着「无约束」，再用橙色就是假警报——降为中性色。 */
.product-rules { color: var(--warn); font-size: 23rpx; font-variant-numeric: tabular-nums; }
.product-rules.is-neutral { color: var(--ink-4); }
.product-convert-hint { color: var(--ink-4); }
.unavailable { color: var(--warn); font-size: 23rpx; }
.product-unit-select {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx 16rpx;
  padding: 10rpx 0;
  color: var(--brand);
  font-size: 24rpx;
}

/* ---------- 数量步进器 ---------- */

.quantity-stepper {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  height: 60rpx;
  overflow: hidden;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
}
/* 步进器禁用态：全局 button[disabled] 的 opacity 会把「减号」淡到看不见，
   这里改成显式的浅灰前景，读作禁用而不是渲染坏了。 */
.step-button {
  width: 60rpx;
  height: 60rpx;
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: var(--sunken);
  color: var(--brand);
  font-size: 32rpx;
  line-height: 60rpx;
}
.step-button[disabled] { opacity: 1; color: var(--ink-faint); background: var(--sunken); }
.step-add[disabled] { opacity: .45; }
.step-add { background: var(--brand); color: #fff; }
.quantity-input {
  width: 84rpx;
  height: 60rpx;
  padding: 0 4rpx;
  border: 0;
  border-radius: 0;
  background: var(--surface);
  text-align: center;
  font-size: 26rpx;
  font-variant-numeric: tabular-nums;
}

/* ---------- 订货单 ---------- */

/* 详情工具条：左侧回退、右侧标题，与其他角色的 .task-detail-toolbar 同构 */
.detail-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 20rpx;
  padding: 20rpx 28rpx;
  border-bottom: 1rpx solid var(--line);
  background: var(--surface);
  color: var(--ink-1);
  font-size: 30rpx;
  font-weight: 700;
}
.detail-toolbar .back-link { padding: 0; margin: 0; font-weight: 600; }

.confirm-line, .ledger-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
}
.confirm-line:last-child { border-bottom: 0; }
.line-name { min-width: 0; flex: 1; color: var(--ink-1); line-height: 1.4; overflow-wrap: anywhere; }
.money { flex-shrink: 0; color: var(--ink-1); font-size: 28rpx; font-weight: 700; text-align: right; font-variant-numeric: tabular-nums; }
.ledger-amount { flex-shrink: 0; text-align: right; color: var(--ink-1); font-weight: 600; font-variant-numeric: tabular-nums; }

.amount-row { padding: 16rpx 0; color: var(--ink-2); font-size: 26rpx; }
.amount-row > text:first-child { min-width: 0; }
.amount-row > text:last-child { flex-shrink: 0; color: var(--ink-1); text-align: right; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
.total-row { padding-bottom: 24rpx; margin-bottom: 8rpx; border-bottom: 1rpx solid var(--line); font-size: 28rpx; font-weight: 700; }
.total-row > text:last-child { font-size: 32rpx; }
.shortfall-row > text:first-child, .shortfall-row > text:last-child { color: var(--warn); font-weight: 700; }

/* ---------- 订货单列表 ---------- */

.order-filters { padding: 0; background: var(--surface); }
.receipt-todo-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 20rpx 28rpx 0;
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  background: var(--brand-soft);
}
.chevron { flex-shrink: 0; color: var(--ink-faint); font-size: 34rpx; }
.receipt-todo-banner > view { display: flex; flex-direction: column; gap: 6rpx; min-width: 0; }
.receipt-todo-title { color: var(--brand-ink); font-size: 27rpx; font-weight: 700; }
.receipt-todo-count { color: var(--ink-3); font-size: 23rpx; }
.receipt-todo-action { flex-shrink: 0; color: var(--brand); font-size: 24rpx; font-weight: 600; }
.filter-track { display: flex; gap: 32rpx; overflow-x: auto; white-space: nowrap; }
.filter-option {
  flex-shrink: 0;
  padding: 26rpx 0 20rpx;
  color: var(--ink-3);
  font-size: 25rpx;
  border-bottom: 4rpx solid transparent;
}
.filter-selected { color: var(--brand); border-color: var(--brand); font-weight: 700; }
.funding-toggle { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 0; color: var(--ink-3); font-size: 23rpx; }
.funding-toggle switch { transform: scale(.75); transform-origin: right center; }
.refresh-action { color: var(--brand); font-size: 24rpx; padding: 10rpx 0 10rpx 16rpx; }

/* 门店页本身是满幅区块，工具条自身不需要负外边距抵消版心。 */
.order-list-controls { padding: 16rpx 28rpx 8rpx; }
.order-list-controls .section-band { margin: 0; padding-top: 4rpx; padding-bottom: 12rpx; }
.order-list-controls input { background: var(--sunken); border: 0; }

.order-entry {
  padding: 26rpx 28rpx;
  background: var(--surface);
  border-bottom: 1rpx solid var(--line);
  transition: background-color .15s ease;
}
.order-entry:active { background: var(--sunken); }
.order-entry .entry-top { align-items: flex-start; color: var(--ink-1); font-size: 26rpx; }
.entry-top > text:first-child { min-width: 0; flex: 1; }
.entry-progress { margin-top: 16rpx; color: var(--ink-2); font-size: 25rpx; }
.entry-progress .money { font-size: 30rpx; }
.entry-bottom {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line-soft);
  color: var(--ink-3);
  font-size: 23rpx;
}
.entry-bottom > text:last-child { flex-shrink: 0; color: var(--brand); font-weight: 600; }

/* 状态药丸：与全局 .status 同一实现 */
.status-label {
  flex-shrink: 0;
  max-width: 46%;
  padding: 5rpx 14rpx;
  border-radius: 10rpx;
  background: var(--sunken);
  color: var(--ink-3);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.5;
  white-space: normal;
  overflow-wrap: anywhere;
}
.status-progress { background: var(--warn-soft); color: var(--warn); }
.status-warn { background: var(--warn-soft); color: var(--warn); }
.status-done { background: var(--brand-soft); color: var(--brand-ink); }
.status-fail { background: var(--danger-soft); color: var(--danger); }
.status-muted { background: var(--sunken); color: var(--ink-4); }

/* ---------- 供应商分单 ---------- */

.group-toggle { display: flex; align-items: center; gap: 12rpx; flex: 1; min-width: 0; }
.group-toggle .section-title { flex: 0 1 auto; }
.group-summary { flex-shrink: 0; color: var(--ink-3); font-size: 23rpx; font-variant-numeric: tabular-nums; }
.request-supplier-group { padding: 24rpx 28rpx; }
.request-supplier-group .section-title { flex: 1; min-width: 0; }
.supplier-group-heading { padding: 4rpx 0; }
.supplier-group-name { display: flex; align-items: center; gap: 12rpx; }
.supplier-group-name .status-label { margin-left: auto; }
.supplier-group-summary {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 12rpx 0 0 30rpx;
  color: var(--ink-3);
  font-size: 23rpx;
}
.supplier-fold-label { flex-shrink: 0; color: var(--brand); font-weight: 600; }
.supplier-order-number { margin-top: 18rpx; }
.supplier-contact-info {
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border-radius: 14rpx;
  background: var(--sunken);
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.6;
}
.supplier-contact-info > text { display: block; overflow-wrap: anywhere; }
.supplier-phone-row { display: flex; align-items: center; gap: 16rpx; }
.supplier-phone {
  width: auto;
  min-width: 0;
  margin: 0;
  padding: 6rpx 0;
  background: transparent;
  color: var(--brand);
  font-size: 24rpx;
  line-height: 1.6;
  text-align: left;
  overflow-wrap: anywhere;
}
.request-supplier-group .confirm-line:last-child { border-bottom: 0; padding-bottom: 0; }
.group-chevron { flex-shrink: 0; color: var(--ink-faint); font-size: 30rpx; transition: transform .18s ease; }
.group-chevron.is-open { transform: rotate(90deg); }
.document-number { min-width: 0; overflow-wrap: anywhere; line-height: 1.5; }

/* ---------- 履约与收货 ---------- */

.fulfillment-group { margin-top: 24rpx; padding-top: 24rpx; border-top: 1rpx solid var(--line); }
.shipment-event { display: flex; gap: 20rpx; margin-top: 24rpx; }
.timeline-dot {
  flex-shrink: 0;
  width: 12rpx;
  height: 12rpx;
  margin-top: 14rpx;
  border-radius: 50%;
  background: var(--ink-faint);
}
.timeline-content { min-width: 0; flex: 1; padding-bottom: 18rpx; color: var(--ink-1); font-size: 25rpx; }
.batch-receipt { width: 236rpx; height: 64rpx; margin: 18rpx 0 0; font-size: 23rpx; }

.receipt-line { padding: 26rpx 0; border-bottom: 1rpx solid var(--line); }
.receipt-counts { margin-top: 18rpx; }
.receipt-input-group { display: flex; flex-shrink: 0; align-items: center; gap: 18rpx; color: var(--ink-2); font-size: 24rpx; }
.receipt-quantity {
  width: 150rpx;
  height: 76rpx;
  padding: 0 12rpx;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  background: var(--sunken);
  text-align: center;
  font-size: 28rpx;
  font-variant-numeric: tabular-nums;
}
.locked-label { display: block; margin-top: 12rpx; color: var(--ink-4); font-size: 22rpx; }
.receipt-bar > text { flex: 1; color: var(--ink-1); font-size: 25rpx; }
.receipt-submit-summary { min-width: 0; flex: 1; color: var(--ink-1); font-size: 25rpx; }
.receipt-submit-hint { display: block; margin-top: 6rpx; color: var(--ink-3); font-size: 22rpx; }
.receipt-field-error, .receipt-shortage { display: block; margin-top: 12rpx; color: var(--danger); font-size: 24rpx; }
.receipt-shortage { color: var(--warn); }

.result-banner {
  display: flex;
  gap: 18rpx;
  margin: 20rpx 28rpx;
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  background: var(--brand-soft);
  color: var(--brand-ink);
  font-size: 27rpx;
}
.result-banner > view { min-width: 0; flex: 1; }
.result-banner .secondary-text { color: var(--ink-2); }

.discrepancy-store-entry { padding: 24rpx 28rpx; }
.discrepancy-store-entry .button-row { grid-template-columns: 1fr 1fr; }

/* ---------- 凭证 ---------- */

.receipt-evidence-section { margin-top: 20rpx; padding: 28rpx; background: var(--surface); }
.receipt-evidence-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14rpx; margin-top: 16rpx; }
.receipt-evidence-tile, .evidence-add { position: relative; height: 100px; min-width: 0; overflow: hidden; border-radius: 12rpx; }
.receipt-evidence-tile image { width: 100%; height: 100%; }
.evidence-state {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 3px;
  background: rgba(0, 0, 0, .55);
  color: #fff;
  font-size: 11px;
  text-align: center;
}
.evidence-remove {
  position: absolute;
  top: 2px;
  right: 2px;
  width: 30px;
  height: 30px;
  padding: 0;
  border-radius: 15px;
  background: rgba(20, 30, 24, .55);
  color: #fff;
  font-size: 20px;
  line-height: 28px;
}
.evidence-retry { position: absolute; top: 34px; right: 8px; left: 8px; height: 30px; padding: 0; border-radius: 8rpx; background: var(--surface); color: var(--danger); font-size: 12px; line-height: 30px; }
.evidence-add {
  width: 100%;
  margin: 0;
  background: var(--brand-soft);
  border: 1rpx dashed var(--brand);
  color: var(--brand);
  font-size: 30px;
  line-height: 98px;
}
.receipt-evidence-row { display: flex; align-items: center; gap: 10px; padding: 10px 0; border-bottom: 1rpx solid var(--line-soft); }
.evidence-filename { min-width: 0; flex: 1; font-size: 13px; overflow-wrap: anywhere; }
.evidence-open { width: 60px; flex-shrink: 0; margin: 0; }
.evidence-upload-error { display: block; margin-top: 8px; color: var(--danger); font-size: 12px; overflow-wrap: anywhere; }

/* ---------- 账户与账单 ---------- */

.account-balance {
  display: block;
  margin: 24rpx 0;
  color: var(--ink-1);
  font-size: 52rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  letter-spacing: .4rpx;
  overflow-wrap: anywhere;
}
.account-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
}
.account-grid > view {
  min-width: 0;
  padding: 20rpx;
  border-radius: 14rpx;
  background: var(--sunken);
}
.account-grid > view > text { display: block; line-height: 1.5; overflow-wrap: anywhere; }
.account-grid .secondary-text { margin-top: 0; }
.account-grid text + text { margin-top: 6rpx; color: var(--ink-1); font-size: 27rpx; font-weight: 600; }

/* ---------- 空态 / 加载 ---------- */

.catalog-skeleton { padding: 32rpx 28rpx; color: var(--ink-3); font-size: 24rpx; background: var(--surface); }

/* ---------- 我的 ---------- */

.mine-identity { margin: 20rpx 24rpx 0; padding: 28rpx; border-radius: 20rpx; background: var(--surface); }
.mine-identity .muted { display: block; margin-top: 8rpx; }
.mine-secondary { margin-top: 20rpx; padding: 0 24rpx; }
.mine-secondary button { width: 100%; margin: 0; }

@media (max-width: 350px) {
  .product-media { flex-basis: 100rpx; width: 100rpx; height: 112rpx; }
  .order-bar button, .sheet-total button { flex-basis: 248rpx; width: 248rpx; }
  .quantity-stepper { margin-left: auto; }
}

/* ---------- 购物车抽屉 ---------- */

.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: var(--z-sheet);
  display: flex;
  align-items: flex-end;
  background: rgba(20, 30, 24, .35);
}
.cart-sheet {
  width: 100%;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 20rpx 20rpx 0 0;
  background: var(--surface);
}
.cart-scroll { height: 44vh; }
.close-button, .remove-item {
  flex-shrink: 0;
  width: 60rpx;
  height: 60rpx;
  margin: 0;
  padding: 0;
  background: transparent;
  color: var(--ink-3);
  font-size: 34rpx;
  line-height: 60rpx;
}
.sheet-total {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding-top: 24rpx;
  color: var(--ink-1);
  font-size: 32rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}
/* 搜索命中的分类提示：说明结果跨越了哪些分类。 */
.search-scope-hint { flex-shrink: 0; padding: 0 18rpx 12rpx; color: var(--ink-4); font-size: 22rpx; line-height: 1.5; }
