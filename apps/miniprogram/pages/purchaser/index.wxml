<view class="page">
  <view class="hero">
    <text class="eyebrow">PURCHASER</text>
    <text class="title">采购工作台</text>
    <view class="subtitle">面向 S09/S10：采购确认、资金缺口提示、供应商拒单改派。当前切片接采购申请列表、拒单通知、确认和改派。</view>
  </view>

  <view class="card">
    <text class="card-title">当前账号</text>
    <view class="metric-grid">
      <view class="metric"><text class="metric-label">用户</text><text class="metric-value">{{user.displayName || '未登录'}}</text></view>
      <view class="metric"><text class="metric-label">角色</text><text class="metric-value">{{roleText}}</text></view>
    </view>
    <view class="button-row">
      <button class="secondary" loading="{{loading}}" bindtap="loadWork">刷新待办</button>
      <button class="danger" bindtap="logout">退出</button>
    </view>
  </view>

  <view class="card">
    <text class="card-title">拒单通知</text>
    <view class="list">
      <view wx:for="{{rejectionTodos}}" wx:key="id" class="row" bindtap="selectRejection" data-request-id="{{item.purchaseRequestId}}" data-supplier-order-id="{{item.supplierOrderId}}">
        <view class="row-title"><text>{{item.supplierOrderNo}}</text><text class="tag tag-warn">待改派</text></view>
        <view class="muted">采购申请 {{item.purchaseRequestId}}，原因 {{item.reason || '未填写'}}</view>
      </view>
      <view wx:if="{{!rejectionTodos.length}}" class="row"><view class="muted">暂无供应商拒单待处理。</view></view>
    </view>
  </view>

  <view class="card">
    <text class="card-title">处理采购申请</text>
    <view class="field"><text class="field-label">采购申请 ID</text><input value="{{requestId}}" data-field="requestId" bindinput="onInput" placeholder="purchaseRequestId" /></view>
    <view class="field"><text class="field-label">被拒供应商单 ID</text><input value="{{rejectedOrderId}}" data-field="rejectedOrderId" bindinput="onInput" placeholder="supplierOrderId" /></view>
    <view class="field"><text class="field-label">改派供应商 ID</text><input value="{{targetSupplierId}}" data-field="targetSupplierId" bindinput="onInput" placeholder="supplierId" /></view>
    <view class="field"><text class="field-label">改派原因</text><input value="{{reallocateReason}}" data-field="reallocateReason" bindinput="onInput" placeholder="供应商拒单后改派" /></view>
    <view class="button-row">
      <button class="secondary" loading="{{detailing}}" bindtap="loadRequestDetail">读取详情</button>
      <button class="primary" loading="{{confirming}}" bindtap="confirmRequest">确认并推送</button>
    </view>
    <view class="button-row">
      <button class="secondary" loading="{{reallocating}}" bindtap="reallocateRequest">改派供应商</button>
    </view>
  </view>

  <view class="card" wx:if="{{selectedRequest}}">
    <text class="card-title">申请详情</text>
    <view class="metric-grid">
      <view class="metric"><text class="metric-label">资金状态</text><text class="metric-value">{{selectedRequest.paymentStatus}}</text></view>
      <view class="metric"><text class="metric-label">缺口金额</text><text class="metric-value">{{selectedRequest.shortfallAmount}}</text></view>
      <view class="metric"><text class="metric-label">销售额</text><text class="metric-value">{{selectedRequest.salesGoodsAmount}}</text></view>
      <view class="metric"><text class="metric-label">供货额</text><text class="metric-value">{{selectedRequest.supplyGoodsAmount}}</text></view>
    </view>
    <view class="list">
      <view wx:for="{{selectedRequest.items}}" wx:key="id" class="row">
        <view class="row-title"><text>{{item.productId}}</text><text class="tag">{{item.quantity}}</text></view>
        <view class="muted">供应商 {{item.supplierId}}，销售 {{item.salesLineAmount}}，供货 {{item.supplyLineAmount}}</view>
      </view>
      <view wx:for="{{selectedRequest.supplierOrders}}" wx:key="id" class="row">
        <view class="row-title"><text>{{item.supplierOrderNo}}</text><text class="tag">{{item.status}}</text></view>
        <view class="muted">履约 {{item.fulfillmentStatus}}，供应商 {{item.supplierId}}</view>
      </view>
    </view>
  </view>

  <view class="card">
    <text class="card-title">采购待办</text>
    <view class="list">
      <view wx:for="{{requests}}" wx:key="id" class="row" bindtap="selectRequest" data-id="{{item.id}}">
        <view class="row-title"><text>{{item.requestNo || item.id}}</text><text class="tag {{item.paymentStatus === 'SHORTFALL' ? 'tag-warn' : ''}}">{{item.status}}</text></view>
        <view class="muted">资金 {{item.paymentStatus || 'UNKNOWN'}}，缺口 {{item.shortfallAmount || '0.00'}}，点击读取详情。</view>
      </view>
      <view wx:if="{{!requests.length}}" class="row"><view class="muted">暂无待办或尚未刷新。</view></view>
    </view>
  </view>

  <view class="card" wx:if="{{result}}">
    <text class="card-title">处理结果</text>
    <view class="row"><view class="row-title"><text>{{result.title}}</text><text class="tag">{{result.status}}</text></view><view class="muted">{{result.detail}}</view></view>
  </view>
  <view wx:if="{{error}}" class="card"><text class="tag tag-fail">{{error}}</text></view>
</view>
