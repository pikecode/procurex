page {
  background: #f7f9f8;
  color: #18231f;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 160rpx;
  box-sizing: border-box;
}

.hero {
  padding: 18rpx 0 28rpx;
}

.eyebrow {
  color: #167e5a;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.title {
  display: block;
  margin-top: 10rpx;
  color: #1d2c24;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.18;
}

.subtitle {
  margin-top: 12rpx;
  color: #75827a;
  font-size: 25rpx;
  line-height: 1.5;
}

.card {
  margin-top: 18rpx;
  padding: 26rpx;
  border: 0;
  border-bottom: 1rpx solid #e8eeea;
  border-radius: 0;
  background: #fff;

}

.card-title {
  display: block;
  color: #24342c;
  font-size: 29rpx;
  font-weight: 750;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.muted {
  color: #7f8b85;
  font-size: 23rpx;
  line-height: 1.45;
}

.metric-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 18rpx;
}

.metric {
  padding: 20rpx;
  border: 1rpx solid #edf1ef;
  border-radius: 14rpx;
  background: #fbfcfb;
}

.metric-label {
  color: #8a9690;
  font-size: 21rpx;
}

.metric-value {
  display: block;
  margin-top: 8rpx;
  color: #187b59;
  font-size: 31rpx;
  font-weight: 800;
}

.field {
  margin-top: 18rpx;
}

.field-label {
  display: block;
  margin-bottom: 8rpx;
  color: #66736c;
  font-size: 23rpx;
}

input {
  height: 76rpx;
  padding: 0 22rpx;
  border: 1rpx solid #e2e9e5;
  border-radius: 12rpx;
  background: #fff;
  color: #24342c;
  font-size: 26rpx;
  box-sizing: border-box;
}

.button-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 22rpx;
}

.button-row button {
  width: 100%;
  margin: 0;
  box-sizing: border-box;
}

button {
  height: 76rpx;
  border-radius: 12rpx;
  font-size: 25rpx;
  font-weight: 700;
}

.primary {
  background: #167e5a;
  color: #fff;
}

.secondary {
  background: #eef6f1;
  color: #167e5a;
}

.ghost {
  width: auto;
  min-width: 132rpx;
  height: 64rpx;
  padding: 0 20rpx;
  background: #fff;
  color: #167e5a;
  border: 1rpx solid #dbe8e1;
}

.danger {
  background: #fff0ed;
  color: #b34a40;
}

.list {
  margin-top: 18rpx;
}

.row {
  padding: 22rpx 0;
  border-top: 1rpx solid #edf1ef;
}

.row:first-child {
  border-top: 0;
}

.row-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.row-title text:first-child {
  color: #24342c;
  font-size: 27rpx;
  font-weight: 700;
}

.tag {
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  background: #eaf5ef;
  color: #318363;
  font-size: 20rpx;
  font-weight: 700;
  white-space: nowrap;
}

.tag-warn {
  background: #fff3e9;
  color: #a85d22;
}

.tag-fail {
  background: #fff0ed;
  color: #b34a40;
}

.footer-action {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e8eeea;
  background: rgba(255, 255, 255, .96);
}

.view-tabs { display: flex; position: sticky; top: 0; z-index: 2; background: #f7f9f8; border-bottom: 1rpx solid #dce3df; }
.view-tab { flex: 1; padding: 24rpx 8rpx; text-align: center; font-size: 26rpx; color: #66736c; border-bottom: 4rpx solid transparent; }
.is-active { color: #167e5a; font-weight: 700; border-bottom-color: #167e5a; }
.workspace-toolbar { display: flex; justify-content: space-between; padding: 20rpx 0; color: #66736c; font-size: 23rpx; }
.error-message, .error-banner { margin-top: 24rpx; padding: 22rpx; color: #b34a40; background: #fff0ed; font-size: 25rpx; word-break: break-all; }
.login-page { padding-top: 100rpx; }
.login-page .title { font-size: 44rpx; }
.login-footer { margin-top: 48rpx; text-align: center; color: #66736c; font-size: 24rpx; }
.settings-panel { margin-top: 24rpx; border-top: 1rpx solid #dce3df; padding-top: 12rpx; }
.picker-value { padding: 22rpx; background: #f3f6f4; border-bottom: 1rpx solid #dce3df; font-size: 26rpx; }
.row-title text:first-child { min-width: 0; overflow-wrap: anywhere; }
.metric-value { overflow-wrap: anywhere; }
button { line-height: 76rpx; padding: 0 12rpx; }
button[disabled] { opacity: .5; }

.freight-request { margin-top: 28rpx; padding-top: 24rpx; border-top: 1rpx solid #e8eeea; }
.detail-line { padding-top: 20rpx; font-size: 28rpx; font-weight: 600; }
.file-name { display: block; margin-bottom: 16rpx; font-size: 25rpx; overflow-wrap: anywhere; }
.command-recovery { padding: 24rpx 0; border-bottom: 1rpx solid #dce3df; display: flex; align-items: center; gap: 16rpx; }
.command-recovery > view { flex: 1; min-width: 0; }
.command-recovery text { display: block; overflow-wrap: anywhere; }
.command-recovery button { flex: 0 0 auto; font-size: 24rpx; margin: 0; }
.command-history { padding: 24rpx 0; }
