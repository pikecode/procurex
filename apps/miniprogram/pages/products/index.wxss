/* 商品主数据（该目录不在小程序打包范围内，样式与全局体系保持一致，单位统一用 rpx） */

.products-page { padding-bottom: calc(120rpx + env(safe-area-inset-bottom)); font-size: 26rpx; }

.products-heading, .editor-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 26rpx 28rpx;
  background: var(--surface);
  border-bottom: 1rpx solid var(--line);
}
.products-heading > text { color: var(--ink-1); font-size: 34rpx; font-weight: 700; }
.editor-toolbar { justify-content: flex-start; color: var(--ink-1); font-size: 30rpx; font-weight: 700; }

.add-product, .back-product, .add-image, .remove-image {
  flex-shrink: 0;
  width: 68rpx;
  height: 68rpx;
  margin: 0;
  padding: 0;
  border-radius: 14rpx;
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 32rpx;
  line-height: 68rpx;
}

.products-search {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 20rpx 24rpx 0;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: var(--surface);
}
.products-search icon { flex-shrink: 0; }
.products-search input { min-width: 0; flex: 1; height: 80rpx; padding: 0; border: 0; background: transparent; font-size: 26rpx; }

.product-list-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  justify-content: space-between;
  margin: 0 24rpx;
  padding: 26rpx 28rpx;
  border-radius: 20rpx;
  background: var(--surface);
}
.product-list-row > view { min-width: 0; flex: 1; }
.product-title { display: block; color: var(--ink-1); font-size: 28rpx; font-weight: 600; overflow-wrap: anywhere; }
.product-state { flex-shrink: 0; color: var(--ink-3); font-size: 23rpx; }
.products-empty { padding: 64rpx 32rpx; color: var(--ink-3); font-size: 26rpx; text-align: center; }

.product-fields, .product-image-section { margin: 20rpx 24rpx 0; padding: 8rpx 28rpx; border-radius: 20rpx; background: var(--surface); }
.product-image-section { padding: 28rpx; }
.product-field {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 96rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
}
.product-field > text { width: 160rpx; flex-shrink: 0; color: var(--ink-3); font-size: 25rpx; }
.product-field input { min-width: 0; flex: 1; width: auto; height: 72rpx; border-radius: 12rpx; background: var(--sunken); }
.product-field picker { min-width: 0; flex: 1; padding: 10rpx 0; color: var(--ink-1); overflow-wrap: anywhere; }
.product-field input + picker { flex: 0 0 100rpx; }
.brand-select { color: var(--brand); font-size: 23rpx; }

.product-image-tools { display: flex; align-items: center; gap: 20rpx; margin-top: 16rpx; }
.product-image-tools image { width: 180rpx; height: 180rpx; border-radius: 14rpx; background: var(--sunken); }

.product-save-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: var(--z-action);
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--line);
  background: var(--surface);
}
.product-save-bar button { width: 100%; margin: 0; }

.crop-editor { margin: 20rpx 24rpx 0; padding: 28rpx; border-radius: 20rpx; background: var(--surface); }
.crop-frame { width: 480rpx; height: 480rpx; margin: 24rpx auto; overflow: hidden; border-radius: 16rpx; background: var(--sunken); }
.crop-actions { display: flex; gap: 20rpx; }
.crop-actions button { flex: 1; min-width: 0; margin: 0; }
.crop-canvas { position: fixed; top: 0; left: -10000px; }
.muted { overflow-wrap: anywhere; }