<wxs src="../../utils/labels.wxs" module="labels" />
<view class="center" wx:if="{{active}}">
  <block wx:if="{{!selectedId}}">
    <view class="controls"><input placeholder="搜索订单号、下货单号、门店或供应商" value="{{search}}" bindinput="onSearch" confirm-type="search" /><scroll-view scroll-x show-scrollbar="{{false}}"><view class="filters"><text class="{{filter === 'all' ? 'selected' : ''}}" data-filter="all" bindtap="chooseFilter">全部</text><text class="{{filter === 'pending' ? 'selected' : ''}}" data-filter="pending" bindtap="chooseFilter">待发货</text><text class="{{filter === 'receiving' ? 'selected' : ''}}" data-filter="receiving" bindtap="chooseFilter">履约中</text><text class="{{filter === 'completed' ? 'selected' : ''}}" data-filter="completed" bindtap="chooseFilter">已完成</text><text class="{{filter === 'closed' ? 'selected' : ''}}" data-filter="closed" bindtap="chooseFilter">已关闭 / 拒单</text></view></scroll-view></view>
    <view class="dates"><picker mode="date" value="{{from}}" data-field="from" bindchange="chooseDate"><text>{{from || '开始日期'}}</text></picker><text>至</text><picker mode="date" value="{{to}}" data-field="to" bindchange="chooseDate"><text>{{to || '结束日期'}}</text></picker><text wx:if="{{from || to}}" bindtap="clearDates">清除</text></view>
    <text class="date-error" wx:if="{{dateError}}">{{dateError}}</text>
    <view class="caption"><text>{{loading || error ? '—' : total}} 张订单</text><text bindtap="load">刷新</text></view>
    <view class="error" wx:if="{{error}}">{{error}}<button bindtap="load">重试</button></view>
    <view class="empty" wx:elif="{{loading}}">正在读取订单</view>
    <view class="entry" wx:for="{{visible}}" wx:key="id" data-id="{{item.id}}" bindtap="open">
      <view class="row"><text class="title">{{mode === 'store' ? item.supplierName : item.storeName}}</text><text class="state">{{labels.status(item.status)}}</text></view>
      <text class="meta" wx:if="{{mode === 'purchaser'}}">{{item.supplierName}}</text>
      <view class="number">订单号 <document-no value="{{item.supplierOrderNo}}" /></view>
      <text class="summary">{{item.productSummary || '查看商品清单'}}</text>
      <view class="row"><text class="meta">{{item.createdText}}</text><text class="money">¥{{labels.money(item.salesGoodsAmount)}} ›</text></view>
    </view>
    <view class="empty" wx:if="{{!loading && !error && !visible.length}}">{{search || filter !== 'all' ? '没有符合条件的订单' : '暂无正式订单'}}</view>
    <button class="more" wx:if="{{more && !loading && !error}}" bindtap="more">加载更多订单</button>
  </block>
  <block wx:else>
    <view class="toolbar"><text bindtap="close">‹ 返回订单列表</text><text>订单详情</text></view>
    <view class="empty" wx:if="{{detailing}}">正在读取订单</view>
    <view class="error" wx:if="{{detailError}}">{{detailError}}<button bindtap="open">重试</button></view>
    <block wx:if="{{selected}}">
      <view class="band"><view class="row"><text class="title">{{selected.supplierName}}</text><text class="state">{{labels.status(selected.status)}}</text></view><text class="meta">门店：{{selected.storeName}}</text><view class="number">订单号 <document-no value="{{selected.supplierOrderNo}}" /></view><view class="row"><text class="meta">{{selected.createdText}}</text><text class="money">¥{{labels.money(selected.salesGoodsAmount)}}</text></view></view>
      <view class="band"><view class="row"><text class="title">商品清单 · {{selected.items.length}} 种</text><view class="price-switch" wx:if="{{mode === 'purchaser'}}"><text>供应商价格</text><switch checked="{{showPrices}}" bindchange="prices" color="#167e5a" /></view></view>
        <view class="product" wx:for="{{selected.items}}" wx:key="id"><product-card product="{{item}}" variant="compact" bind:retryimage="retryImage"><view class="row"><text class="product-name">{{item.productName}}</text><text class="money">¥{{labels.money(item.salesLineAmount)}}</text></view><text class="meta">{{item.quantity}} {{item.unitName || item.unitSnapshot.salesUnitName || ''}} × ¥{{labels.money(item.salesUnitPrice)}}</text><text class="meta">已发 {{item.shippedQuantity}} · 已收 {{item.receivedQuantity}}</text><text class="meta" wx:if="{{showPrices && mode === 'purchaser'}}">供应商价格 ¥{{labels.money(item.supplyUnitPrice)}} · 金额 ¥{{labels.money(item.supplyLineAmount)}}</text></product-card></view>
      </view>
      <view class="band" wx:if="{{selected.supplierContact}}"><text class="title">供应商联系信息</text><text class="meta" wx:if="{{selected.supplierContact.contactName}}">联系人：{{selected.supplierContact.contactName}}</text><text class="meta phone" wx:if="{{selected.supplierContact.contactPhone}}" data-phone="{{selected.supplierContact.contactPhone}}" bindtap="callContact">业务电话：{{selected.supplierContact.contactPhone}}</text><text class="meta phone" wx:if="{{selected.supplierContact.deliveryContactPhone}}" data-phone="{{selected.supplierContact.deliveryContactPhone}}" bindtap="callContact">配送电话：{{selected.supplierContact.deliveryContactPhone}}</text><text class="meta" wx:if="{{selected.supplierContact.address}}">地址：{{selected.supplierContact.address}}</text></view>
      <view class="band"><text class="title">发货与收货</text><view class="batch" wx:for="{{selected.shipments}}" wx:key="id"><view class="row"><text>{{item.kind === 'REPLENISHMENT' ? '补发' : '发货'}} · {{item.shippedText}}</text><text class="state">{{item.currentReceiptRevision ? '已提交收货' : '待收货'}}</text></view><view class="number">发货单号 <document-no value="{{item.shipmentNo}}" /></view><text class="meta" wx:if="{{item.trackingNo}}">物流单号 {{item.trackingNo}}</text><button wx:if="{{canReceive}}" data-id="{{item.id}}" bindtap="receipt">{{item.currentReceiptRevision ? '查看本批收货' : '核对本批收货'}}</button></view><text class="meta" wx:if="{{!selected.shipments.length}}">{{selected.status === 'REJECTED' ? '供应商拒单，等待采购处理' : selected.status === 'CANCELED' ? '订单已取消' : '尚未发货'}}</text><button wx:if="{{mode === 'purchaser' && canReallocate && selected.status === 'REJECTED'}}" bindtap="reallocate">查看拒单及改派处理</button></view>
      <view class="band source" bindtap="source"><text class="meta">来源下货单</text><view class="number"><document-no value="{{selected.requestNo || '查看来源记录'}}" /> ›</view></view>
    </block>
  </block>
</view>
