<view class="profile-page">
  <view class="profile-heading">
    <view class="profile-heading-main"><text class="profile-title">{{profile.name || (kind === 'supplier' ? '我的供应商' : '我的门店')}}</text><button class="ghost profile-refresh" bindtap="loadProfile" loading="{{loading}}" disabled="{{loading}}" aria-label="刷新资料">刷新</button></view>
    <text class="profile-caption">{{kind === 'supplier' ? '供应商资料' : '门店资料'}}</text>
  </view>
  <view class="view-tabs profile-tabs" wx:if="{{kind === 'supplier'}}"><view class="view-tab {{activeView === 'profile' ? 'is-active' : ''}}" data-view="profile" bindtap="changeView">自身资料</view><view class="view-tab {{activeView === 'catalog' ? 'is-active' : ''}}" data-view="catalog" bindtap="changeView">供货商品</view></view>
  <view class="error-banner" wx:if="{{error}}">{{error}}</view>
  <view class="muted loading-state" wx:if="{{loading}}">正在读取资料</view>
  <view class="profile-fields" wx:if="{{activeView === 'profile' && profile}}"><view class="profile-field" wx:for="{{fields}}" wx:key="label"><text class="profile-label">{{item.label}}</text><text class="profile-value">{{item.value}}</text></view></view>
  <view wx:if="{{activeView === 'catalog'}}">
    <view class="catalog-tools"><view class="catalog-search"><icon type="search" size="18" /><input placeholder="商品名称、货号或规格" value="{{search}}" bindinput="onSearch" /></view></view>
    <view class="catalog-caption"><text>供货商品</text><text>{{visibleProducts.length}} 件</text></view>
    <view class="catalog-list"><view class="catalog-row" wx:for="{{visibleProducts}}" wx:key="id"><view class="catalog-row-head"><text class="catalog-name">{{item.name}}</text><text class="tag {{item.isActive ? '' : 'tag-warn'}}">{{item.isActive ? '启用' : '停用'}}</text></view><text class="muted">{{item.sku ? item.sku + ' · ' : ''}}{{item.specification || '未填规格'}}</text><text class="supply-price">{{item.supplyPrice === null ? '供货价未发布' : '¥' + labels.money(item.supplyPrice) + ' / ' + item.unitName}}</text></view></view>
    <view wx:if="{{!loading && !error && !visibleProducts.length}}" class="muted loading-state">{{products.length ? '没有匹配的商品' : '暂无供货商品'}}</view>
  </view>
</view>
<wxs src="../../utils/labels.wxs" module="labels" />
