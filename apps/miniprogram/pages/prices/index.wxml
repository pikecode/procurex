<wxs src="../../utils/labels.wxs" module="labels" />
<view class="prices-page">
  <text class="prices-title">快速改价</text>
  <view class="error-banner" wx:if="{{error}}">{{error}}</view><view class="price-notice" wx:if="{{notice}}">{{notice}}</view>
  <block wx:if="{{allowed}}">
    <view class="price-pending" wx:if="{{pendingCommand}}"><text>{{pendingCommand.title}} · 提交结果待确认</text><button wx:if="{{pendingCommand.path === '/price-changes'}}" class="secondary" bindtap="recoverPrice" disabled="{{recovering || publishing || processing}}" loading="{{recovering}}">确认原发布结果</button><button wx:elif="{{pendingRun}}" class="secondary" bindtap="recoverRun" disabled="{{recovering || publishing || processing}}" loading="{{recovering}}">确认原重算结果</button><text wx:else class="muted">采购工作台有待确认的提交</text></view>
    <view class="price-form">
      <view class="field"><text class="field-label">价格范围</text><picker range="{{templateChoices}}" range-key="name" value="{{templateIndex}}" bindchange="chooseTemplate" disabled="{{loading || quoting || previewing || publishing || recovering || processing || runUncertain || pendingCommand}}"><view class="picker-value">{{templateChoices[templateIndex].name}} ▾</view></picker></view>
      <view class="field"><text class="field-label">商品</text><picker range="{{productChoices}}" range-key="name" value="{{productIndex}}" bindchange="chooseProduct" disabled="{{loading || quoting || previewing || publishing || recovering || processing || runUncertain || pendingCommand}}"><view class="picker-value">{{productIndex < 0 ? '请选择商品' : productChoices[productIndex].name}} ▾</view></picker></view>
      <view class="field"><text class="field-label">供应商</text><picker range="{{supplierChoices}}" range-key="name" value="{{supplierIndex}}" bindchange="chooseSupplier" disabled="{{loading || quoting || previewing || publishing || recovering || processing || runUncertain || pendingCommand}}"><view class="picker-value">{{supplierIndex < 0 ? '请选择有效供应商' : supplierChoices[supplierIndex].name}} ▾</view></picker></view>
      <view class="price-pair"><view class="field"><text class="field-label">销售单价</text><input type="digit" value="{{salesPrice}}" data-field="salesPrice" bindinput="onInput" disabled="{{loading || quoting || previewing || publishing || recovering || processing || runUncertain || pendingCommand}}" /></view><view class="field"><text class="field-label">{{template ? '共享供货单价' : '供货单价'}}</text><input type="digit" value="{{supplyPrice}}" data-field="supplyPrice" bindinput="onInput" disabled="{{template || loading || quoting || previewing || publishing || recovering || processing || runUncertain || pendingCommand}}" /></view></view>
      <view class="field"><text class="field-label">生效时间</text><view class="price-pair"><picker mode="date" value="{{effectiveDate}}" data-field="effectiveDate" bindchange="changeTimestamp" disabled="{{loading || quoting || previewing || publishing || recovering || processing || runUncertain || pendingCommand}}"><view class="picker-value">{{effectiveDate}}</view></picker><picker mode="time" value="{{effectiveTime}}" data-field="effectiveTime" bindchange="changeTimestamp" disabled="{{loading || quoting || previewing || publishing || recovering || processing || runUncertain || pendingCommand}}"><view class="picker-value">{{effectiveTime}}</view></picker></view></view>
      <view class="field"><text class="field-label">改价原因</text><textarea maxlength="500" value="{{reason}}" data-field="reason" bindinput="onInput" disabled="{{loading || quoting || previewing || publishing || recovering || processing || runUncertain || pendingCommand}}" /></view>
      <view class="button-row"><button class="secondary price-preview" bindtap="previewPrice" loading="{{previewing}}" disabled="{{loading || quoting || previewing || publishing || recovering || processing || runUncertain || pendingCommand}}">预览影响</button><button class="primary price-publish" bindtap="publishPrice" loading="{{publishing}}" disabled="{{!approvedBody || loading || quoting || previewing || publishing || recovering || processing || runUncertain || pendingCommand}}">确认发布</button></view>
    </view>
    <view class="price-section" wx:if="{{impact}}"><text class="section-title">{{impact.scopeId ? '影响预览' : '首次设置价格'}}</text><view class="price-summary"><text>订单 {{impact.affectedOrderCount}} 笔</text><text>销售差额 ¥{{labels.money(impact.salesDelta)}}</text><text>供货差额 ¥{{labels.money(impact.supplyDelta)}}</text></view><view class="price-record" wx:for="{{impact.orders}}" wx:key="supplierOrderId"><text>{{item.supplierOrderNo}}</text><text class="muted">销售 ¥{{labels.money(item.salesDelta)}} · 供货 ¥{{labels.money(item.supplyDelta)}}</text></view></view>
    <view class="price-section" wx:if="{{published}}"><text class="section-title">最近发布</text><text class="price-record">销售 ¥{{labels.money(published.salesPrice)}} · 供货 ¥{{labels.money(published.supplyPrice)}}</text><text class="muted">{{published.reason}}</text></view>
    <view class="price-section" wx:if="{{run}}"><view class="price-section-head"><text class="section-title">订单重算</text><button class="ghost" bindtap="refreshRun" disabled="{{processing || publishing || recovering}}">刷新</button></view><view class="price-summary"><text>{{labels.status(run.status)}}</text><text>订单 {{run.affectedOrderCount}} 笔</text><text>销售 ¥{{labels.money(run.salesDelta)}} · 供货 ¥{{labels.money(run.supplyDelta)}}</text></view><button wx:if="{{run.status === 'PENDING'}}" class="secondary price-process" bindtap="processRun" loading="{{processing}}" disabled="{{processing || publishing || recovering || runUncertain || pendingCommand}}">执行订单重算</button></view>
    <view class="price-section" wx:if="{{run}}"><view class="price-section-head"><text class="section-title">重算记录</text><button class="ghost" bindtap="loadSubmissions" disabled="{{submissionsLoading}}" loading="{{submissionsLoading}}">刷新</button></view><view class="error-banner" wx:if="{{submissionsError}}">{{submissionsError}}</view><text class="muted" wx:if="{{!submissionsLoading && !submissionsError && !submissions.length}}">暂无提交记录</text><view class="price-record" wx:for="{{submissions}}" wx:key="id"><text>{{item.startedText}} · {{labels.status(item.status)}}</text><text class="muted" wx:if="{{item.errorText}}">{{item.errorText}}</text></view></view>
    <view class="price-section" wx:if="{{versions.length}}"><text class="section-title">价格版本</text><view class="price-record" wx:for="{{versions}}" wx:key="versionId"><text>{{item.effectiveText}}</text><text>销售 ¥{{labels.money(item.salesPrice)}} · 供货 ¥{{labels.money(item.supplyPrice)}}</text><text class="muted">{{item.reason}}</text></view></view>
    <button class="secondary" wx:if="{{!productChoices.length}}" bindtap="loadChoices" disabled="{{loading}}" loading="{{loading}}">重新加载</button>
  </block>
</view>
