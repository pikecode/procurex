@import "../../styles/workspace.wxss";

/* ---------- 待确认下货单编辑 / 拒单 ---------- */

.request-decision-panel { margin-top: 24rpx; padding-top: 24rpx; border-top: 1rpx solid var(--line); }
.request-decision-panel > .muted { display: block; margin-top: 10rpx; line-height: 1.55; }
.request-edit-card .section-head > view { min-width: 0; }
.request-edit-card .section-head .muted { display: block; margin-top: 8rpx; line-height: 1.5; }
.request-edit-line { padding: 24rpx 0; border-bottom: 1rpx solid var(--line-soft); }
.request-edit-line .row-title { align-items: center; }
.page .edit-remove { width: auto; min-width: 96rpx; margin: 0; padding: 8rpx 14rpx; color: var(--danger); font-size: 23rpx; }
.edit-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr); gap: 16rpx; margin-top: 16rpx; }
.edit-grid .field { margin: 0; min-width: 0; }
.edit-grid input,
.edit-grid .picker-value { min-height: 76rpx; padding: 16rpx; box-sizing: border-box; border-radius: 10rpx; background: var(--sunken); font-size: 25rpx; }
.edit-grid .picker-value { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.edit-price-panel { margin-top: 18rpx; padding: 18rpx; border-radius: 12rpx; background: var(--sunken); }
.edit-price-panel.is-preview { border: 1rpx solid var(--brand); background: var(--brand-soft); }
.edit-price-title { display: block; margin-bottom: 10rpx; color: var(--ink-3); font-size: 22rpx; font-weight: 600; }
.edit-price-panel.is-preview .edit-price-title { color: var(--brand-ink); }
.edit-price-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10rpx 18rpx; color: var(--ink-2); font-size: 23rpx; font-variant-numeric: tabular-nums; line-height: 1.5; }
.edit-price-pending { display: block; margin-top: 14rpx; }
.add-product-control { margin: 22rpx 0; padding: 20rpx; border: 1rpx dashed var(--brand); border-radius: 12rpx; color: var(--brand); text-align: center; font-size: 26rpx; }
.edit-preview { margin-top: 22rpx; padding: 20rpx; border-radius: 14rpx; background: var(--brand-soft); }
.edit-preview .row-title { color: var(--brand-ink); }
.edit-preview .muted { display: block; margin-top: 8rpx; }
.edit-preview .funding-shortfall { margin-top: 14rpx; }

/* 采购调整沿用门店订货的「分类目录 + 数量步进 + 核对」交互。 */
.request-catalog { height: calc(100vh - 220rpx - env(safe-area-inset-bottom)); display: flex; flex-direction: column; overflow: hidden; background: var(--surface); }
.request-catalog-tools { flex-shrink: 0; padding: 22rpx var(--space-page-x); border-bottom: 1rpx solid var(--line); background: var(--surface); }
.request-edit-title { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.request-edit-title > text:last-child { color: var(--ink-3); font-size: 22rpx; }
.request-search { display: flex; align-items: center; gap: 14rpx; height: 72rpx; margin-top: 16rpx; padding: 0 18rpx; border-radius: 12rpx; background: var(--sunken); }
.request-search input { flex: 1; height: 72rpx; font-size: 25rpx; }
.request-edit-reason { margin: 14rpx 0 0; }
.request-edit-reason input { height: 68rpx; padding: 0 18rpx; border-radius: 10rpx; background: var(--sunken); font-size: 24rpx; }
.request-catalog-browser { flex: 1; min-height: 0; display: flex; overflow: hidden; }
.request-category-sidebar { flex: 0 0 154rpx; width: 154rpx; height: 100%; background: var(--sunken); border-right: 1rpx solid var(--line); }
.request-category-option { padding: 24rpx 12rpx; border-left: 5rpx solid transparent; color: var(--ink-3); font-size: 23rpx; line-height: 1.45; text-align: center; }
.request-category-option.selected { color: var(--brand); border-left-color: var(--brand); background: var(--surface); font-weight: 700; }
.request-catalog-content { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.request-subcategories { flex-shrink: 0; white-space: nowrap; padding: 14rpx 0; border-bottom: 1rpx solid var(--line-soft); }
.request-subcategories view { display: inline-flex; gap: 12rpx; padding: 0 16rpx; }
.request-subcategories text { padding: 9rpx 16rpx; border-radius: 10rpx; background: var(--sunken); color: var(--ink-3); font-size: 22rpx; }
.request-subcategories text.selected { background: var(--brand-soft); color: var(--brand-ink); font-weight: 600; }
.request-catalog-count { flex-shrink: 0; display: flex; justify-content: space-between; padding: 14rpx 18rpx; color: var(--ink-3); font-size: 22rpx; }
.request-product-scroll { flex: 1; height: 0; min-height: 0; }
.request-product-list { padding: 0 18rpx 160rpx; }
.request-product-row { display: flex; gap: 14rpx; padding: 20rpx 0; border-bottom: 1rpx solid var(--line); }
.request-product-media { position: relative; flex: 0 0 92rpx; width: 92rpx; height: 92rpx; overflow: hidden; border-radius: 11rpx; background: var(--sunken); }
.request-product-media image { width: 100%; height: 100%; }
.request-product-media .cart-badge { position: absolute; top: 4rpx; right: 4rpx; z-index: 2; min-width: 32rpx; height: 32rpx; padding: 0 6rpx; border-radius: 16rpx; background: var(--brand); color: #fff; font-size: 19rpx; font-weight: 700; line-height: 32rpx; text-align: center; }
.request-missing-image { height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx; color: var(--ink-4); font-size: 17rpx; }
.request-product-main { flex: 1; min-width: 0; }
.request-product-heading, .request-product-bottom { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.request-product-name { min-width: 0; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--ink-1); font-size: 27rpx; font-weight: 600; }
.request-product-price { flex-shrink: 0; color: var(--ink-1); font-size: 26rpx; font-weight: 700; }
.request-product-price text { color: var(--ink-3); font-size: 19rpx; font-weight: 400; }
.request-product-meta, .request-price-detail { display: block; margin-top: 7rpx; color: var(--ink-3); font-size: 21rpx; }
.request-supplier-select { margin-top: 12rpx; padding: 10rpx 14rpx; border-radius: 9rpx; background: var(--brand-soft); color: var(--brand-ink); font-size: 23rpx; }
.request-product-bottom { margin-top: 12rpx; color: var(--ink-4); font-size: 20rpx; }
.request-catalog .quantity-stepper { display: flex; align-items: center; height: 58rpx; }
.request-catalog .step-button { position: relative; width: 58rpx; min-width: 58rpx; height: 58rpx; margin: 0; padding: 0; border: 1rpx solid var(--line); border-radius: 10rpx 0 0 10rpx; background: var(--surface); color: var(--ink-2); line-height: 56rpx; }
.request-catalog .step-add { border-radius: 0 10rpx 10rpx 0; color: var(--brand); }
.request-catalog .quantity-input { width: 76rpx; height: 58rpx; box-sizing: border-box; border-top: 1rpx solid var(--line); border-bottom: 1rpx solid var(--line); text-align: center; font-size: 23rpx; }
.request-edit-summary { position: fixed; left: 0; right: 0; bottom: calc(194rpx + env(safe-area-inset-bottom)); z-index: calc(var(--z-action) - 1); display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 14rpx var(--space-page-x); background: var(--surface); border-top: 1rpx solid var(--line); }
.request-edit-summary > view text { display: block; }
.request-edit-summary > view text:last-child { margin-top: 3rpx; color: var(--ink-1); font-size: 29rpx; font-weight: 700; }
.request-edit-summary > text { max-width: 52%; color: var(--ink-3); font-size: 21rpx; text-align: right; }
.request-confirm-line { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; padding: 22rpx 0; border-bottom: 1rpx solid var(--line-soft); }
.request-confirm-line > view:first-child { min-width: 0; flex: 1; }
.request-confirm-amount { flex-shrink: 0; text-align: right; font-variant-numeric: tabular-nums; }
.request-confirm-amount text { display: block; }
.request-confirm-amount text:last-child { margin-top: 8rpx; color: var(--ink-3); font-size: 22rpx; }
.sheet-mask { position: fixed; inset: 0; z-index: 100; background: rgba(18, 31, 25, .42); }
.request-cart-sheet { position: absolute; left: 0; right: 0; bottom: 0; max-height: 68vh; padding: 24rpx var(--space-page-x) calc(24rpx + env(safe-area-inset-bottom)); border-radius: 24rpx 24rpx 0 0; background: var(--surface); }
.request-cart-sheet scroll-view { height: 42vh; }
.request-cart-line { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 20rpx 0; border-bottom: 1rpx solid var(--line-soft); }
.request-cart-line > view { min-width: 0; flex: 1; }
.request-cart-line button { width: auto; margin: 0; color: var(--danger); font-size: 22rpx; }
.request-cart-total { padding-top: 20rpx; color: var(--ink-1); font-size: 30rpx; font-weight: 700; text-align: right; }

/* ---------- 待办三分类 ---------- */

.procurement-tabs {
  display: flex;
  gap: 12rpx;
  padding: 12rpx var(--space-page-x);
}
.procurement-tab {
  flex: 1;
  min-width: 0;
  padding: 16rpx 8rpx;
  border-radius: 14rpx;
  text-align: center;
  color: var(--ink-3);
  font-size: 24rpx;
  line-height: 1.4;
}
.procurement-tab.selected { background: var(--brand-soft); color: var(--brand-ink); }
.procurement-tab .task-count {
  display: block;
  margin: 0 0 6rpx;
  color: var(--ink-1);
  font-size: 40rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  line-height: 1.2;
}
.procurement-tab.selected .task-count { color: var(--brand); }
.procurement-tab .task-count.is-empty { color: var(--ink-4); }

/* ---------- 待办列表 ---------- */

/* 与分类栏保持相同外侧边距，任务卡片不贴屏幕边缘。 */
.procurement-list { margin: var(--space-section-y) var(--space-page-x) 0; }
.procurement-list-title {
  padding: 4rpx 0 8rpx;
  color: var(--ink-3);
  font-size: 23rpx;
}
.procurement-task {
  margin-top: 12rpx;
  padding: var(--space-content-x);
  border-radius: 20rpx;
  background: var(--surface);
  transition: background-color .15s ease;
}
.procurement-task:active { background: var(--sunken); }
.procurement-list > .empty-state { padding: 48rpx 16rpx; }

.procurement-task-top,
.procurement-task-bottom {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
}
.procurement-store {
  min-width: 0;
  flex: 1;
  color: var(--ink-1);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.35;
  overflow-wrap: anywhere;
}
.procurement-amount {
  flex-shrink: 0;
  color: var(--ink-1);
  font-size: 32rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}
.procurement-task-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 8rpx 16rpx;
  margin-top: 12rpx;
  color: var(--ink-3);
  font-size: 23rpx;
}
.procurement-task-bottom {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--line-soft);
  font-size: 24rpx;
}
.procurement-state { flex-shrink: 0; color: var(--ink-3); font-size: 23rpx; }
.procurement-state.warning { color: var(--warn); }
.procurement-command { flex-shrink: 0; color: var(--brand); font-weight: 600; }
.procurement-supplier { margin-top: 10rpx; color: var(--ink-2); font-size: 26rpx; overflow-wrap: anywhere; }
.procurement-reason { margin-top: 8rpx; color: var(--ink-3); font-size: 24rpx; line-height: 1.5; overflow-wrap: anywhere; }

/* ---------- 运费记录 ---------- */

.freight-row { transition: background-color .15s ease; }
.freight-row:active { background: var(--sunken); }
.freight-row .detail-line { padding-top: 12rpx; }
.report-page-heading { display: flex; flex-direction: column; gap: 6rpx; margin: 18rpx 0 22rpx; }
.report-page-heading > text:first-child { color: var(--ink-1); font-size: 32rpx; font-weight: 700; }
.report-page-heading > text:last-child { color: var(--ink-3); font-size: 22rpx; }
.report-filter-panel { padding: 20rpx; border: 1rpx solid var(--line-soft); border-radius: 12rpx; background: var(--sunken); }
.report-filter-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 12rpx; }
.report-filter-heading > text:first-child { color: var(--ink-1); font-size: 26rpx; font-weight: 700; }
.report-filter-heading > text:last-child { color: var(--ink-3); font-size: 20rpx; }
.report-filter-label { margin-top: 18rpx; color: var(--ink-2); font-size: 22rpx; font-weight: 600; }
.report-filter-label-spaced { margin-top: 22rpx; }
.report-presets { display: flex; gap: 4rpx; margin-top: 10rpx; padding: 5rpx; border-radius: 10rpx; background: var(--surface); }
.report-presets > view { flex: 1; min-width: 0; padding: 12rpx 2rpx; border-radius: 8rpx; color: var(--ink-3); font-size: 21rpx; line-height: 1.4; text-align: center; white-space: nowrap; }
.report-presets > .selected { background: var(--brand-soft); color: var(--brand-ink); font-weight: 700; }
.report-selected-range { margin-top: 10rpx; color: var(--ink-3); font-size: 21rpx; font-variant-numeric: tabular-nums; }
.report-date-range { display: flex; align-items: center; gap: 10rpx; margin-top: 10rpx; font-size: 23rpx; }
.report-date-range picker { flex: 1; min-width: 0; }
.report-date-range picker > view,
.report-entity-filters picker > view { min-height: 76rpx; box-sizing: border-box; padding: 11rpx 12rpx; border: 1rpx solid var(--line); border-radius: 9rpx; background: var(--surface); }
.report-date-range text { display: block; white-space: nowrap; }
.report-date-range .report-date-separator { flex: 0 0 auto; margin-top: 20rpx; color: var(--ink-4); font-size: 21rpx; }
.report-date-label { display: block; margin-bottom: 5rpx; color: var(--ink-3); font-size: 19rpx; font-weight: 400; }
.picker-caret { display: inline !important; color: var(--ink-4); }
.report-entity-filters { display: flex; gap: 10rpx; margin-top: 10rpx; }
.report-entity-filters picker { flex: 1; min-width: 0; }
.report-entity-filters picker > view { min-height: 82rpx; }
.report-entity-filters picker text:last-child { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 22rpx; }
.report-query-button { width: 100%; height: 72rpx; margin: 18rpx 0 0; border-radius: 9rpx; font-size: 25rpx; line-height: 72rpx; }
.report-scope { padding: 18rpx 0 14rpx; color: var(--ink-3); font-size: 21rpx; line-height: 1.5; }
.report-results { margin-top: 8rpx; padding-top: 20rpx; border-top: 1rpx solid var(--line); }
.report-metric-note { display: block; color: var(--ink-3); font-size: 21rpx; margin-top: 8rpx; line-height: 1.5; }
.procurement-report-metrics > .metric:first-child { grid-column: 1 / -1; }
.report-order-list { margin-top: 24rpx; }
.report-order { padding: 22rpx 0; border-bottom: 1rpx solid var(--line); }
.report-order-heading { padding: 8rpx 0; }
.report-order-foot { display: flex; justify-content: space-between; align-items: baseline; gap: 16rpx; margin-top: 14rpx; font-size: 23rpx; color: var(--ink-3); }
.report-order-foot > text:last-child { flex-shrink: 0; color: var(--brand); }
.report-order-products { margin-top: 16rpx; border-top: 1rpx solid var(--line-soft); }
.report-product { padding: 20rpx 0; border-bottom: 1rpx solid var(--line-soft); }
.report-order-products .row-title { font-size: 26rpx; }
.report-order-products .row-title > text:last-child { flex-shrink: 0; }
.report-order-totals { color: var(--ink-2); }
.report-supplier-group { margin-top: 24rpx; }
.report-supplier-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; padding: 16rpx; background: var(--sunken); border-left: 4rpx solid var(--brand); font-size: 28rpx; font-weight: 600; }
.report-supplier-heading > text:first-child { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.report-supplier-heading > text:last-child { flex-shrink: 0; font-size: 22rpx; color: var(--ink-3); font-weight: 400; }
.report-supplier-group .report-order { margin-left: 16rpx; padding-left: 16rpx; border-left: 1rpx solid var(--line); }
.report-supplier-group .report-order:last-child { border-bottom: none; }
.report-order-heading .row-title document-no { min-width: 0; flex: 1; }
.report-order-heading .row-title > text:last-child { flex-shrink: 0; }
.confirmation-funds { margin-top: 24rpx; padding-top: 22rpx; border-top: 1rpx solid var(--line); }
.funds-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 16rpx; font-size: 28rpx; font-weight: 600; }
.funds-heading .funds-refresh { flex-shrink: 0; width: auto; height: 64rpx; min-height: 0; margin: 0; padding: 0 14rpx; line-height: 64rpx; font-size: 24rpx; color: var(--brand); background: transparent; border: 0; }
.funds-refresh::after { border: 0; }
.funds-grid { display: grid; grid-template-columns: 1fr 1.35fr 1.35fr; gap: 12rpx; align-items: baseline; }
.funds-grid > text { min-width: 0; overflow-wrap: anywhere; }
.funds-grid > text:not(:first-child) { text-align: right; font-variant-numeric: tabular-nums; }
.funds-table-heading { padding-bottom: 10rpx; color: var(--ink-3); font-size: 22rpx; }
.funds-table-row { padding: 14rpx 0; font-size: 25rpx; color: var(--ink-1); border-bottom: 1rpx solid var(--line-soft); }
.funds-gap { margin-top: 18rpx; padding: 16rpx 18rpx; background: var(--warn-soft, #fff5e4); border-left: 4rpx solid var(--warn); }
.funds-gap > view { display: flex; justify-content: space-between; gap: 16rpx; padding: 4rpx 0; color: var(--warn); font-size: 25rpx; font-weight: 600; }
.funds-gap > view > text:last-child { text-align: right; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; min-width: 0; }
.funds-next-step { display: block; margin-top: 12rpx; font-size: 23rpx; line-height: 1.6; color: var(--ink-3); }
.funds-ready { margin-top: 16rpx; font-size: 24rpx; color: var(--brand); }
.page .confirmation-actions > button { padding: 0 10rpx; font-size: 24rpx; white-space: nowrap; }
.page .confirmation-actions .action-secondary { flex: 0 0 132rpx; }
