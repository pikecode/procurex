@import "../../styles/workspace.wxss";
.audit-page { padding: 24rpx; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }
.audit-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.audit-heading button { margin: 0; }
.audit-funds { padding: 20rpx 0; border-bottom: 1rpx solid #e2e8e5; }
.audit-funds .detail-line { display: flex; justify-content: space-between; gap: 16rpx; }
.audit-shortfall { color: #985b12; }
.audit-actions { display: flex; gap: 16rpx; margin-top: 24rpx; }
.audit-actions button { flex: 1; margin: 0; }
.audit-reason { box-sizing: border-box; width: 100%; padding: 16rpx; background: #f3f5f4; margin-top: 20rpx; }
.audit-section-title { display: block; font-weight: 600; margin: 24rpx 0 12rpx; }
