@import "../../styles/workspace.wxss";

.business-heading > button { margin: 0; flex-shrink: 0; }

.account-entry {
  display: block;
  transition: background-color .15s ease;
}
.account-entry:active { background: var(--sunken); }
.account-entry .row-title { align-items: center; }
.account-entry .row-title > text:last-child { flex: 0 0 auto; color: var(--brand); font-size: 32rpx; }
.account-entry .muted { display: block; margin-top: 10rpx; }

.finance-amount {
  display: block;
  padding: 24rpx 0;
  color: var(--ink-1);
  font-size: 48rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0;
}

.review-band {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: var(--sunken);
}
.review-band .card-title { font-size: 28rpx; }
.review-band input { margin-top: 12rpx; }

.business-search { height: 80rpx; padding: 0 var(--space-page-x); border-radius: 12rpx; background: var(--sunken); }

.payment-registration { margin-top: 28rpx; padding-top: 24rpx; border-top: 1rpx solid var(--line); }
.payment-registration .section-head { display: flex; flex-direction: column; align-items: flex-start; gap: 6rpx; margin-bottom: 12rpx; }
.payment-registration .section-head .muted { font-size: 23rpx; }
.payment-select-row { display: flex; align-items: center; gap: 18rpx; min-height: 104rpx; border-bottom: 1rpx solid var(--line); }
.payment-check { display: flex; flex: 0 0 38rpx; width: 38rpx; height: 38rpx; align-items: center; justify-content: center; border: 2rpx solid var(--line); border-radius: 50%; color: #fff; font-size: 24rpx; }
.payment-check.is-checked { border-color: var(--brand); background: var(--brand); }
.payment-select-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 6rpx; }
.payment-select-copy .muted { font-size: 23rpx; }
.payment-registration > button { margin-top: 18rpx; }
.payment-preview { margin-top: 20rpx; padding: 20rpx; border-radius: 12rpx; background: var(--sunken); }
.payment-preview .muted { display: block; margin-top: 8rpx; }
.finance-amount-inline { font-size: 32rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.payment-preview .field { margin-top: 20rpx; }
.payment-preview .button-row { display: flex; gap: 16rpx; margin-top: 20rpx; }
.payment-preview .button-row button { flex: 1; margin: 0; }
.payment-locked { display: block; margin-top: 24rpx; }
