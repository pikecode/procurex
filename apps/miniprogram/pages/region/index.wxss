@import "../../styles/workspace.wxss";

.business-heading > button { margin: 0; flex-shrink: 0; }

/* ---------- 门店范围筛选 ---------- */

.scope-controls .scope-filter { padding: 10rpx 0; }
.scope-controls .task-tabs { padding: 0; }
.scope-filter .picker-value {
  min-height: 72rpx;
  border: 0;
  padding: 0;
  background: transparent;
  font-weight: 600;
}
.scope-filter .picker-value text { flex-shrink: 0; color: var(--ink-faint); }

/* ---------- 角色导航：5 项时需要更紧凑 ---------- */

.business-nav .nav-item { font-size: 25rpx; }

.date-controls {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 20rpx;
  color: var(--ink-3);
  font-size: 24rpx;
}
.date-controls picker {
  min-width: 190rpx;
  padding: 18rpx 22rpx;
  border-radius: 12rpx;
  background: var(--sunken);
  color: var(--ink-1);
}
.date-controls button { margin: 0; font-size: 24rpx; }

.record-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 12rpx;
  color: var(--ink-3);
  font-size: 24rpx;
}
.record-footer > text:last-child { flex-shrink: 0; color: var(--ink-1); font-weight: 700; font-variant-numeric: tabular-nums; }

.command-recovery { border-radius: 16rpx; }
