.product-card { position: relative; display: flex; align-items: flex-start; gap: 20rpx; min-width: 0; }
.product-media { flex: none; width: 92rpx; height: 92rpx; overflow: hidden; background: #f1f4f2; border: 1rpx solid #e2e6e4; border-radius: 6rpx; display: flex; align-items: center; justify-content: center; }
.product-media image { width: 100%; height: 100%; }
.missing-image { padding: 6rpx; text-align: center; color: #89958e; font-size: 20rpx; line-height: 1.35; }
.product-content { flex: 1; min-width: 0; }
.compact .product-media { width: 84rpx; height: 84rpx; }
