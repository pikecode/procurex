/* 登录页：品牌区 + 浮起的表单卡 */

.page {
  min-height: 100vh;
  padding: 120rpx 32rpx 64rpx;
  background: var(--canvas);
}
.login-page .hero { padding: 0 0 40rpx; }
.login-page .title { margin-top: 16rpx; font-size: 52rpx; }
.login-form {
  padding: 36rpx 32rpx;
  border-radius: 24rpx;
  background: var(--surface);
}
.login-form .field:first-child { margin-top: 0; }
.login-form .button-row { grid-template-columns: 1fr; margin-top: 36rpx; }
.login-form .button-row button { height: 88rpx; line-height: 88rpx; }
.login-form .error-message { margin: 0 -32rpx 0 0; }
.login-footer { margin-top: 40rpx; }