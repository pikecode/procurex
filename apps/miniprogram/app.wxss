/* ===========================================================================
   ProcureX 小程序 · 设计令牌与原语层
   这里是颜色、字阶、圆角、间距与基础控件的唯一来源。页面样式只消费、不重定义。
   类型阶梯：meta 23 · body 26 · title 32 · display 40 · amount 30 · amount-lg 38
   =========================================================================== */

.document-tabs { display: flex; gap: 36rpx; padding: 20rpx 24rpx 0; background: #fff; }
.document-tabs text { padding: 0 0 18rpx; color: #66766d; font-size: 28rpx; }
.document-tabs .is-active { color: #167e5a; font-weight: 600; border-bottom: 4rpx solid #167e5a; }

page {
  --space-page-x: 24rpx;
  --space-content-x: 28rpx;
  --space-section-y: 20rpx;
  --space-control-gap: 16rpx;
  /* 品牌绿。--brand 是动作色，--brand-deep 是页头整块底色（与原生导航栏同色，
     两者拼成一条完整的品牌色带）。全部色值已验算 WCAG 对比度。 */
  --brand: #167e5a;
  --brand-deep: #0f5a40;
  --brand-soft: #e8f2ed;
  --brand-ink: #0b5540;

  /* 中性色刻意不带绿相：之前的中性灰是绿调的，导致白卡片和灰底都是绿的，
     卡片浮不起来。四级全部满足 WCAG AA（白/凹陷底/页面底三种背景）。

     注意：ink-3 与 ink-4 的明度差极小（5.66 vs 5.38），人眼几乎无法区分。
     这是刻意的取舍——四级灰要全部过 AA，色阶必然被压窄。
     实际的层级差异由字号和字重承担，不靠明度。 */
  --ink-1: #15191c;
  --ink-2: #4b5450;
  --ink-3: #5d6a64;
  --ink-4: #626d68;
  --ink-faint: #b0bab5;

  --canvas: #eaeceb;
  --surface: #ffffff;
  --sunken: #eaecee;

  --line: #e3e7e9;
  --line-soft: #eef0f1;

  --warn: #8a5a10;
  --warn-soft: #fcf3e4;
  --danger: #b03a2f;
  --danger-soft: #fceceb;
  --info: #2f5f8c;
  --info-soft: #eef3f9;

  /* 层级阶梯：粘性控件条 < 角色导航 < 底部操作条 < 抽屉 < 工作区切换 */
  --z-sticky: 20;
  --z-nav: 30;
  --z-action: 31;
  --z-sheet: 40;
  --z-tabbar: 100;

  background: var(--canvas);
  color: var(--ink-1);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 26rpx;
}

view, text, input, textarea, button, label { box-sizing: border-box; }

/* ---------- 版心与区块 ---------- */

.page {
  min-height: 100vh;
  padding: var(--space-section-y) var(--space-page-x) calc(150rpx + env(safe-area-inset-bottom));
}

/* 浮起的白色区块。页面底色为 --canvas，卡片靠圆角 + 留白与背景分离。 */
.card {
  margin-top: var(--space-section-y);
  padding: var(--space-content-x);
  border-radius: 20rpx;
  background: var(--surface);
}

.card-title {
  display: block;
  color: var(--ink-1);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.35;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.muted {
  color: var(--ink-3);
  font-size: 23rpx;
  line-height: 1.5;
}

/* ---------- 字阶 ---------- */

.title { display: block; margin-top: 10rpx; color: var(--ink-1); font-size: 40rpx; font-weight: 700; line-height: 1.2; }
.subtitle { margin-top: 12rpx; color: var(--ink-3); font-size: 26rpx; line-height: 1.55; }
.eyebrow { color: var(--brand); font-size: 22rpx; font-weight: 700; letter-spacing: 2rpx; }
.detail-line { padding-top: 20rpx; color: var(--ink-2); font-size: 26rpx; line-height: 1.5; }
.file-name { display: block; margin-bottom: 16rpx; font-size: 25rpx; overflow-wrap: anywhere; }

/* 金额：全应用唯一的数字样式。列表内右对齐，详情内左侧成组。 */
.amount {
  display: block;
  color: var(--ink-1);
  font-size: 30rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  letter-spacing: .2rpx;
  overflow-wrap: anywhere;
}
.amount-lg { font-size: 38rpx; line-height: 1.25; }
.amount-brand { color: var(--brand); }
.amount-warn { color: var(--warn); }
.amount-danger { color: var(--danger); }
.money { flex-shrink: 0; text-align: right; font-variant-numeric: tabular-nums; }

/* ---------- 列表 ---------- */

.list { margin-top: 8rpx; }

.row {
  padding: 24rpx 0;
  border-top: 1rpx solid var(--line-soft);
}
.row:first-child { border-top: 0; }

.row-title {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}
.row-title text:first-child,
.row-title > text:first-child {
  min-width: 0;
  flex: 1;
  color: var(--ink-1);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
  overflow-wrap: anywhere;
}
.row-title .muted, .row-title .tag, .row-title .status { flex-shrink: 0; }

/* 可点击的行统一按压反馈 */
.pressable { transition: background-color .15s ease; }
.pressable:active { background: var(--sunken); }

/* ---------- 状态药丸：唯一实现 ---------- */

.status, .tag {
  flex-shrink: 0;
  display: inline-block;
  max-width: 46%;
  padding: 5rpx 14rpx;
  border-radius: 10rpx;
  background: var(--sunken);
  color: var(--ink-3);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.5;
  white-space: normal;
  overflow-wrap: anywhere;
}
.status.tone-brand, .tag.tone-brand,
.status.tone-done, .tag.tone-done { background: var(--brand-soft); color: var(--brand-ink); }
.status.tone-warn, .tag.tone-warn,
.status.tone-progress { background: var(--warn-soft); color: var(--warn); }
.status.tone-danger, .tag.tone-danger,
.status.tone-fail { background: var(--danger-soft); color: var(--danger); }
.status.tone-info { background: var(--info-soft); color: var(--info); }
.status.tone-muted { background: var(--sunken); color: var(--ink-4); }

.tag-warn { background: var(--warn-soft); color: var(--warn); }
.tag-fail { background: var(--danger-soft); color: var(--danger); }

/* ---------- 指标卡 ---------- */

.metric-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 20rpx;
}
.metric {
  min-width: 0;
  padding: 22rpx;
  border-radius: 16rpx;
  background: var(--sunken);
}
.metric-label { display: block; color: var(--ink-3); font-size: 22rpx; }
.metric-value {
  display: block;
  margin-top: 8rpx;
  color: var(--ink-1);
  font-size: 30rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  overflow-wrap: anywhere;
}
.metric-value.tone-warn { color: var(--warn); }
.metric-value.tone-danger { color: var(--danger); }

/* ---------- 表单 ---------- */

.field { margin-top: 22rpx; }
.field-label {
  display: block;
  margin-bottom: 10rpx;
  color: var(--ink-3);
  font-size: 23rpx;
}

input, textarea, .picker-value {
  width: 100%;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  background: var(--sunken);
  color: var(--ink-1);
  font-size: 27rpx;
}
input { height: 80rpx; padding: 0 20rpx; }
textarea {
  min-height: 120rpx;
  padding: 18rpx 20rpx;
  line-height: 1.5;
}
.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 80rpx;
  padding: 0 20rpx;
  overflow-wrap: anywhere;
}

/* ---------- 按钮 ---------- */

.button-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 24rpx;
}
.button-row button { width: 100%; margin: 0; }

button {
  height: 80rpx;
  margin: 0;
  border-radius: 12rpx;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 80rpx;
}
/* 微信 button 默认带一圈 ::after 描边，这里统一抹掉，使各角色按钮渲染一致。 */
button::after { border: 0; }
button[disabled] { opacity: .45; }

.primary { background: var(--brand); color: #fff; }
.secondary { background: var(--brand-soft); color: var(--brand-ink); }
.ghost {
  position: relative;
  flex-shrink: 0;
  width: auto;
  min-width: 132rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 20rpx;
  background: var(--surface);
  color: var(--brand);
  border: 1rpx solid var(--line);
}
/* 次要按钮高 64rpx (32pt)，热区补到 88rpx (44pt)。 */
.ghost::before { content: ''; position: absolute; top: -12rpx; right: -8rpx; bottom: -12rpx; left: -8rpx; }
.danger { background: var(--danger-soft); color: var(--danger); }

/* ---------- 空态 / 加载 / 错误 ---------- */

.empty-state {
  padding: 72rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  color: var(--ink-3);
  font-size: 26rpx;
  text-align: center;
}
.empty-state .secondary-text { text-align: center; }
.empty-action {
  margin-top: 8rpx;
  height: 68rpx;
  line-height: 66rpx;
  padding: 0 28rpx;
  border: 1rpx solid var(--line);
  background: var(--surface);
  color: var(--brand);
  font-size: 25rpx;
}
.empty-hint { padding: 20rpx 0 4rpx; color: var(--ink-4); font-size: 23rpx; text-align: center; }

.skeleton { padding: 32rpx 28rpx; color: var(--ink-3); font-size: 24rpx; }
.skeleton-line {
  height: 120rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  background: #e2e7e6;
}
.workspace-loading { padding: 24rpx 28rpx; color: var(--ink-3); font-size: 24rpx; background: var(--surface); }

.error-banner, .error-message {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  background: var(--danger-soft);
  color: var(--danger);
  font-size: 25rpx;
  line-height: 1.5;
  overflow-wrap: anywhere;
}
.error-banner button { flex-shrink: 0; }

/* 提示条：info / warn 两种语义 */
.notice {
  margin: var(--space-section-y) var(--space-page-x);
  padding: 20rpx 22rpx;
  border-radius: 16rpx;
  border-left: 6rpx solid;
  font-size: 24rpx;
  line-height: 1.6;
  overflow-wrap: anywhere;
}
.notice-info { background: var(--info-soft); color: var(--info); border-color: #7599bd; }
.notice-warn { background: var(--warn-soft); color: var(--warn); border-color: #d3a953; }
.notice-error { background: var(--danger-soft); color: var(--danger); border-color: #c95f59; }
.notice button { margin-top: 14rpx; width: 100%; }

/* ---------- 页内标签组 ---------- */

/* ---------- 粘性控件条 ----------

   列表头部的 tab / 搜索 / 筛选条统一用这一套：吸顶、满幅、不透明。
   满幅是关键——保留左右留白会让列表内容从两侧缝隙里透出来。

   --bleed 是负外边距的抵消量，必须等于它所依附容器的左右内边距：
   .page 本身没有左右内边距，所以直接挂在 .page 下的条 --bleed 为 0，
   由各自规则给 padding;只有嵌在 .card 里的才需要抵消卡片内边距。 */

.sticky-bar {
  --bleed: 0;
  position: sticky;
  top: 0;
  z-index: var(--z-sticky);
  margin-right: calc(-1 * var(--bleed));
  margin-left: calc(-1 * var(--bleed));
  padding-right: var(--bleed);
  padding-left: var(--bleed);
  background: var(--surface);
  border-bottom: 1rpx solid var(--line);
}
.card .sticky-bar { --bleed: 28rpx; }
/* 挂在 .page 下、且自身没有左右留白的条，统一给 24rpx */
.sticky-bar { padding-right: 24rpx; padding-left: 24rpx; }
.card .sticky-bar, .order-list-controls { padding-right: var(--bleed); padding-left: var(--bleed); }

.view-tabs { display: flex; }
.view-tab {
  flex: 1;
  padding: 24rpx 8rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--ink-3);
  border-bottom: 4rpx solid transparent;
}
.is-active { color: var(--brand); font-weight: 700; border-bottom-color: var(--brand); }

/* 固定在吸顶条下方的次级筛选行（不吸顶，随列表一起滚走） */
.filter-bar {
  display: flex;
  gap: 32rpx;
  overflow-x: auto;
  white-space: nowrap;
}

/* ---------- 底部固定操作条 ---------- */

.footer-action {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 18rpx var(--space-content-x) calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, .96);
}

/* ---------- 登录 ---------- */

.login-page { padding-top: 96rpx; }
.login-footer { margin-top: 48rpx; text-align: center; color: var(--ink-3); font-size: 24rpx; }
