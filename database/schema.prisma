generator client {
  provider     = "prisma-client"
  output       = "../packages/backend/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum UserScopeType {
  COMPANY
  STORE
  SUPPLIER
}

enum ExportJobStatus {
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum StoreStatus {
  ACTIVE
  DISABLED
}

enum SupplierStatus {
  ACTIVE
  DISABLED
}

enum DeliveryMode {
  SELF
  LOGISTICS
}

enum SettlementMode {
  STORED_VALUE
  CREDIT
  SUPPLIER_TERM
  COMPANY_TERM
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum PaymentRecordDirection {
  STORE_TO_COMPANY
  COMPANY_TO_SUPPLIER
  STORE_TO_SUPPLIER
}

enum PaymentRecordStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}

enum PaymentAllocationState {
  RESERVED
  CONFIRMED
  RELEASED
}

enum DifferenceDisposalMethod {
  OFFSET
  OFFLINE_RETURN
}

enum DifferenceDisposalStatus {
  PENDING
  CONFIRMED
}

enum DifferenceDisposalDirection {
  SUPPLIER_TO_COMPANY
  COMPANY_TO_STORE
}

enum FulfillmentStatus {
  PENDING
  PARTIAL_SHIPPED
  SHIPPED
  RECEIVED
  COMPLETED
  CANCELED
}

enum PurchaseRequestStatus {
  PENDING_FUNDS
  PENDING_PROCUREMENT
  CONFIRMED
  PARTIAL_PUSHED
  COMPLETED
  CANCELED
}

enum SupplierOrderStatus {
  DRAFT
  PUSHED
  ACCEPTED
  REJECTED
  PARTIAL_SHIPPED
  SHIPPED
  COMPLETED
  CANCELED
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum LedgerSourceType {
  PURCHASE_REQUEST
  RECHARGE
  CLEARING
  ADJUSTMENT
}

enum FundingAllocationMethod {
  STORED_VALUE
  CREDIT
}

enum ShipmentKind {
  INITIAL
  REPLENISHMENT
}

enum DiscrepancyStatus {
  OPEN
  REPLENISH_PENDING
  RESOLVED
  SUPERSEDED
}

enum DiscrepancyActionType {
  REPLENISH
  RETURN
  ACCEPT
}

enum FreightConfirmationStatus {
  PENDING
  CONFIRMED
  REJECTED
  USED
}

enum ReplenishmentGapStatus {
  PENDING
  PARTIAL_FILLED
  FILLED
  CANCELED
}

enum CommandStatus {
  PROCESSING
  SUCCEEDED
  FAILED
}

enum PriceChangeRunStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum PriceChangeRunOrderStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model User {
  id           String          @id @default(uuid()) @db.Uuid
  phone        String?         @unique @db.VarChar(32)
  username     String          @unique @db.VarChar(80)
  displayName  String          @db.VarChar(120)
  passwordHash String?         @db.VarChar(200)
  status       UserStatus      @default(ACTIVE)
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(6)
  roles        UserRole[]
  commands     CommandRecord[]
  sessions     UserSession[]
  scopes       UserScope[]
  exportJobs   ExportJob[]
  files        FileObject[]
}

model UserScope {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @unique @db.Uuid
  scopeType  UserScopeType
  storeId    String?        @db.Uuid
  supplierId String?        @db.Uuid
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  store      Store?         @relation(fields: [storeId], references: [id])
  supplier   Supplier?      @relation(fields: [supplierId], references: [id])
  @@index([storeId])
  @@index([supplierId])
}

model ExportJob {
  id              String          @id @default(uuid()) @db.Uuid
  requestedById   String          @db.Uuid
  reportType      String          @db.VarChar(40)
  filters         Json
  permissionScope Json
  asOf            DateTime        @db.Timestamptz(6)
  status          ExportJobStatus @default(QUEUED)
  csvContent      String?         @db.Text
  errorMessage    String?         @db.VarChar(500)
  expiresAt       DateTime        @db.Timestamptz(6)
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)
  requestedBy     User            @relation(fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([requestedById, createdAt])
  @@index([status, expiresAt])
}

model UserSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.Char(64)
  client     String    @db.VarChar(40)
  expiresAt  DateTime  @db.Timestamptz(6)
  revokedAt  DateTime? @db.Timestamptz(6)
  lastSeenAt DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model CommandRecord {
  id             String        @id @default(uuid()) @db.Uuid
  actorUserId    String        @db.Uuid
  action         String        @db.VarChar(120)
  idempotencyKey String        @db.VarChar(128)
  requestHash    String        @db.Char(64)
  status         CommandStatus @default(PROCESSING)
  resourceType   String?       @db.VarChar(80)
  resourceId     String?       @db.Uuid
  responseBody   Json?
  errorBody      Json?
  traceId        String        @db.VarChar(80)
  startedAt      DateTime      @default(now()) @db.Timestamptz(6)
  finishedAt     DateTime?     @db.Timestamptz(6)
  expiresAt      DateTime      @db.Timestamptz(6)
  actor          User          @relation(fields: [actorUserId], references: [id])

  @@unique([actorUserId, action, idempotencyKey])
  @@index([actorUserId, startedAt])
  @@index([status, expiresAt])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(80)
  name        String           @db.VarChar(120)
  description String?          @db.VarChar(300)
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(6)
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id        String           @id @default(uuid()) @db.Uuid
  code      String           @unique @db.VarChar(120)
  name      String           @db.VarChar(120)
  createdAt DateTime         @default(now()) @db.Timestamptz(6)
  roles     RolePermission[]
}

model UserRole {
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Store {
  id                String                 @id @default(uuid()) @db.Uuid
  code              String                 @unique @db.VarChar(80)
  name              String                 @db.VarChar(200)
  contactName       String?                @db.VarChar(120)
  contactPhone      String?                @db.VarChar(32)
  address           String?                @db.VarChar(300)
  status            StoreStatus            @default(ACTIVE)
  createdAt         DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime               @updatedAt @db.Timestamptz(6)
  bindings          StoreTemplateBinding[]
  accounts          StoreAccount[]
  requests          PurchaseRequest[]
  supplierOrders    SupplierOrder[]
  rechargeDocuments RechargeDocument[]
  clearingDocuments ClearingDocument[]
  userScopes        UserScope[]
  overpayments      Overpayment[]
}

model Supplier {
  id                       String                    @id @default(uuid()) @db.Uuid
  code                     String                    @unique @db.VarChar(80)
  name                     String                    @db.VarChar(200)
  contactName              String?                   @db.VarChar(120)
  contactPhone             String?                   @db.VarChar(32)
  deliveryMode             DeliveryMode
  defaultSettlementMode    SettlementMode
  defaultSettlementCycle   String                    @db.VarChar(40)
  status                   SupplierStatus            @default(ACTIVE)
  createdAt                DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime                  @updatedAt @db.Timestamptz(6)
  products                 SupplierProduct[]
  templateSuppliers        TemplateItemSupplier[]
  templateSupplierSettings TemplateSupplierSetting[]
  priceScopes              PriceScope[]
  requestItems             RequestItem[]
  supplierOrders           SupplierOrder[]
  userScopes               UserScope[]
  overpayments             Overpayment[]
}

model Category {
  id        String     @id @default(uuid()) @db.Uuid
  parentId  String?    @db.Uuid
  code      String     @unique @db.VarChar(80)
  name      String     @db.VarChar(160)
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now()) @db.Timestamptz(6)
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]
}

model Unit {
  id        String    @id @default(uuid()) @db.Uuid
  code      String    @unique @db.VarChar(40)
  name      String    @db.VarChar(80)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  products  Product[]
}

model Product {
  id            String                 @id @default(uuid()) @db.Uuid
  sku           String                 @unique @db.VarChar(100)
  name          String                 @db.VarChar(240)
  categoryId    String                 @db.Uuid
  baseUnitId    String                 @db.Uuid
  minOrderQty   Decimal                @default(1) @db.Decimal(20, 6)
  orderMultiple Decimal                @default(1) @db.Decimal(20, 6)
  isActive      Boolean                @default(true)
  createdAt     DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime               @updatedAt @db.Timestamptz(6)
  category      Category               @relation(fields: [categoryId], references: [id])
  baseUnit      Unit                   @relation(fields: [baseUnitId], references: [id])
  conversion    ProductUnitConversion?
  suppliers     SupplierProduct[]
  templateItems TemplateItem[]
  requestItems  RequestItem[]
  orderItems    OrderItem[]
}

model ProductUnitConversion {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @unique @db.Uuid
  fromUnitId String   @db.Uuid
  toUnitId   String   @db.Uuid
  ratio      Decimal  @db.Decimal(20, 8)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model SupplierProduct {
  id            String   @id @default(uuid()) @db.Uuid
  supplierId    String   @db.Uuid
  productId     String   @db.Uuid
  supplierSku   String?  @db.VarChar(100)
  supplyEnabled Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)
  supplier      Supplier @relation(fields: [supplierId], references: [id])
  product       Product  @relation(fields: [productId], references: [id])

  @@unique([supplierId, productId])
  @@index([productId])
}

model OrderTemplate {
  id         String                    @id @default(uuid()) @db.Uuid
  code       String                    @unique @db.VarChar(80)
  name       String                    @db.VarChar(200)
  isArchived Boolean                   @default(false)
  createdAt  DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime                  @updatedAt @db.Timestamptz(6)
  bindings   StoreTemplateBinding[]
  items      TemplateItem[]
  settings   TemplateSupplierSetting[]
}

model StoreTemplateBinding {
  id          String        @id @default(uuid()) @db.Uuid
  storeId     String        @db.Uuid
  templateId  String        @db.Uuid
  effectiveAt DateTime      @default(now()) @db.Timestamptz(6)
  expiredAt   DateTime?     @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  store       Store         @relation(fields: [storeId], references: [id])
  template    OrderTemplate @relation(fields: [templateId], references: [id])

  @@index([storeId, expiredAt])
}

model TemplateItem {
  id         String                 @id @default(uuid()) @db.Uuid
  templateId String                 @db.Uuid
  productId  String                 @db.Uuid
  sortOrder  Int                    @default(0)
  isEnabled  Boolean                @default(true)
  createdAt  DateTime               @default(now()) @db.Timestamptz(6)
  template   OrderTemplate          @relation(fields: [templateId], references: [id], onDelete: Cascade)
  product    Product                @relation(fields: [productId], references: [id])
  suppliers  TemplateItemSupplier[]

  @@unique([templateId, productId])
}

model TemplateItemSupplier {
  id             String       @id @default(uuid()) @db.Uuid
  templateItemId String       @db.Uuid
  supplierId     String       @db.Uuid
  priority       Int          @default(100)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  templateItem   TemplateItem @relation(fields: [templateItemId], references: [id], onDelete: Cascade)
  supplier       Supplier     @relation(fields: [supplierId], references: [id])

  @@unique([templateItemId, supplierId])
}

model TemplateSupplierSetting {
  id              String         @id @default(uuid()) @db.Uuid
  templateId      String         @db.Uuid
  supplierId      String         @db.Uuid
  settlementMode  SettlementMode
  settlementCycle String         @db.VarChar(40)
  createdAt       DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(6)
  template        OrderTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  supplier        Supplier       @relation(fields: [supplierId], references: [id])

  @@unique([templateId, supplierId])
}

model PriceScope {
  id         String         @id @default(uuid()) @db.Uuid
  productId  String         @db.Uuid
  supplierId String         @db.Uuid
  createdAt  DateTime       @default(now()) @db.Timestamptz(6)
  supplier   Supplier       @relation(fields: [supplierId], references: [id])
  versions   PriceVersion[]

  @@unique([productId, supplierId])
}

model PriceVersion {
  id          String     @id @default(uuid()) @db.Uuid
  scopeId     String     @db.Uuid
  salesPrice  Decimal    @db.Decimal(20, 6)
  supplyPrice Decimal    @db.Decimal(20, 6)
  effectiveAt DateTime   @db.Timestamptz(6)
  reason      String     @default("") @db.VarChar(500)
  revision    Int        @default(1)
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  scope       PriceScope @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  runVersions PriceChangeRunVersion[]

  @@unique([scopeId, revision])
  @@index([scopeId, effectiveAt])
}

model PriceChangeRun {
  id                 String               @id @default(uuid()) @db.Uuid
  status             PriceChangeRunStatus @default(PENDING)
  affectedOrderCount Int                  @default(0)
  salesDelta         Decimal              @default(0) @db.Decimal(20, 2)
  supplyDelta        Decimal              @default(0) @db.Decimal(20, 2)
  createdAt          DateTime             @default(now()) @db.Timestamptz(6)
  versions           PriceChangeRunVersion[]
  orders             PriceChangeRunOrder[]
}

model PriceChangeRunVersion {
  runId         String          @db.Uuid
  priceVersionId String         @db.Uuid
  run           PriceChangeRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  priceVersion  PriceVersion   @relation(fields: [priceVersionId], references: [id], onDelete: Cascade)

  @@id([runId, priceVersionId])
  @@index([priceVersionId])
}

model PriceChangeRunOrder {
  runId           String                    @db.Uuid
  supplierOrderId String                    @db.Uuid
  status          PriceChangeRunOrderStatus @default(PENDING)
  salesDelta      Decimal                   @db.Decimal(20, 2)
  supplyDelta     Decimal                   @db.Decimal(20, 2)
  adjustment      PriceChangeAdjustment?
  run             PriceChangeRun            @relation(fields: [runId], references: [id], onDelete: Cascade)
  supplierOrder   SupplierOrder              @relation(fields: [supplierOrderId], references: [id], onDelete: Cascade)

  @@id([runId, supplierOrderId])
  @@index([supplierOrderId])
}

model PriceChangeAdjustment {
  id                String            @id @default(uuid()) @db.Uuid
  runId             String            @db.Uuid
  supplierOrderId   String            @db.Uuid
  orderItemId       String            @db.Uuid
  previousSalesPrice Decimal          @db.Decimal(20, 6)
  newSalesPrice     Decimal           @db.Decimal(20, 6)
  previousSupplyPrice Decimal          @db.Decimal(20, 6)
  newSupplyPrice    Decimal           @db.Decimal(20, 6)
  salesDelta        Decimal           @db.Decimal(20, 2)
  supplyDelta       Decimal           @db.Decimal(20, 2)
  createdAt         DateTime          @default(now()) @db.Timestamptz(6)
  run               PriceChangeRunOrder @relation(fields: [runId, supplierOrderId], references: [runId, supplierOrderId], onDelete: Cascade)
  orderItem         OrderItem         @relation(fields: [orderItemId], references: [id])

  @@unique([runId, orderItemId])
  @@unique([runId, supplierOrderId])
  @@index([supplierOrderId])
}

model AdjustmentDocument {
  id                 String                    @id @default(uuid()) @db.Uuid
  sourcePriceChangeId String                   @db.Uuid
  supplierOrderId    String                   @db.Uuid
  storeId            String                   @db.Uuid
  supplierId         String                   @db.Uuid
  side               String                   @db.VarChar(20)
  amount             Decimal                  @db.Decimal(20, 2)
  originalPeriodKey  String                   @db.VarChar(128)
  settlementPeriodKey String                 @db.VarChar(128)
  sourceRevision     Int
  createdAt          DateTime                 @default(now()) @db.Timestamptz(6)
  items              AdjustmentDocumentItem[]
  disposalItems      DifferenceDisposalItem[]

  @@unique([sourcePriceChangeId, side])
  @@index([storeId, supplierId, settlementPeriodKey])
}

model AdjustmentDocumentItem {
  id             String             @id @default(uuid()) @db.Uuid
  adjustmentId  String             @db.Uuid
  orderItemId    String             @db.Uuid
  amount         Decimal            @db.Decimal(20, 2)
  createdAt      DateTime           @default(now()) @db.Timestamptz(6)
  adjustment     AdjustmentDocument @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  @@unique([adjustmentId, orderItemId])
  @@index([orderItemId])
}

model PurchaseRequest {
  id                String                @id @default(uuid()) @db.Uuid
  requestNo         String                @unique @db.VarChar(80)
  storeId           String                @db.Uuid
  templateId        String                @db.Uuid
  status            PurchaseRequestStatus @default(PENDING_PROCUREMENT)
  paymentStatus     PaymentStatus         @default(UNPAID)
  submittedAt       DateTime              @default(now()) @db.Timestamptz(6)
  confirmedAt       DateTime?             @db.Timestamptz(6)
  rejectedAt        DateTime?             @db.Timestamptz(6)
  rejectedReason    String?               @db.VarChar(300)
  salesGoodsAmount  Decimal               @default(0) @db.Decimal(20, 2)
  supplyGoodsAmount Decimal               @default(0) @db.Decimal(20, 2)
  paidAmount        Decimal               @default(0) @db.Decimal(20, 2)
  shortfallAmount   Decimal               @default(0) @db.Decimal(20, 2)
  version           Int                   @default(1)
  createdAt         DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime              @updatedAt @db.Timestamptz(6)
  store             Store                 @relation(fields: [storeId], references: [id])
  items             RequestItem[]
  supplierOrders    SupplierOrder[]

  @@index([storeId, submittedAt])
  @@index([status])
}

model RequestItem {
  id               String          @id @default(uuid()) @db.Uuid
  requestId        String          @db.Uuid
  productId        String          @db.Uuid
  supplierId       String          @db.Uuid
  priceVersionId   String?         @db.Uuid
  quantity         Decimal         @db.Decimal(20, 6)
  salesUnitPrice   Decimal         @db.Decimal(20, 6)
  supplyUnitPrice  Decimal         @db.Decimal(20, 6)
  salesLineAmount  Decimal         @db.Decimal(20, 2)
  supplyLineAmount Decimal         @db.Decimal(20, 2)
  createdAt        DateTime        @default(now()) @db.Timestamptz(6)
  request          PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id])
  supplier         Supplier        @relation(fields: [supplierId], references: [id])

  @@index([requestId])
  @@index([productId])
  @@index([supplierId])
}

model SupplierOrder {
  id                   String                @id @default(uuid()) @db.Uuid
  supplierOrderNo      String                @unique @db.VarChar(80)
  requestId            String                @db.Uuid
  storeId              String                @db.Uuid
  supplierId           String                @db.Uuid
  settlementMode       SettlementMode       @default(COMPANY_TERM)
  settlementCycleSnapshot String             @default("MONTHLY") @db.VarChar(40)
  status               SupplierOrderStatus   @default(DRAFT)
  fulfillmentStatus    FulfillmentStatus     @default(PENDING)
  completedAt          DateTime?             @db.Timestamptz(6)
  firstShippedAt       DateTime?             @db.Timestamptz(6)
  pushedAt             DateTime?             @db.Timestamptz(6)
  rejectedAt           DateTime?             @db.Timestamptz(6)
  rejectedReason       String?               @db.VarChar(300)
  salesGoodsAmount     Decimal               @default(0) @db.Decimal(20, 2)
  supplyGoodsAmount    Decimal               @default(0) @db.Decimal(20, 2)
  version              Int                   @default(1)
  createdAt            DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(6)
  request              PurchaseRequest       @relation(fields: [requestId], references: [id])
  store                Store                 @relation(fields: [storeId], references: [id])
  supplier             Supplier              @relation(fields: [supplierId], references: [id])
  items                OrderItem[]
  shipments            Shipment[]
  freightConfirmations FreightConfirmation[]
  fundingAllocations   FundingAllocation[]
  paymentAllocations   PaymentAllocation[]
  settlementItemSnapshots SettlementItemSnapshot[]
  priceChangeRuns      PriceChangeRunOrder[]

  @@index([requestId])
  @@index([supplierId, firstShippedAt])
}

model SettlementItemSnapshot {
  id               String       @id @default(uuid()) @db.Uuid
  settlementItemId String       @unique @db.VarChar(300)
  supplierOrderId  String       @db.Uuid
  kind             String       @db.VarChar(40)
  goodsAmount      Decimal      @db.Decimal(20, 2)
  freightAmount    Decimal      @db.Decimal(20, 2)
  totalAmount      Decimal      @db.Decimal(20, 2)
  sourceVersion    Int
  createdAt        DateTime     @default(now()) @db.Timestamptz(6)
  supplierOrder    SupplierOrder @relation(fields: [supplierOrderId], references: [id], onDelete: Cascade)

  @@index([supplierOrderId])
}

model OrderItem {
  id                 String              @id @default(uuid()) @db.Uuid
  supplierOrderId    String              @db.Uuid
  productId          String              @db.Uuid
  quantity           Decimal             @db.Decimal(20, 6)
  shippedQuantity    Decimal             @default(0) @db.Decimal(20, 6)
  receivedQuantity   Decimal             @default(0) @db.Decimal(20, 6)
  salesUnitPrice     Decimal             @db.Decimal(20, 6)
  supplyUnitPrice    Decimal             @db.Decimal(20, 6)
  salesLineAmount    Decimal             @db.Decimal(20, 2)
  supplyLineAmount   Decimal             @db.Decimal(20, 2)
  createdAt          DateTime            @default(now()) @db.Timestamptz(6)
  supplierOrder      SupplierOrder       @relation(fields: [supplierOrderId], references: [id], onDelete: Cascade)
  product            Product             @relation(fields: [productId], references: [id])
  shipmentItems      ShipmentItem[]
  discrepancies      Discrepancy[]
  replenishmentGaps  ReplenishmentGap[]
  discrepancyReturns DiscrepancyReturn[]
  priceChangeAdjustments PriceChangeAdjustment[]

  @@unique([supplierOrderId, productId])
}

model Shipment {
  id                    String               @id @default(uuid()) @db.Uuid
  shipmentNo            String               @unique @db.VarChar(80)
  supplierOrderId       String               @db.Uuid
  sequence              Int
  kind                  ShipmentKind
  shippedAt             DateTime             @default(now()) @db.Timestamptz(6)
  trackingNo            String?              @db.VarChar(100)
  freight               Decimal              @default(0) @db.Decimal(20, 2)
  freightConfirmationId String?              @unique @db.Uuid
  createdAt             DateTime             @default(now()) @db.Timestamptz(6)
  supplierOrder         SupplierOrder        @relation(fields: [supplierOrderId], references: [id])
  freightConfirmation   FreightConfirmation? @relation(fields: [freightConfirmationId], references: [id])
  items                 ShipmentItem[]
  receipts              Receipt[]

  @@unique([supplierOrderId, sequence])
  @@index([supplierOrderId, shippedAt])
}

model ShipmentItem {
  id                  String                  @id @default(uuid()) @db.Uuid
  shipmentId          String                  @db.Uuid
  orderItemId         String                  @db.Uuid
  quantity            Decimal                 @db.Decimal(20, 6)
  permanentlyReduced  Decimal                 @default(0) @db.Decimal(20, 6)
  salesPriceSnapshot  Decimal                 @db.Decimal(20, 6)
  supplyPriceSnapshot Decimal                 @db.Decimal(20, 6)
  salesLineAmount     Decimal                 @db.Decimal(20, 2)
  supplyLineAmount    Decimal                 @db.Decimal(20, 2)
  createdAt           DateTime                @default(now()) @db.Timestamptz(6)
  shipment            Shipment                @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItem           OrderItem               @relation(fields: [orderItemId], references: [id])
  receiptItems        ReceiptItem[]
  gapAllocations      ShipmentGapAllocation[]

  @@unique([shipmentId, orderItemId])
  @@index([orderItemId])
}

model ShipmentGapAllocation {
  id             String           @id @default(uuid()) @db.Uuid
  shipmentItemId String           @db.Uuid
  gapId          String           @db.Uuid
  quantity       Decimal          @db.Decimal(20, 6)
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  shipmentItem   ShipmentItem     @relation(fields: [shipmentItemId], references: [id], onDelete: Cascade)
  gap            ReplenishmentGap @relation(fields: [gapId], references: [id])

  @@unique([shipmentItemId, gapId])
  @@index([gapId])
}

model Receipt {
  id          String        @id @default(uuid()) @db.Uuid
  receiptNo   String        @unique @db.VarChar(80)
  shipmentId  String        @db.Uuid
  revision    Int
  isCurrent   Boolean       @default(true)
  submittedAt DateTime      @default(now()) @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  shipment    Shipment      @relation(fields: [shipmentId], references: [id])
  items       ReceiptItem[]

  @@unique([shipmentId, revision])
  @@index([shipmentId, isCurrent])
}

model ReceiptItem {
  id               String       @id @default(uuid()) @db.Uuid
  receiptId        String       @db.Uuid
  shipmentItemId   String       @db.Uuid
  receivedQuantity Decimal      @db.Decimal(20, 6)
  createdAt        DateTime     @default(now()) @db.Timestamptz(6)
  receipt          Receipt      @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  shipmentItem     ShipmentItem @relation(fields: [shipmentItemId], references: [id])
  discrepancy      Discrepancy?

  @@unique([receiptId, shipmentItemId])
  @@index([shipmentItemId])
}

model Discrepancy {
  id               String              @id @default(uuid()) @db.Uuid
  receiptItemId    String              @unique @db.Uuid
  orderItemId      String              @db.Uuid
  missingQuantity  Decimal             @db.Decimal(20, 6)
  status           DiscrepancyStatus   @default(OPEN)
  version          Int                 @default(1)
  resolvedAt       DateTime?           @db.Timestamptz(6)
  createdAt        DateTime            @default(now()) @db.Timestamptz(6)
  receiptItem      ReceiptItem         @relation(fields: [receiptItemId], references: [id])
  orderItem        OrderItem           @relation(fields: [orderItemId], references: [id])
  actions          DiscrepancyAction[]
  replenishmentGap ReplenishmentGap?
  returnRecord     DiscrepancyReturn?

  @@index([orderItemId])
  @@index([status])
}

model DiscrepancyAction {
  id            String                @id @default(uuid()) @db.Uuid
  discrepancyId String                @db.Uuid
  action        DiscrepancyActionType
  reason        String?               @db.VarChar(300)
  createdAt     DateTime              @default(now()) @db.Timestamptz(6)
  discrepancy   Discrepancy           @relation(fields: [discrepancyId], references: [id], onDelete: Cascade)

  @@index([discrepancyId, createdAt])
}

model DiscrepancyReturn {
  id                      String                   @id @default(uuid()) @db.Uuid
  discrepancyId           String                   @unique @db.Uuid
  orderItemId             String                   @db.Uuid
  quantity                Decimal                  @db.Decimal(20, 6)
  reason                  String?                  @db.VarChar(300)
  createdAt               DateTime                 @default(now()) @db.Timestamptz(6)
  discrepancy             Discrepancy              @relation(fields: [discrepancyId], references: [id], onDelete: Cascade)
  orderItem               OrderItem                @relation(fields: [orderItemId], references: [id])
  differenceDisposalItems DifferenceDisposalItem[]

  @@index([orderItemId, createdAt])
}

model ReplenishmentGap {
  id                  String                  @id @default(uuid()) @db.Uuid
  discrepancyId       String                  @unique @db.Uuid
  orderItemId         String                  @db.Uuid
  quantity            Decimal                 @db.Decimal(20, 6)
  remainingQuantity   Decimal                 @db.Decimal(20, 6)
  status              ReplenishmentGapStatus  @default(PENDING)
  version             Int                     @default(1)
  createdAt           DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime                @updatedAt @db.Timestamptz(6)
  discrepancy         Discrepancy             @relation(fields: [discrepancyId], references: [id], onDelete: Cascade)
  orderItem           OrderItem               @relation(fields: [orderItemId], references: [id])
  shipmentAllocations ShipmentGapAllocation[]

  @@index([orderItemId, status])
  @@index([status])
}

model FreightConfirmation {
  id              String                    @id @default(uuid()) @db.Uuid
  supplierOrderId String                    @db.Uuid
  amount          Decimal                   @db.Decimal(20, 2)
  reason          String                    @db.VarChar(300)
  status          FreightConfirmationStatus @default(PENDING)
  version         Int                       @default(1)
  confirmedAt     DateTime?                 @db.Timestamptz(6)
  rejectedAt      DateTime?                 @db.Timestamptz(6)
  usedAt          DateTime?                 @db.Timestamptz(6)
  createdAt       DateTime                  @default(now()) @db.Timestamptz(6)
  supplierOrder   SupplierOrder             @relation(fields: [supplierOrderId], references: [id])
  shipment        Shipment?

  @@index([supplierOrderId, status])
}

model StoreAccount {
  id                 String              @id @default(uuid()) @db.Uuid
  storeId            String              @db.Uuid
  balance            Decimal             @default(0) @db.Decimal(20, 2)
  creditLimit        Decimal             @default(0) @db.Decimal(20, 2)
  creditUsed         Decimal             @default(0) @db.Decimal(20, 2)
  version            Int                 @default(1)
  createdAt          DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(6)
  store              Store               @relation(fields: [storeId], references: [id])
  ledgers            AccountLedger[]
  fundingAllocations FundingAllocation[]

  @@unique([storeId])
}

model FundingAllocation {
  id                String                  @id @default(uuid()) @db.Uuid
  storeId           String                  @db.Uuid
  supplierOrderId   String?                 @db.Uuid
  method            FundingAllocationMethod
  targetAmount      Decimal                 @db.Decimal(20, 2)
  netPaid           Decimal                 @default(0) @db.Decimal(20, 2)
  creditOutstanding Decimal                 @default(0) @db.Decimal(20, 2)
  active            Boolean                 @default(true)
  version           Int                     @default(1)
  createdAt         DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                @updatedAt @db.Timestamptz(6)
  store             StoreAccount            @relation(fields: [storeId], references: [storeId])
  supplierOrder     SupplierOrder?          @relation(fields: [supplierOrderId], references: [id])
  clearingItems     ClearingItem[]

  @@index([storeId, active])
  @@index([supplierOrderId])
}

model RechargeDocument {
  id                  String   @id @default(uuid()) @db.Uuid
  rechargeNo          String   @unique @db.VarChar(80)
  storeId             String   @db.Uuid
  amount              Decimal  @db.Decimal(20, 2)
  businessDate        DateTime @db.Date
  collectionAccountId String   @db.VarChar(80)
  remark              String?  @db.VarChar(300)
  createdAt           DateTime @default(now()) @db.Timestamptz(6)
  store               Store    @relation(fields: [storeId], references: [id])

  @@index([storeId, businessDate])
}

model ClearingDocument {
  id           String         @id @default(uuid()) @db.Uuid
  clearingNo   String         @unique @db.VarChar(80)
  storeId      String         @db.Uuid
  amount       Decimal        @db.Decimal(20, 2)
  businessDate DateTime       @db.Date
  remark       String?        @db.VarChar(300)
  createdAt    DateTime       @default(now()) @db.Timestamptz(6)
  store        Store          @relation(fields: [storeId], references: [id])
  items        ClearingItem[]

  @@index([storeId, businessDate])
}

model ClearingItem {
  id                  String            @id @default(uuid()) @db.Uuid
  clearingId          String            @db.Uuid
  fundingAllocationId String            @db.Uuid
  amount              Decimal           @db.Decimal(20, 2)
  sourceVersion       Int
  createdAt           DateTime          @default(now()) @db.Timestamptz(6)
  clearing            ClearingDocument  @relation(fields: [clearingId], references: [id], onDelete: Cascade)
  fundingAllocation   FundingAllocation @relation(fields: [fundingAllocationId], references: [id])

  @@index([clearingId])
  @@index([fundingAllocationId])
}

model PaymentRecord {
  id              String                 @id @default(uuid()) @db.Uuid
  paymentNo       String                 @unique @db.VarChar(80)
  direction       PaymentRecordDirection
  storeId         String?                @db.Uuid
  supplierId      String?                @db.Uuid
  amount          Decimal                @db.Decimal(20, 2)
  businessDate    DateTime               @db.Date
  status          PaymentRecordStatus    @default(PENDING)
  remark          String?                @db.VarChar(300)
  rejectedReason  String?                @db.VarChar(300)
  cancelledReason String?                @db.VarChar(300)
  version         Int                    @default(1)
  confirmedAt     DateTime?              @db.Timestamptz(6)
  rejectedAt      DateTime?              @db.Timestamptz(6)
  cancelledAt     DateTime?              @db.Timestamptz(6)
  createdAt       DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime               @updatedAt @db.Timestamptz(6)
  allocations     PaymentAllocation[]
  overpayments    Overpayment[]
  evidenceFiles   FileObject[]

  @@index([direction, status, businessDate])
  @@index([storeId, status])
  @@index([supplierId, status])
}

model FileObject {
  id        String         @id @default(uuid()) @db.Uuid
  filename  String         @db.VarChar(255)
  mimeType  String         @db.VarChar(100)
  sizeBytes BigInt
  objectKey String         @unique @db.VarChar(100)
  checksum  String?        @db.VarChar(64)
  uploadTokenHash String   @db.VarChar(64)
  purpose   String         @db.VarChar(40)
  status    String         @default("UPLOADING") @db.VarChar(20)
  ownerId   String         @db.Uuid
  paymentId String?        @db.Uuid
  createdAt DateTime       @default(now()) @db.Timestamptz(6)
  owner     User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  payment   PaymentRecord? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([ownerId, status])
  @@index([paymentId])
}

model Overpayment {
  id             String        @id @default(uuid()) @db.Uuid
  paymentId      String        @db.Uuid
  storeId        String        @db.Uuid
  supplierId     String        @db.Uuid
  amount         Decimal       @db.Decimal(20, 2)
  sourceRevision Int
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  payment        PaymentRecord @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  store          Store         @relation(fields: [storeId], references: [id])
  supplier       Supplier      @relation(fields: [supplierId], references: [id])
  disposalItems  DifferenceDisposalItem[]

  @@unique([paymentId, storeId, supplierId, sourceRevision])
  @@index([storeId, supplierId, createdAt])
}

model PaymentAllocation {
  id               String                 @id @default(uuid()) @db.Uuid
  paymentId        String                 @db.Uuid
  settlementItemId String                 @db.VarChar(300)
  supplierOrderId  String                 @db.Uuid
  amount           Decimal                @db.Decimal(20, 2)
  sourceVersion    Int
  state            PaymentAllocationState @default(RESERVED)
  createdAt        DateTime               @default(now()) @db.Timestamptz(6)
  payment          PaymentRecord          @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  supplierOrder    SupplierOrder          @relation(fields: [supplierOrderId], references: [id])

  @@unique([paymentId, settlementItemId])
  @@index([settlementItemId, state])
  @@index([supplierOrderId])
}

model DifferenceDisposal {
  id           String                      @id @default(uuid()) @db.Uuid
  disposalNo   String                      @unique @db.VarChar(80)
  direction    DifferenceDisposalDirection
  method       DifferenceDisposalMethod
  storeId      String?                     @db.Uuid
  supplierId   String?                     @db.Uuid
  amount       Decimal                     @db.Decimal(20, 2)
  businessDate DateTime                    @db.Date
  status       DifferenceDisposalStatus    @default(PENDING)
  reason       String?                     @db.VarChar(300)
  version      Int                         @default(1)
  confirmedAt  DateTime?                   @db.Timestamptz(6)
  createdAt    DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime                    @updatedAt @db.Timestamptz(6)
  items        DifferenceDisposalItem[]

  @@index([direction, status, businessDate])
  @@index([storeId, status])
  @@index([supplierId, status])
}

model DifferenceDisposalItem {
  id                String             @id @default(uuid()) @db.Uuid
  disposalId        String             @db.Uuid
  creditItemId      String?            @db.Uuid
  overpaymentId     String?            @db.Uuid
  adjustmentDocumentId String?         @db.Uuid
  targetDebitItemId String?            @db.VarChar(300)
  amount            Decimal            @db.Decimal(20, 2)
  sourceVersion     Int
  createdAt         DateTime           @default(now()) @db.Timestamptz(6)
  disposal          DifferenceDisposal @relation(fields: [disposalId], references: [id], onDelete: Cascade)
  discrepancyReturn DiscrepancyReturn? @relation(fields: [creditItemId], references: [id])
  overpayment      Overpayment?        @relation(fields: [overpaymentId], references: [id])
  adjustmentDocument AdjustmentDocument? @relation(fields: [adjustmentDocumentId], references: [id])

  @@unique([creditItemId])
  @@unique([overpaymentId])
  @@unique([adjustmentDocumentId])
  @@index([disposalId])
}

model AccountLedger {
  id           String           @id @default(uuid()) @db.Uuid
  accountId    String           @db.Uuid
  direction    LedgerDirection
  amount       Decimal          @db.Decimal(20, 2)
  balanceAfter Decimal          @db.Decimal(20, 2)
  sourceType   LedgerSourceType
  sourceId     String           @db.Uuid
  note         String?          @db.VarChar(300)
  occurredAt   DateTime         @default(now()) @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)
  account      StoreAccount     @relation(fields: [accountId], references: [id])

  @@unique([sourceType, sourceId, direction])
  @@index([accountId, occurredAt])
}
