/* 门店 / 供应商资料页 */

.profile-page { padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }

/* 资料页页头同样接住原生导航栏。 */
.profile-heading {
  padding: 30rpx 28rpx 28rpx;
  background: var(--brand-deep);
}
.profile-heading-main, .catalog-row-head, .catalog-caption {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.profile-title {
  min-width: 0;
  flex: 1;
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.35;
  overflow-wrap: anywhere;
}
.profile-caption { display: block; margin-top: 12rpx; color: rgba(255, 255, 255, .78); font-size: 24rpx; }
.profile-refresh {
  flex: 0 0 auto;
  margin: 0;
  height: 64rpx;
  font-size: 24rpx;
  font-weight: 600;
  background: transparent;
  color: #fff;
  border-color: rgba(255, 255, 255, .45);
}

.profile-tabs { margin-top: 20rpx; padding: 8rpx 24rpx 4rpx; }

.profile-fields {
  margin: 20rpx 24rpx 0;
  padding: 8rpx 28rpx;
  border-radius: 20rpx;
  background: var(--surface);
}
.profile-field {
  display: grid;
  grid-template-columns: 180rpx minmax(0, 1fr);
  gap: 20rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
  line-height: 1.5;
}
.profile-field:last-child { border-bottom: 0; }
.profile-label { color: var(--ink-3); font-size: 24rpx; }
.profile-value { min-width: 0; color: var(--ink-1); font-size: 27rpx; overflow-wrap: anywhere; }

.catalog-tools { padding: 20rpx 28rpx 0; background: var(--surface); }
.catalog-search {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: var(--sunken);
}
.catalog-search icon { flex-shrink: 0; }
.catalog-search input { min-width: 0; flex: 1; height: 76rpx; padding: 0; border: 0; background: transparent; font-size: 26rpx; }
.catalog-caption { padding: 24rpx 28rpx; color: var(--ink-3); font-size: 23rpx; }
.catalog-list { padding: 0 28rpx; border-radius: 20rpx; background: var(--surface); }
.catalog-row { padding: 26rpx 0; border-bottom: 1rpx solid var(--line-soft); }
.catalog-row:last-child { border-bottom: 0; }
.catalog-name { min-width: 0; flex: 1; color: var(--ink-1); font-size: 28rpx; font-weight: 600; line-height: 1.4; overflow-wrap: anywhere; }
.catalog-row-head .tag { flex-shrink: 0; }
.catalog-row > text { display: block; margin-top: 10rpx; overflow-wrap: anywhere; }
.catalog-row button { margin-top: 18rpx; }
.supply-price { color: var(--brand); font-size: 27rpx; font-weight: 600; }
.loading-state { padding: 56rpx 28rpx; color: var(--ink-3); font-size: 25rpx; text-align: center; }
.profile-page .error-banner { margin: 20rpx 24rpx 0; }
