.workspace-navigation { position: fixed; bottom: 0; left: 0; right: 0; z-index: 100; background: #fff; border-top: 1rpx solid #e3e9e5; padding-bottom: env(safe-area-inset-bottom); }
.workspace-items { display: flex; }
.test-label { padding: 8rpx 20rpx; background: #fff3ce; color: #66531a; font-size: 22rpx; text-align: center; }
.workspace-tab { flex: 1; min-width: 0; height: 104rpx; margin: 0; padding: 0 8rpx; border-radius: 0; background: transparent; color: #7f8b85; font-size: 26rpx; line-height: 104rpx; white-space: nowrap; letter-spacing: 0; }
.workspace-tab::after { border: 0; }
.workspace-tab.is-active { color: #167e5a; font-weight: 600; box-shadow: inset 0 4rpx #167e5a; }
