<template name="confirmationFunds">
  <view class="confirmation-funds">
    <view class="funds-heading"><text>资金核验</text><button class="funds-refresh" size="mini" bindtap="refreshConfirmationFunding" disabled="{{fundingLoading || savingRequest || confirming}}">{{fundingLoading ? '核验中' : '重新核验'}}</button></view>
    <block wx:if="{{fundingView}}">
      <view class="funds-grid funds-table-heading"><text>支付方式</text><text>本单所需</text><text>本单可用</text></view>
      <view class="funds-grid funds-table-row"><text>储值</text><text>¥{{fundingView.stored.required}}</text><text>¥{{fundingView.stored.available}}</text></view>
      <view class="funds-grid funds-table-row"><text>挂账</text><text>¥{{fundingView.credit.required}}</text><text>¥{{fundingView.credit.available}}</text></view>
      <view class="funding-suppliers" wx:if="{{!editingRequest && fundingSupplierRows.length}}">
        <view class="funding-suppliers-title">供应商结算方式</view>
        <view class="funding-supplier-row" wx:for="{{fundingSupplierRows}}" wx:key="supplierId">
          <view><text class="funding-supplier-name">{{item.supplierName}}</text><text class="funding-supplier-meta">{{item.settlementLabel}} · ¥{{item.amount}}</text></view>
        </view>
      </view>
      <view class="funds-gap" wx:if="{{!fundingView.canConfirm}}">
        <view wx:if="{{fundingView.stored.shortfall !== '0.00'}}"><text>待充值金额</text><text>¥{{fundingView.stored.shortfall}}</text></view>
        <view wx:if="{{fundingView.credit.shortfall !== '0.00'}}"><text>待补挂账额度</text><text>¥{{fundingView.credit.shortfall}}</text></view>
        <text class="funds-next-step">可减少对应支付方式的商品金额，或联系财务补足。</text>
      </view>
      <view class="funds-ready" wx:else>资金充足，可确认生成订单</view>
    </block>
    <text class="funds-next-step" wx:else>{{editingRequest ? '商品已调整，请重新核验剩余缺口。' : '尚未核验，请重新核验资金。'}}</text>
  </view>
</template>
<test-context wx:if="{{activeView === 'mine'}}" />
<wxs src="../../utils/labels.wxs" module="labels" />
<view class="page {{workspaceTabbarVisible ? 'has-workspace-tabbar' : ''}}{{user.testWorkbenchEnabled && !user.testIdentity ? 'has-test-workbench-root' : ''}} {{requestId && selectedRequest && (activeView === 'rejections' || selectedRequest.status === 'PENDING_PROCUREMENT' || selectedRequest.status === 'PENDING_FUNDS' || selectedRequest.status === 'PENDING_FINANCE') || activeView === 'freight' && selectedFreight.status === 'PENDING' ? 'has-action-bar' : ''}}">
  <view class="business-heading" wx:if="{{!requestId && !selectedFreight}}"><view><text class="business-title">采购管理</text><text class="muted">{{user.displayName}}</text></view><view class="heading-actions" wx:if="{{!requestId && activeView !== 'reports' && (activeView !== 'orders' || recordType === 'requests')}}"><button class="ghost" bindtap="loadWork" loading="{{loading}}" disabled="{{loading}}">刷新</button></view></view>
  <view class="workspace-loading" wx:if="{{loading}}">正在更新采购信息</view>
  <view wx:if="{{error && !detailError}}" class="error-banner"><text>{{error}}</text><button class="ghost" bindtap="loadWork" disabled="{{loading || confirming || reallocating || freightReviewing}}">刷新数据</button></view>
  <view wx:if="{{pendingCommand}}" class="command-recovery"><view><text class="row-title">{{pendingCommand.title}} · 结果待确认</text><text class="muted">{{pendingCommand.dateText}}</text></view><button class="secondary" bindtap="recoverCommand" disabled="{{recovering || confirming || reallocating || freightReviewing}}" loading="{{recovering}}">确认提交结果</button></view>
  <view class="business-nav"><view class="nav-item {{taskOrigin || activeView === 'tasks' || activeView === 'rejections' || activeView === 'freight' ? 'is-active' : ''}}" data-view="tasks" bindtap="changeView">待办</view><view class="nav-item {{activeView === 'orders' && !taskOrigin ? 'is-active' : ''}}" data-view="orders" bindtap="changeView">订单</view><view class="nav-item {{activeView === 'mine' || activeView === 'reports' ? 'is-active' : ''}}" data-view="mine" bindtap="changeView">我的</view></view>
  <block wx:if="{{activeView === 'tasks'}}">
    <view class="procurement-tabs sticky-bar">
      <view class="procurement-tab {{taskType === 'requests' ? 'selected' : ''}}" data-type="requests" bindtap="changeTaskType"><text class="task-count {{loading || error || !procurementTasks.length ? 'is-empty' : ''}}">{{loading || error ? '—' : procurementTasks.length}}</text><text>下货单确认</text></view>
      <view class="procurement-tab {{taskType === 'rejections' ? 'selected' : ''}}" data-type="rejections" bindtap="changeTaskType"><text class="task-count {{loading || error || !rejectionTodos.length ? 'is-empty' : ''}}">{{loading || error ? '—' : rejectionTodos.length}}</text><text>拒单改派</text></view>
      <view class="procurement-tab {{taskType === 'freight' ? 'selected' : ''}}" data-type="freight" bindtap="changeTaskType"><text class="task-count {{loading || error || !pendingFreight.length ? 'is-empty' : ''}}">{{loading || error ? '—' : pendingFreight.length}}</text><text>运费审核</text></view>
    </view>
    <view class="procurement-list">
      <view class="procurement-list-title">{{taskType === 'requests' ? '待确认下货单' : taskType === 'rejections' ? '待改派订单' : '待审核运费'}}</view>
      <block wx:if="{{taskType === 'requests'}}">
        <view class="procurement-task" wx:for="{{procurementTasks}}" wx:key="id" data-id="{{item.id}}" bindtap="openTaskRequest">
          <view class="procurement-task-top"><text class="procurement-store">{{item.storeName || '门店订货'}}</text><text class="procurement-amount">¥{{labels.money(item.salesGoodsAmount)}}</text></view>
          <view class="procurement-task-meta"><view>下货单号 <document-no value="{{item.requestNo}}" /></view><text>{{item.submittedText}}</text></view>
          <view class="procurement-task-bottom"><text class="procurement-state {{item.status === 'PENDING_FUNDS' ? 'warning' : ''}}">{{item.status === 'PENDING_FUNDS' ? '资金待补足' : '待采购确认'}}</text><text class="procurement-command">查看并处理 ›</text></view>
        </view>
      </block>
      <block wx:if="{{taskType === 'rejections'}}">
        <view class="procurement-task" wx:for="{{rejectionTodos}}" wx:key="id" data-request-id="{{item.purchaseRequestId}}" data-supplier-order-id="{{item.supplierOrderId}}" bindtap="openTaskRejection">
          <view class="procurement-task-top"><text class="procurement-store">{{item.storeName}}</text><text class="procurement-state warning">供应商拒单</text></view>
          <view class="procurement-supplier">{{item.supplierName}}</view><view class="procurement-reason">{{item.reason || '未填写拒单原因'}}</view>
          <view class="procurement-task-meta"><document-no value="{{item.supplierOrderNo}}" /></view>
          <view class="procurement-task-bottom"><text class="procurement-state warning">待重新分配</text><text class="procurement-command">处理改派 ›</text></view>
        </view>
      </block>
      <block wx:if="{{taskType === 'freight'}}">
        <view class="procurement-task" wx:for="{{pendingFreight}}" wx:key="id" data-id="{{item.id}}" bindtap="openTaskFreight">
          <view class="procurement-task-top"><text class="procurement-store">{{item.storeName}}</text><text class="procurement-amount">¥{{labels.money(item.amount)}}</text></view>
          <view class="procurement-supplier">{{item.supplierName}}</view><view class="procurement-reason" wx:if="{{item.reason}}">{{item.reason}}</view>
          <view class="procurement-task-meta"><document-no value="{{item.supplierOrderNo}}" /></view>
          <view class="procurement-task-bottom"><text class="procurement-state">运费待审核</text><text class="procurement-command">审核运费 ›</text></view>
        </view>
      </block>
      <view class="empty-state" wx:if="{{!loading && !error && (taskType === 'requests' && !procurementTasks.length || taskType === 'rejections' && !rejectionTodos.length || taskType === 'freight' && !pendingFreight.length)}}">{{taskType === 'requests' ? '暂无待确认下货单' : taskType === 'rejections' ? '暂无待改派订单' : '暂无待审核运费'}}<button class="empty-action" data-view="orders" bindtap="changeView">查看全部下货单 ›</button></view>
    </view>
  </block>
  <view class="card" wx:if="{{activeView === 'mine'}}"><view class="task-entry" data-view="reports" bindtap="changeView"><text>采购统计</text><text>›</text></view></view>
  <view class="card" wx:if="{{(activeView === 'freight' || activeView === 'rejections' && !requestId) && !selectedFreight}}"><view class="back-link" data-view="tasks" bindtap="changeView">‹ 返回待办</view></view>
  <block wx:if="{{activeView === 'mine'}}"><view class="card"><text class="card-title">{{user.displayName}}</text><text class="muted">采购工作台</text></view><button class="account-logout" bindtap="logout">退出登录</button></block>

  <view class="card" wx:if="{{activeView === 'freight' && !selectedFreight}}">
    <view class="section-head"><text class="card-title">运费记录</text><button class="ghost" bindtap="loadFreight">刷新</button></view>
    <view class="row freight-row pressable" wx:for="{{freightConfirmations}}" wx:key="id" data-id="{{item.id}}" bindtap="selectFreight">
      <view class="row-title"><text>{{item.supplierOrderNo}}</text><text class="status {{item.usedAt ? 'tone-muted' : item.status === 'PENDING' ? 'tone-warn' : 'tone-brand'}}">{{item.usedAt ? '已使用' : labels.status(item.status)}}</text></view>
      <view class="detail-line">¥{{labels.money(item.amount)}}</view><view class="muted">{{item.supplierName}} · {{item.storeName}}</view><view class="muted">{{item.reason}}</view>
    </view>
    <view wx:if="{{!freightConfirmations.length}}" class="muted">暂无运费记录</view>
  </view>
  <view class="card" wx:if="{{activeView === 'freight' && selectedFreight}}">
    <view class="task-detail-toolbar"><text class="back-link" data-view="tasks" bindtap="changeView">‹ 返回待办</text><text>运费审核</text></view>
    <view class="task-detail-identity"><text class="request-store">{{selectedFreight.storeName}}</text><text class="status {{selectedFreight.status === 'PENDING' ? 'tone-warn' : ''}}">{{labels.status(selectedFreight.status)}}</text></view>
    <view class="task-detail-metric"><text>申请运费</text><text>¥{{labels.money(selectedFreight.amount)}}</text></view>
    <view class="task-detail-facts"><view><text>供应商</text><text>{{selectedFreight.supplierName}}</text></view><view><text>订单号</text><document-no value="{{selectedFreight.supplierOrderNo}}" /></view><view wx:if="{{selectedFreight.reason}}"><text>申请说明</text><text>{{selectedFreight.reason}}</text></view></view>
    <view class="task-decision-section" wx:if="{{selectedFreight.status === 'PENDING'}}"><text class="card-title">审核处理</text><view class="field"><text class="field-label">处理说明</text><textarea value="{{freightReason}}" data-field="freightReason" maxlength="300" bindinput="onInput" placeholder="驳回时填写原因" auto-height /></view></view>
    <view class="button-row action-bar" wx:if="{{selectedFreight.status === 'PENDING'}}">
      <button class="primary freight-confirm" disabled="{{freightReviewing}}" loading="{{freightReviewing}}" data-action="confirm" bindtap="reviewFreight">确认运费</button>
      <button class="danger" disabled="{{freightReviewing}}" loading="{{freightReviewing}}" data-action="reject" bindtap="reviewFreight">驳回运费</button>
    </view>
  </view>

  <view class="card" wx:if="{{activeView === 'rejections' && !requestId}}">
    <text class="card-title">拒单通知</text>
    <view class="list">
      <view wx:for="{{rejectionTodos}}" wx:key="id" class="row pressable" bindtap="selectRejection" data-request-id="{{item.purchaseRequestId}}" data-supplier-order-id="{{item.supplierOrderId}}">
        <view class="row-title"><text>{{item.supplierOrderNo}}</text><text class="status tone-warn">待改派</text></view>
        <view class="muted">{{item.storeName}} · {{item.supplierName}}</view><view class="muted"><document-no value="{{item.requestNo}}" /> · {{item.reason || '未填写原因'}}</view>
      </view>
      <view wx:if="{{!rejectionTodos.length}}" class="row"><view class="muted">暂无供应商拒单待处理。</view></view>
    </view>
  </view>

  <view class="card" wx:if="{{(activeView === 'orders' || activeView === 'rejections') && requestId && !editingRequest}}">
    <view class="task-detail-toolbar"><text class="back-link" bindtap="backToList">‹ {{sourceOrderReturn ? '返回订单详情' : taskOrigin ? '返回待办' : '返回列表'}}</text><text>{{activeView === 'rejections' && rejectedOrderId ? '拒单改派' : selectedRequest.supplierOrders.length ? '采购确认结果' : '下货单确认'}}</text></view>
    <block wx:if="{{selectedRequest}}">
    <view class="document-kind-label">门店下货单</view>
    <view class="task-detail-identity"><text class="request-store">{{selectedRequest.storeName || '门店'}}</text><text class="status {{selectedRequest.paymentStatus === 'SHORTFALL' ? 'tone-warn' : selectedRequest.status === 'CONFIRMED' ? 'tone-brand' : ''}}">{{labels.status(selectedRequest.status)}}</text></view>
    <view class="task-detail-metric"><text>订货金额</text><text>¥{{labels.money(selectedRequest.salesGoodsAmount)}}</text></view>
    <view class="task-detail-facts"><view><text>下货单号</text><document-no value="{{selectedRequest.requestNo}}" /></view><view><text>资金状态</text><text>{{labels.status(selectedRequest.paymentStatus)}}</text></view></view>
    <view class="task-rejection-note" wx:if="{{activeView === 'rejections' && rejectedOrderId}}"><text>供应商拒单</text><text>{{rejectionContext.supplierName}}</text><text>{{rejectionContext.reason || '未填写拒单原因'}}</text></view>
    </block>
    <view id="supplier-order-summary" class="supplier-order-summary" wx:if="{{selectedRequest.supplierOrders.length}}">
      <view class="generated-orders-heading">
        <view class="generated-orders-title"><text class="card-title">{{activeView === 'rejections' && rejectedOrderId ? '被拒的供应商订单' : '采购确认后生成的供应商订单'}}</text><text class="generated-orders-caption">下货单按供应商拆分，每张订单单独跟进</text></view>
        <text class="order-count" wx:if="{{!rejectedOrderId}}">{{selectedRequest.supplierOrders.length}} 张</text>
      </view>
      <view class="price-details-control"><text>供应商价格明细</text><switch aria-label="显示供应商价格明细" checked="{{showPriceDetails}}" bindchange="togglePriceDetails" color="#167e5a" /></view>
      <view wx:for="{{selectedRequest.supplierOrders}}" wx:key="id" class="generated-order-card" wx:if="{{activeView !== 'rejections' || !rejectedOrderId || item.id === rejectedOrderId}}">
        <view class="supplier-order-toggle pressable" data-id="{{item.id}}" bindtap="toggleSupplierOrder">
          <view class="generated-order-top"><view class="generated-order-heading"><text class="generated-order-supplier">{{item.supplierName || '供应商'}}</text><text class="status {{item.status === 'REJECTED' ? 'tone-danger' : item.status === 'COMPLETED' ? 'tone-brand' : 'tone-warn'}}">{{labels.status(item.status)}}</text></view><button class="generated-order-follow" data-id="{{item.id}}" catchtap="openGeneratedOrder">跟进订单 ›</button></view>
          <view class="generated-order-no"><text>供应商订单号</text><document-no value="{{item.supplierOrderNo}}" /></view>
          <view class="generated-order-overview"><text>履约 {{labels.status(item.fulfillmentStatus)}}</text><text>{{item.itemsError ? '商品清单待加载' : item.items.length + ' 种商品'}} · ¥{{labels.money(item.salesGoodsAmount)}}</text></view>
          <view class="supplier-order-fold">{{expandedOrders[item.id] ? '收起商品 ∧' : '查看商品明细 ﹀'}}</view>
        </view>
        <view class="generated-order-products" wx:if="{{expandedOrders[item.id]}}">
          <view wx:for="{{item.items}}" wx:for-item="product" wx:key="id" class="generated-order-product-block">
            <product-card product="{{product}}" variant="compact" bind:retryimage="retryProductImage"><view class="generated-order-product"><text>{{product.productName}}</text><text>¥{{labels.money(product.salesLineAmount)}}</text></view>
              <view class="generated-order-product-meta"><text>{{product.quantity}} {{product.unitName || product.unitSnapshot.salesUnitName || ''}}</text><text>销售价格 ¥{{labels.money(product.salesUnitPrice)}} / {{product.unitName || product.unitSnapshot.salesUnitName || ''}}</text></view>
              <view class="generated-order-product-meta" wx:if="{{showPriceDetails}}"><text>供应商价格 ¥{{labels.money(product.supplyUnitPrice)}}</text><text>供应商金额 ¥{{labels.money(product.supplyLineAmount)}}</text></view>
            </product-card>
          </view>
          <view class="error-banner" wx:if="{{item.itemsError}}"><text>{{item.itemsError}}</text><button class="ghost" bindtap="loadRequestDetail" disabled="{{detailing || confirming || reallocating || recovering || pendingCommand}}">重试</button></view>
        </view>
      </view>
      <view class="original-request-toggle" bindtap="toggleOriginalRequest"><text>{{showOriginalRequest ? '收起下货商品明细' : '查看下货商品明细'}}</text><text>{{showOriginalRequest ? '∧' : '›'}}</text></view>
    </view>
    <view class="task-decision-section" wx:if="{{activeView === 'rejections' && canReallocate && rejectedOrderId && selectedRequest}}">
      <text class="card-title">重新分配</text>
      <view class="field"><text class="field-label">目标供应商</text><picker range="{{suppliers}}" range-key="name" value="{{supplierIndex}}" bindchange="selectSupplier" disabled="{{reallocating || detailing || recovering || pendingCommand || detailError}}"><view class="picker-value">{{supplierIndex >= 0 ? suppliers[supplierIndex].name : '选择供应商'}} ▾</view></picker></view>
      <view class="field"><text class="field-label">改派原因</text><textarea value="{{reallocateReason}}" data-field="reallocateReason" bindinput="onInput" maxlength="300" placeholder="填写改派原因" auto-height disabled="{{reallocating}}" /></view>
    </view>
    <view class="muted" wx:if="{{detailing}}">正在更新明细</view>
    <view class="error-banner" wx:if="{{detailError}}"><text>{{detailError}}</text><button class="ghost" bindtap="loadRequestDetail" disabled="{{detailing || confirming || reallocating || recovering || pendingCommand}}">重试</button></view>
    <view class="funding-shortfall" wx:if="{{selectedRequest.financeReturnedReason}}">财务退回：{{selectedRequest.financeReturnedReason}}</view>
    <view class="request-decision-panel" wx:if="{{activeView === 'orders' && rejectingRequest}}">
      <text class="card-title">采购拒单</text>
      <text class="muted">拒单后整张下货单取消，并释放尚未扣除的资金占用。</text>
      <view class="field"><text class="field-label">拒单原因</text><textarea value="{{rejectReason}}" data-field="rejectReason" bindinput="editInput" maxlength="500" placeholder="必填，请说明拒单原因" auto-height disabled="{{confirming}}" /></view>
    </view>
    <template is="confirmationFunds" data="{{fundingView, fundingLoading, savingRequest, confirming, canReallocate, editingRequest, fundingSupplierRows}}" wx:if="{{activeView === 'orders' && !selectedRequest.supplierOrders.length && !editingRequest && (selectedRequest.status === 'PENDING_PROCUREMENT' || selectedRequest.status === 'PENDING_FUNDS' || selectedRequest.status === 'PENDING_FINANCE')}}" />
    <view class="button-row action-bar confirmation-actions" wx:if="{{activeView === 'orders' && (selectedRequest.status === 'PENDING_PROCUREMENT' || selectedRequest.status === 'PENDING_FUNDS' || selectedRequest.status === 'PENDING_FINANCE') && !selectedRequest.supplierOrders.length && !editingRequest && !rejectingRequest}}">
      <button wx:if="{{canReallocate}}" class="secondary action-secondary" disabled="{{confirming || detailing || reallocating || recovering || pendingCommand || detailError}}" bindtap="startRequestEdit">调整商品</button>
      <button class="danger action-secondary" disabled="{{confirming || detailing || reallocating || recovering || pendingCommand || detailError}}" bindtap="startRequestReject">拒单</button>
      <button class="primary" disabled="{{confirming || detailing || reallocating || recovering || pendingCommand || detailError || fundingLoading || !fundingView || !fundingView.canConfirm}}" loading="{{confirming}}" bindtap="confirmRequest">确认并生成订单</button>
    </view>
    <view class="button-row action-bar" wx:if="{{activeView === 'orders' && rejectingRequest}}">
      <button class="secondary action-secondary" disabled="{{confirming}}" bindtap="cancelRequestReject">取消</button>
      <button class="danger" loading="{{confirming}}" disabled="{{confirming || !rejectReason}}" bindtap="rejectRequest">确认拒单</button>
    </view>
    <view class="button-row action-bar" wx:if="{{activeView === 'rejections' && canReallocate && selectedRequest && rejectedOrderId}}">
      <button class="primary" loading="{{reallocating}}" disabled="{{!targetSupplierId || !rejectedOrderId || reallocating || detailing || recovering || pendingCommand || detailError}}" bindtap="reallocateRequest">确认改派</button>
    </view>
  </view>

  <view class="request-catalog" wx:if="{{activeView === 'orders' && requestId && selectedRequest && editingRequest}}">
    <view class="request-catalog-tools">
      <view class="request-edit-title"><text class="card-title">调整下货单</text><text>已选 {{editItems.length}} 种商品</text></view>
      <view class="request-search"><icon type="search" size="18" color="#6e7975" /><input placeholder="搜索商品名称或编码" value="{{editSearch}}" bindinput="onEditSearch" confirm-type="search" /></view>

    </view>
    <view class="request-catalog-browser">
      <scroll-view scroll-y class="request-category-sidebar"><view wx:for="{{editCategories}}" wx:key="id" class="request-category-option {{editPrimaryCategoryId === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="chooseEditPrimaryCategory">{{item.name}}</view></scroll-view>
      <view class="request-catalog-content">
        <scroll-view wx:if="{{editSubcategories.length}}" scroll-x class="request-subcategories"><view><text wx:for="{{editSubcategories}}" wx:key="id" class="{{editCategoryId === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="chooseEditCategory">{{item.name}}</text></view></scroll-view>
        <view class="request-catalog-count"><text>可调整商品</text><text>{{visibleEditProducts.length}} 件</text></view>
        <scroll-view scroll-y class="request-product-scroll">
          <view class="request-product-list">
            <view class="request-product-row" wx:for="{{visibleEditProducts}}" wx:key="id">
              <view class="request-product-media"><view class="cart-badge" wx:if="{{item.cartQuantity !== '0'}}">{{item.cartQuantity}}</view><image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFit" /><view class="request-missing-image" wx:else data-id="{{item.id}}" bindtap="retryEditProductImage"><icon type="info" size="18" color="#87928c" /><text>{{item.imageFailed ? '重试' : item.imageFileId ? '加载中' : '无图'}}</text></view></view>
              <view class="request-product-main">
                <view class="request-product-heading"><text class="request-product-name">{{item.name}}</text><text class="request-product-price">{{item.displaySalesPrice ? '¥' + labels.money(item.displaySalesPrice) : '暂无有效价格'}}<text wx:if="{{item.displaySalesPrice}}">/{{item.displayUnitName}}</text></text></view>
                <text class="request-product-meta" wx:if="{{item.specification}}">{{item.specification}}</text>
                <picker wx:if="{{item.cartQuantity !== '0'}}" range="{{item.suppliers}}" range-key="supplierName" value="{{item.supplierIndex}}" data-id="{{item.id}}" bindchange="changeEditSupplier" disabled="{{savingRequest}}"><view class="request-supplier-select">供应商：{{item.supplierName}} ▾</view></picker>
                <view class="request-price-detail" wx:if="{{item.cartQuantity !== '0'}}"><text>供应商价格 ¥{{labels.money(item.displaySupplyPrice)}} / {{item.displayUnitName}}</text></view>
                <view class="request-product-bottom"><text wx:if="{{item.maxRequestedQuantity}}">最多 {{item.maxRequestedQuantity}} {{item.displayUnitName}}（门店原下单量）</text><text wx:else>起订 {{item.minOrderQty}} · 倍数 {{item.orderMultiple}}</text><view class="quantity-stepper"><button class="step-button" data-id="{{item.id}}" data-direction="-1" bindtap="stepEditProduct" disabled="{{item.cartQuantity === '0' || savingRequest}}">−</button><input class="quantity-input" type="digit" value="{{item.cartQuantity}}" data-id="{{item.id}}" bindblur="setEditProductQuantity" disabled="{{savingRequest}}" /><button class="step-button step-add" data-id="{{item.id}}" data-direction="1" bindtap="stepEditProduct" disabled="{{!item.canOrder || item.atOriginalMaximum || savingRequest}}">+</button></view></view>
              </view>
            </view>
            <view class="empty-state" wx:if="{{!visibleEditProducts.length}}">没有匹配的商品</view>
          </view>
        </scroll-view>
      </view>
    </view>
    <view class="request-edit-summary"><view bindtap="toggleEditCart"><text>已选 {{editItems.length}} 种 ›</text><text>预估 ¥{{labels.money(editEstimatedAmount)}}</text></view></view>
  </view>

  <view wx:if="{{activeView === 'orders' && editingRequest}}" class="section-band"><input value="{{editReason}}" data-field="editReason" bindinput="editInput" maxlength="300" placeholder="调整原因（必填）" /></view>
  <view class="button-row action-bar" wx:if="{{activeView === 'orders' && editingRequest}}">
    <button class="secondary action-secondary" disabled="{{savingRequest}}" bindtap="cancelRequestEdit">取消调整</button>
    <button class="secondary" disabled="{{savingRequest || pendingCommand}}" bindtap="saveRequestDraft">保存调整</button>
    <button class="primary" loading="{{savingRequest}}" disabled="{{savingRequest || !editItems.length}}" bindtap="confirmRequestEdit">确认并生成订单</button>
  </view>

  <view class="sheet-mask" wx:if="{{editingRequest && editCartOpen}}" bindtap="toggleEditCart"><view class="request-cart-sheet" catchtap="keepEditCartOpen"><view class="section-head"><text class="card-title">下货清单 · {{editItems.length}} 种</text><button class="ghost" bindtap="toggleEditCart">关闭</button></view><scroll-view scroll-y><view class="request-cart-line" wx:for="{{editItems}}" wx:key="productId"><view><text>{{item.productName}}</text><text class="muted">{{item.quantity}} {{item.unitName}} · {{item.supplierIndex >= 0 ? item.suppliers[item.supplierIndex].supplierName : '请选择有效供应商'}}</text></view><button class="ghost" data-id="{{item.productId}}" bindtap="removeEditCartItem">移除</button></view></scroll-view><view class="request-cart-total">预估 ¥{{labels.money(editEstimatedAmount)}}</view></view></view>

  <view class="card" wx:if="{{(activeView === 'orders' || activeView === 'rejections') && requestId && selectedRequest && !editingRequest && (!selectedRequest.supplierOrders.length || showOriginalRequest)}}">
    <view class="product-list-toolbar"><text class="card-title">{{selectedRequest.supplierOrders.length ? '原下货单清单' : '待审核商品清单'}}</text><view class="price-details-control"><text>价格明细</text><switch aria-label="显示价格明细" checked="{{showPriceDetails}}" bindchange="togglePriceDetails" color="#167e5a" /></view></view>
    <view class="procurement-summary"><text>{{selectedRequest.items.length}} 种商品</text><text wx:if="{{showPriceDetails}}">供应商金额 ¥{{labels.money(selectedRequest.supplyGoodsAmount)}}</text></view>
    <view class="list">
      <view class="assignment-caption" wx:if="{{assignmentGroups.length}}">供货分组 · {{assignmentGroups.length}} 家供应商</view>
      <view class="assignment-group" wx:for="{{assignmentGroups}}" wx:key="supplierId" wx:for-item="group">
        <view class="assignment-group-heading"><text>{{group.supplierName}}</text><text class="muted">{{group.itemCount}} 种商品</text></view>
        <view class="assignment-settlement" wx:if="{{group.settlementLabel}}"><text>{{group.settlementLabel}}</text><text>销售金额 ¥{{labels.money(group.salesAmount)}}</text></view>
        <view class="assignment-group-totals" wx:if="{{showPriceDetails}}"><text>销售金额 ¥{{labels.money(group.salesAmount)}}</text><text>供应商金额 ¥{{labels.money(group.supplyAmount)}}</text></view>
        <view wx:for="{{group.items}}" wx:key="id" class="row assignment-product">
          <product-card product="{{item}}" bind:retryimage="retryProductImage"><view class="row-title assignment-product-heading"><text>{{item.productName}}</text></view>
          <view class="product-line-summary"><text class="product-quantity">订货 {{item.quantity}} {{item.unitName || item.unitSnapshot.salesUnitName || ''}}</text><text class="product-line-amount">¥{{labels.money(item.salesLineAmount)}}</text></view>
          <view class="assignment-price-grid" wx:if="{{showPriceDetails}}">
            <view><text class="price-label">销售价格</text><text class="price-value">¥{{labels.money(item.salesUnitPrice)}}<text class="price-unit"> / {{item.unitName || item.unitSnapshot.salesUnitName || ''}}</text></text></view>
            <view><text class="price-label">供应商价格</text><text class="price-value">¥{{labels.money(item.supplyUnitPrice)}}<text class="price-unit"> / {{item.unitName || item.unitSnapshot.salesUnitName || ''}}</text></text></view>
            <view><text class="price-label">销售金额</text><text class="price-value amount-value">¥{{labels.money(item.salesLineAmount)}}</text></view>
            <view><text class="price-label">供应商金额</text><text class="price-value amount-value">¥{{labels.money(item.supplyLineAmount)}}</text></view>
          </view>
          </product-card>
        </view>
      </view>
      <view wx:if="{{!assignmentItems.length}}" wx:for="{{selectedRequest.items}}" wx:key="id" class="row procurement-product-row">
        <product-card product="{{item}}" bind:retryimage="retryProductImage"><view class="row-title"><text>{{item.productName || '商品'}}</text></view>
        <view class="product-line-summary"><text class="product-quantity">订货 {{item.quantity}} {{item.unitName || item.unitSnapshot.salesUnitName || ''}}</text><text class="product-line-amount">¥{{labels.money(item.salesLineAmount)}}</text></view>
        <view class="assignment-price-grid" wx:if="{{showPriceDetails}}">
          <view><text class="price-label">销售价格</text><text class="price-value">¥{{labels.money(item.salesUnitPrice)}}<text class="price-unit"> / {{item.unitName || item.unitSnapshot.salesUnitName || ''}}</text></text></view>
          <view><text class="price-label">供应商价格</text><text class="price-value">¥{{labels.money(item.supplyUnitPrice)}}<text class="price-unit"> / {{item.unitName || item.unitSnapshot.salesUnitName || ''}}</text></text></view>
          <view><text class="price-label">销售金额</text><text class="price-value amount-value">¥{{labels.money(item.salesLineAmount)}}</text></view>
          <view><text class="price-label">供应商金额</text><text class="price-value amount-value">¥{{labels.money(item.supplyLineAmount)}}</text></view>
        </view>
        </product-card>
      </view>
    </view>
  </view>

  <view wx:if="{{activeView === 'orders' && !requestId}}" class="document-tabs"><text class="{{recordType === 'orders' ? 'is-active' : ''}}" data-type="orders" bindtap="changeRecordType">订单</text><text class="{{recordType === 'requests' ? 'is-active' : ''}}" data-type="requests" bindtap="changeRecordType">下货记录</text></view>
  <order-center id="formal-orders" active="{{activeView === 'orders' && !requestId && recordType === 'orders'}}" revision="{{orderRevision}}" mode="purchaser" can-reallocate="{{canReallocate}}" bind:source="openOrderSource" bind:reallocate="openOrderReallocation" />
  <view class="card" wx:if="{{activeView === 'orders' && !requestId && recordType === 'requests'}}">
    <view id="order-list-controls" class="order-list-controls sticky-bar">
    <input class="business-search" value="{{search}}" bindinput="onSearch" confirm-type="search" placeholder="搜索门店或下货单号" />
    <scroll-view scroll-x show-scrollbar="{{false}}" class="order-status-scroll">
    <view class="status-filters"><text class="{{statusFilter === 'all' ? 'selected' : ''}}" data-filter="all" bindtap="filterStatus">全部</text><text class="{{statusFilter === 'PENDING_PROCUREMENT' ? 'selected' : ''}}" data-filter="PENDING_PROCUREMENT" bindtap="filterStatus">待确认</text><text class="{{statusFilter === 'PENDING_FUNDS' ? 'selected' : ''}}" data-filter="PENDING_FUNDS" bindtap="filterStatus">待补款</text><text class="{{statusFilter === 'PENDING_FINANCE' ? 'selected' : ''}}" data-filter="PENDING_FINANCE" bindtap="filterStatus">待采购处理</text><text class="{{statusFilter === 'CONFIRMED' ? 'selected' : ''}}" data-filter="CONFIRMED" bindtap="filterStatus">已生成订单</text></view>
    </scroll-view>
    </view>
    <view class="list">
      <view wx:for="{{visibleRequests}}" wx:key="id" class="row pressable" bindtap="selectRequest" data-id="{{item.id}}">
        <view class="row-title"><text wx:if="{{item.storeName}}">{{item.storeName}}</text><document-no wx:else value="{{item.requestNo || item.id}}" /><text class="status {{item.paymentStatus === 'SHORTFALL' ? 'tone-warn' : item.status === 'CONFIRMED' ? 'tone-brand' : ''}}">{{labels.status(item.status)}}</text></view>
        <view class="muted" wx:if="{{item.storeName}}"><document-no value="{{item.requestNo}}" /></view>
        <view class="muted">资金 {{labels.status(item.paymentStatus)}}</view>
        <view class="request-list-total">订货金额 <text>¥{{labels.money(item.salesGoodsAmount)}}</text></view>
        <view class="amount amount-warn" wx:if="{{item.paymentStatus === 'SHORTFALL'}}">待补货款 ¥{{labels.money(item.shortfallAmount || '0.00')}}</view>
      </view>
      <view wx:if="{{!visibleRequests.length && !loading && !error}}" class="row"><view class="muted">{{search || statusFilter !== 'all' ? '没有符合条件的下货单' : '暂无下货单'}}</view><button class="empty-action" wx:if="{{search || statusFilter !== 'all'}}" bindtap="clearOrderFilter">清除筛选</button></view>
    </view>
  </view>

  <view class="card" wx:if="{{activeView === 'reports'}}">
    <view class="back-link" data-view="mine" bindtap="changeView">‹ 返回我的</view>
    <view class="report-page-heading"><text>采购统计</text><text>按供应商订单的完成情况汇总</text></view>
    <view class="report-filter-panel">
      <view class="report-filter-heading"><text>统计筛选</text><text>最多查询三个月</text></view>
      <view class="report-filter-label">选择日期范围</view>
      <view class="report-presets"><view class="{{reportPreset === 'today' ? 'selected' : ''}}" data-preset="today" bindtap="chooseReportPreset">今日</view><view class="{{reportPreset === 'week' ? 'selected' : ''}}" data-preset="week" bindtap="chooseReportPreset">本周</view><view class="{{reportPreset === 'month' ? 'selected' : ''}}" data-preset="month" bindtap="chooseReportPreset">本月</view><view class="{{reportPreset === 'lastMonth' ? 'selected' : ''}}" data-preset="lastMonth" bindtap="chooseReportPreset">上月</view><view class="{{reportPreset === 'custom' ? 'selected' : ''}}" data-preset="custom" bindtap="chooseReportPreset">自定义</view></view>
      <view class="report-selected-range" wx:if="{{reportPreset !== 'custom'}}">{{reportDraft.from}} 至 {{reportDraft.to}}</view>
      <view class="report-date-range" wx:if="{{reportPreset === 'custom'}}"><picker mode="date" value="{{reportDraft.from}}" data-field="from" bindchange="changeReportDate"><view><text class="report-date-label">开始日期</text><text>{{reportDraft.from}} <text class="picker-caret">⌄</text></text></view></picker><text class="report-date-separator">至</text><picker mode="date" value="{{reportDraft.to}}" data-field="to" bindchange="changeReportDate"><view><text class="report-date-label">结束日期</text><text>{{reportDraft.to}} <text class="picker-caret">⌄</text></text></view></picker></view>
      <view class="report-filter-label report-filter-label-spaced">业务范围</view>
      <view class="report-entity-filters"><picker range="{{reportStoreOptions}}" range-key="name" value="{{reportStoreIndex}}" data-field="storeId" bindchange="chooseReportFilter"><view><text class="report-date-label">门店</text><text>{{reportStoreOptions[reportStoreIndex].name}} <text class="picker-caret">⌄</text></text></view></picker><picker range="{{reportSupplierOptions}}" range-key="name" value="{{reportSupplierIndex}}" data-field="supplierId" bindchange="chooseReportFilter"><view><text class="report-date-label">供应商</text><text>{{reportSupplierOptions[reportSupplierIndex].name}} <text class="picker-caret">⌄</text></text></view></picker></view>
      <button class="primary report-query-button" loading="{{reportsLoading}}" disabled="{{reportsLoading}}" bindtap="applyReportRange">查询统计</button>
    </view>
    <view class="report-scope">统计口径：订单完成日期 · {{reportRange.from}} 至 {{reportRange.to}}</view>
    <view class="report-results">
    <view class="workspace-loading" wx:if="{{reportsLoading}}">正在查询统计</view>
    <view class="error-banner" wx:if="{{reportsError}}">{{reportsError}}</view>
    <view class="metric-grid procurement-report-metrics" wx:if="{{reportSummary}}">
      <view class="metric"><text class="metric-label">完成订单金额</text><text class="metric-value">¥{{labels.money(reportSummary.amount)}}</text><text class="report-metric-note">含运费</text></view>
      <view class="metric"><text class="metric-label">完成订单数</text><text class="metric-value">{{reportSummary.count}}</text><text class="report-metric-note">供应商订单</text></view>
      <view class="metric"><text class="metric-label">收货商品种数</text><text class="metric-value">{{reportSummary.productCount}}</text></view>
    </view>
    <view class="report-order-list" wx:if="{{reportSummary}}">
      <text class="card-title">采购明细 · {{reportSummary.count}} 单</text>
      <view class="report-supplier-group" wx:for="{{reportSupplierGroups}}" wx:key="supplierId" wx:for-item="group">
      <view class="report-supplier-heading"><text>{{group.supplierName}}</text><text>{{group.orders.length}} 单</text></view>
      <view class="report-order" wx:for="{{group.orders}}" wx:key="supplierOrderId" wx:for-item="order">
        <view class="report-order-heading" data-id="{{order.supplierOrderId}}" bindtap="toggleReportOrder">
          <view class="row-title"><document-no value="{{order.supplierOrderNo}}" /><text>¥{{labels.money(order.totalAmount)}}</text></view>
          <view class="muted">门店 · {{order.storeName}}</view>
          <view class="muted">完成 · {{order.completedText}}</view>
          <view class="report-order-foot"><text>{{order.items.length}} 种商品 · 已完成</text><text>{{order.open ? '收起商品 ∧' : '查看商品 ›'}}</text></view>
        </view>
        <view wx:if="{{order.open}}" class="report-order-products">
          <view class="report-product" wx:for="{{order.items}}" wx:key="id"><product-card product="{{item}}" variant="compact" bind:retryimage="retryReportImage"><view class="row-title"><text>{{item.productName}}</text><text>¥{{labels.money(item.goodsAmount)}}</text></view><view class="muted">实收 {{item.quantityText}} {{item.unitName}}</view><view class="muted">销售价格 ¥{{labels.money(item.unitPrice)}} / {{item.unitName}}</view></product-card></view>
          <view class="report-order-foot report-order-totals"><text>商品 ¥{{labels.money(order.goodsAmount)}}</text><text>运费 ¥{{labels.money(order.freightAmount)}}</text></view>
        </view>
      </view>
      </view>
    </view>
    <button class="secondary" wx:if="{{moreReportDetails}}" bindtap="nextReportDetails">加载更多供应商</button>
    <view class="empty-state" wx:if="{{reportSummary && !reportSummary.count}}">该区间暂无已完成订单</view>
    </view>
  </view>

  <view class="card" wx:if="{{result && !selectedRequest}}">
    <text class="card-title">处理结果</text>
    <view class="row"><view class="row-title"><text>{{result.title}}</text><text class="status tone-brand">{{labels.status(result.status)}}</text></view><view class="muted">{{result.detail}}</view></view>
  </view>
  <button class="secondary" wx:if="{{activeView === 'orders' && !selectedRequest && moreOrders}}" bindtap="nextOrders">加载更多</button>
</view>
