<view class="page">
  <view class="hero">
    <text class="eyebrow">SUPPLIER</text>
    <text class="title">供应商工作台</text>
    <view class="subtitle">面向 S06-S08：待发货、补发、拒单、收货差异和收款确认。当前切片接执行单、异常、账单和付款记录。</view>
  </view>

  <view class="card">
    <text class="card-title">当前账号</text>
    <view class="metric-grid">
      <view class="metric"><text class="metric-label">用户</text><text class="metric-value">{{user.displayName || '未登录'}}</text></view>
      <view class="metric"><text class="metric-label">角色</text><text class="metric-value">{{roleText}}</text></view>
    </view>
    <view class="button-row">
      <button class="secondary" loading="{{loading}}" bindtap="loadWork">刷新待办</button>
      <button class="danger" bindtap="logout">退出</button>
    </view>
  </view>

  <view class="card">
    <text class="card-title">手动处理执行单</text>
    <view class="field"><text class="field-label">供应商单 ID</text><input value="{{supplierOrderId}}" data-field="supplierOrderId" bindinput="onInput" placeholder="supplierOrderId" /></view>
    <view class="field"><text class="field-label">发货数量</text><input type="digit" value="{{shipQuantity}}" data-field="shipQuantity" bindinput="onInput" /></view>
    <view class="button-row">
      <button class="primary" loading="{{shipping}}" bindtap="shipOrder">创建发货</button>
      <button class="danger" loading="{{rejecting}}" bindtap="rejectOrder">拒单</button>
    </view>
  </view>

  <view class="card">
    <text class="card-title">待办列表</text>
    <view class="list">
      <view wx:for="{{orders}}" wx:key="id" class="row" bindtap="selectOrder" data-id="{{item.id}}">
        <view class="row-title"><text>{{item.orderNo || item.id}}</text><text class="tag">{{item.status || item.fulfillmentStatus}}</text></view>
        <view class="muted">点击填入执行单。仅显示当前账号可读的供应商订单。</view>
      </view>
      <view wx:if="{{!orders.length}}" class="row"><view class="muted">暂无待办或尚未刷新。</view></view>
    </view>
  </view>

  <view class="card">
    <text class="card-title">收货差异处理</text>
    <view class="field"><text class="field-label">差异 ID</text><input value="{{discrepancyId}}" data-field="discrepancyId" bindinput="onInput" placeholder="discrepancyId" /></view>
    <view class="field"><text class="field-label">原因说明</text><input value="{{discrepancyReason}}" data-field="discrepancyReason" bindinput="onInput" placeholder="补发安排、退回原因或同意说明" /></view>
    <view class="button-row">
      <button class="secondary" loading="{{resolving}}" data-action="ACCEPT" bindtap="resolveDiscrepancy">同意少收</button>
      <button class="primary" loading="{{resolving}}" data-action="REPLENISH" bindtap="resolveDiscrepancy">安排补发</button>
    </view>
    <view class="button-row">
      <button class="danger" loading="{{resolving}}" data-action="RETURN" bindtap="resolveDiscrepancy">退回核对</button>
      <button class="secondary" loading="{{loading}}" bindtap="loadDiscrepancies">刷新差异</button>
    </view>
    <view class="list">
      <view wx:for="{{discrepancies}}" wx:key="id" class="row" bindtap="selectDiscrepancy" data-id="{{item.id}}">
        <view class="row-title"><text>{{item.title}}</text><text class="tag tag-warn">OPEN</text></view>
        <view class="muted">差异 {{item.id}} · 收货 {{item.receiptId || '—'}}，点击填入差异 ID。</view>
      </view>
      <view wx:if="{{!discrepancies.length}}" class="row"><view class="muted">暂无收货差异通知或尚未刷新。</view></view>
    </view>
  </view>

  <view class="card">
    <view class="section-head">
      <text class="card-title">供应商账单</text>
      <button class="ghost" loading="{{loading}}" bindtap="loadStatements">刷新</button>
    </view>
    <view class="list">
      <view wx:for="{{statements}}" wx:key="id" class="row">
        <view class="row-title"><text>{{item.periodKey}}</text><text class="tag">{{item.settlementStatus}}</text></view>
        <view class="muted">应付 {{item.payableAmount}}，待确认 {{item.pendingPaymentAmount}}，已付 {{item.confirmedPaidAmount}}</view>
      </view>
      <view wx:if="{{!statements.length}}" class="row"><view class="muted">暂无供应商账单或尚未刷新。</view></view>
    </view>
  </view>

  <view class="card">
    <view class="section-head">
      <text class="card-title">统计概览</text>
      <button class="ghost" loading="{{loading}}" bindtap="loadReports">刷新</button>
    </view>
    <view class="muted">区间 {{reportRange.from}} 至 {{reportRange.to}}，仅显示当前供应商范围，不展示公司利润。</view>
    <view class="metric-grid" wx:if="{{reports.orderAmount}}">
      <view class="metric"><text class="metric-label">完成月份</text><text class="metric-value">{{reports.orderAmount.months[0].month || '-'}}</text></view>
      <view class="metric"><text class="metric-label">完成金额</text><text class="metric-value">{{reports.orderAmount.months[0].totalAmount || '0.00'}}</text></view>
      <view class="metric"><text class="metric-label">完成单数</text><text class="metric-value">{{reports.orderAmount.months[0].orderCount || 0}}</text></view>
      <view class="metric"><text class="metric-label">商品种数</text><text class="metric-value">{{reports.productQuantity.products.length || 0}}</text></view>
    </view>
    <view class="list" wx:if="{{reports.productQuantity.products.length}}">
      <view class="row" wx:for="{{reports.productQuantity.products}}" wx:key="productId">
        <view class="row-title"><text>{{item.productName}}</text><text class="tag">{{item.quantity}}</text></view>
        <view class="muted">单位 {{item.unit}}</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="section-head">
      <text class="card-title">收款确认</text>
      <button class="ghost" loading="{{loading}}" bindtap="loadPayments">刷新</button>
    </view>
    <view class="field"><text class="field-label">付款记录 ID</text><input value="{{paymentId}}" data-field="paymentId" bindinput="onInput" placeholder="paymentRecordId" /></view>
    <view class="field"><text class="field-label">驳回原因</text><input value="{{paymentReason}}" data-field="paymentReason" bindinput="onInput" placeholder="仅驳回时填写" /></view>
    <view class="button-row">
      <button class="primary" loading="{{paying}}" data-action="confirm" bindtap="handlePayment">确认收款</button>
      <button class="danger" loading="{{paying}}" data-action="reject" bindtap="handlePayment">驳回付款</button>
    </view>
    <view class="list">
      <view wx:for="{{payments}}" wx:key="id" class="row" bindtap="selectPayment" data-id="{{item.id}}">
        <view class="row-title"><text>{{item.paymentNo || item.id}}</text><text class="tag {{item.status === 'PENDING' ? 'tag-warn' : ''}}">{{item.status}}</text></view>
        <view class="muted">金额 {{item.amount}}，方向 {{item.direction}}，点击填入付款记录。</view>
      </view>
      <view wx:if="{{!payments.length}}" class="row"><view class="muted">暂无付款记录或尚未刷新。</view></view>
    </view>
  </view>

  <view class="card" wx:if="{{result}}">
    <text class="card-title">处理结果</text>
    <view class="row"><view class="row-title"><text>{{result.title}}</text><text class="tag">{{result.status}}</text></view><view class="muted">{{result.detail}}</view></view>
  </view>
  <view wx:if="{{error}}" class="card"><text class="tag tag-fail">{{error}}</text></view>
</view>
