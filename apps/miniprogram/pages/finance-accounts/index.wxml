<test-context />
<wxs src="../../utils/labels.wxs" module="labels" />
<view class="page">
  <view class="business-heading"><view><text class="business-title">{{store ? store.name : '门店账户'}}</text><text class="muted">{{user.displayName}}</text></view><button class="ghost" bindtap="loadWork" disabled="{{loading || submitting || uploading || mode}}">刷新</button></view>
  <view class="error-banner" wx:if="{{error}}">{{error}}</view>
  <view class="band" wx:if="{{pendingCommand}}"><text class="form-title">上次提交结果待确认</text><button class="secondary" bindtap="recoverCommand" disabled="{{submitting || uploading}}" loading="{{submitting}}">核对原提交结果</button></view>
  <view class="workspace-loading" wx:if="{{loading}}">正在读取账户</view>
  <view class="band" wx:if="{{!store}}"><input class="business-search" placeholder="搜索门店名称" value="{{search}}" bindinput="onSearch" /><view class="row" wx:for="{{visibleStores}}" wx:key="id" data-id="{{item.id}}" bindtap="openStore"><view class="row-title"><text>{{item.name}}</text><text>›</text></view><text class="muted">未销账 ¥{{labels.money(item.account.creditUsed)}} · 储值 ¥{{labels.money(item.account.balance)}}</text></view><view class="empty-state" wx:if="{{!visibleStores.length && !loading && !error}}">暂无匹配门店</view></view>
  <block wx:if="{{store}}">
    <view class="band"><view class="back-link" bindtap="back">返回门店列表</view>
      <view class="balance-grid" wx:if="{{account}}"><view><text class="muted">挂账未销账</text><text class="amount">¥{{labels.money(account.creditUsed)}}</text></view><view><text class="muted">挂账剩余额度</text><text class="amount">¥{{labels.money(account.creditAvailable)}}</text></view><view><text class="muted">储值余额</text><text class="amount">¥{{labels.money(account.balance)}}</text></view><view><text class="muted">可用储值</text><text class="amount">¥{{labels.money(account.availableBalance)}}</text></view></view>
      <view class="operations" wx:if="{{account && !mode && !document}}"><button class="primary" data-mode="recharge" bindtap="startAction" disabled="{{pendingCommand || loading}}">充值</button><button class="secondary" data-mode="clearing" bindtap="startAction" disabled="{{pendingCommand || loading}}">销账</button><button class="secondary" data-mode="credit" bindtap="startAction" disabled="{{pendingCommand || loading}}">挂账额度</button></view>
    </view>
    <view class="band" wx:if="{{mode}}"><text class="form-title">{{mode === 'recharge' ? '门店充值' : mode === 'credit' ? '挂账额度设置' : '门店销账'}}{{confirming ? ' · 确认' : ''}}</text>
      <block wx:if="{{!confirming}}">
        <label class="field" wx:if="{{mode !== 'clearing'}}"><text class="field-label">{{mode === 'credit' ? '挂账额度（元）' : '充值金额（元）'}}</text><input type="digit" data-field="amount" bindinput="onField" value="{{amount}}" disabled="{{submitting || uploading}}" /></label>
        <label class="field" wx:if="{{mode === 'credit'}}"><text class="field-label">调整原因 *</text><input maxlength="300" data-field="reason" bindinput="onField" value="{{reason}}" disabled="{{submitting}}" /></label>
        <block wx:if="{{mode !== 'credit'}}">
          <view class="field"><text class="field-label">{{mode === 'recharge' ? '充值日期' : '销账日期'}} *</text><picker mode="date" value="{{businessDate}}" data-field="businessDate" bindchange="onField" disabled="{{submitting || uploading}}"><view class="picker-value">{{businessDate}}<text>⌄</text></view></picker></view>
          <view class="field" wx:if="{{mode === 'recharge'}}"><text class="field-label">收款账户 *</text><picker range="{{collectionAccounts}}" range-key="name" value="{{collectionIndex}}" bindchange="chooseCollection" disabled="{{submitting || uploading}}"><view class="picker-value">{{collectionIndex >= 0 ? collectionAccounts[collectionIndex].name : '请选择收款账户'}}<text>⌄</text></view></picker><text class="muted" wx:if="{{!collectionAccounts.length}}">暂无启用的收款账户</text></view>
          <block wx:if="{{mode === 'clearing'}}">
            <view class="filters"><picker mode="date" value="{{from}}" data-field="from" bindchange="onFilter"><view class="picker-value">{{from || '开始日期'}}⌄</view></picker><picker mode="date" value="{{to}}" data-field="to" bindchange="onFilter"><view class="picker-value">{{to || '结束日期'}}⌄</view></picker><picker class="supplier" range="{{suppliers}}" value="{{supplierIndex}}" data-field="supplierIndex" bindchange="onFilter"><view class="picker-value">{{suppliers[supplierIndex]}}⌄</view></picker></view>
            <view class="row-title"><text>已选 {{chosen.length}} 笔</text><button class="ghost" bindtap="selectAll" disabled="{{submitting || uploading}}">{{chosen.length === visibleCredits.length ? '取消全选' : '选择全部'}}</button></view>
            <checkbox-group bindchange="chooseCredits"><label class="credit-row" wx:for="{{visibleCredits}}" wx:key="fundingAllocationId"><checkbox value="{{item.fundingAllocationId}}" checked="{{item.checked}}" disabled="{{submitting || uploading}}" /><view><text>{{item.supplierOrderNo || '挂账订单'}}</text><text class="muted">{{item.supplierName || '—'}} · {{item.dateText}}</text></view><text>¥{{labels.money(item.creditOutstanding)}}</text></label></checkbox-group><text class="muted" wx:if="{{!visibleCredits.length}}">暂无匹配的未销账订单</text>
          </block>
          <label class="field"><text class="field-label">备注</text><input maxlength="300" data-field="remark" bindinput="onField" value="{{remark}}" disabled="{{submitting || uploading}}" /></label>
          <view class="field"><text class="field-label">图片凭证 *</text><evidence-files files="{{evidenceFiles}}" /><view class="operations"><button class="secondary" bindtap="addEvidence" loading="{{uploading}}" disabled="{{submitting || uploading || evidenceFiles.length >= 5}}">上传凭证</button><button class="ghost" wx:for="{{evidenceFiles}}" wx:key="id" data-id="{{item.id}}" bindtap="removeEvidence" disabled="{{submitting || uploading}}">移除 {{index + 1}}</button></view></view>
        </block>
      </block>
      <block wx:else><view class="detail-line">门店：{{store.name}}</view><view class="detail-line">{{mode === 'credit' ? '新额度' : mode === 'recharge' ? '充值金额' : '销账金额'}}：¥{{labels.money(mode === 'clearing' ? preview.totalAmount : amount)}}</view><view class="detail-line" wx:if="{{mode === 'credit'}}">原额度 ¥{{labels.money(account.creditLimit)}} · 原因 {{reason}}</view><block wx:else><view class="detail-line">业务日期：{{businessDate}}</view><view class="detail-line" wx:if="{{mode === 'recharge'}}">收款账户：{{collectionAccounts[collectionIndex].name}}</view><view class="detail-line" wx:else>销账订单：{{preview.items.length}} 笔</view><text class="muted">{{remark}}</text><evidence-files files="{{evidenceFiles}}" /></block></block>
      <view class="submit-actions"><button class="secondary" bindtap="{{confirming ? 'editForm' : 'cancelAction'}}" disabled="{{submitting || uploading}}">{{confirming ? '返回修改' : '取消'}}</button><button class="primary" bindtap="{{confirming ? 'submit' : 'prepare'}}" loading="{{submitting}}" disabled="{{submitting || uploading || pendingCommand}}">{{confirming ? '确认提交' : '核对信息'}}</button></view>
    </view>
    <view class="band" wx:if="{{!mode && !document && account}}"><text class="form-title">充值与销账历史</text><view class="row" wx:for="{{history}}" wx:key="id" data-id="{{item.id}}" data-kind="{{item.kind}}" bindtap="openDocument"><view class="row-title"><text>{{item.title}}</text><text>¥{{labels.money(item.amount)}} ›</text></view><text class="muted">{{item.dateText}}</text></view><text class="muted" wx:if="{{!history.length}}">暂无充值或销账记录</text></view>
<view class="band" wx:if="{{document}}"><view class="back-link" bindtap="closeDocument">返回账户历史</view><text class="form-title">{{document.title}} · {{document.documentNo}}</text><text class="amount">¥{{labels.money(document.amount)}}</text><text class="muted">{{document.businessDate}} · {{document.remark || ''}}</text><text class="muted">经办人：{{document.operatorName || '—'}}</text><evidence-files files="{{document.evidenceFiles}}" /></view>
  </block>
</view>
