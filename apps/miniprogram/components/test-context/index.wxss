.test-context {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 16rpx 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: var(--warn-soft);
  color: var(--warn);
  font-size: 26rpx;
}
.test-context > view { min-width: 0; flex: 1; }
.badge { display: block; font-weight: 700; }
.identity { display: block; margin-top: 8rpx; color: var(--ink-2); font-size: 24rpx; overflow-wrap: anywhere; }
.test-context button {
  flex-shrink: 0;
  margin: 0;
  height: 64rpx;
  padding: 0 20rpx;
  line-height: 64rpx;
  font-size: 24rpx;
  background: var(--surface);
  color: var(--brand);
  border-radius: 10rpx;
}