<test-context />
<wxs src="../../utils/labels.wxs" module="labels" />
<view class="page {{canConfirm && selectedKind === 'order' && selected.status === 'PENDING_PROCUREMENT' ? 'has-action-bar' : ''}}">
  <view class="business-heading"><view><text class="business-title">{{roleText}}</text><text class="muted">{{user.displayName}}</text></view><button class="ghost" bindtap="loadWork" loading="{{loading}}" disabled="{{saving || loading}}">刷新</button></view>
  <view class="scope-filter" wx:if="{{activeView !== 'mine'}}"><picker range="{{storeOptions}}" range-key="name" value="{{storeIndex}}" bindchange="chooseStore" disabled="{{saving || loading}}"><view class="picker-value">{{storeOptions[storeIndex].name || '加载门店'}} <text>▾</text></view></picker></view>
  <view class="workspace-loading" wx:if="{{loading}}">正在更新数据</view>
  <view class="error-banner" wx:if="{{error}}"><text>{{error}}</text></view>
  <view class="command-recovery" wx:if="{{pendingCommand}}"><text>采购提交结果待确认</text><button class="secondary" bindtap="recoverCommand" loading="{{saving}}" disabled="{{saving}}">确认原提交结果</button></view>
  <view class="error-banner" wx:if="{{blockedCommand}}">存在当前角色不能恢复的历史提交，请联系管理员核对。</view>

  <block wx:if="{{activeView === 'orders' || activeView === 'tasks' || activeView === 'books'}}">
    <view class="task-tabs" wx:if="{{activeView === 'books' && !selected && !detailing}}"><view class="{{book === 'company' ? 'selected' : ''}}" data-book="company" bindtap="chooseBook">公司账期</view><view class="{{book === 'direct' ? 'selected' : ''}}" data-book="direct" bindtap="chooseBook">供应商账期</view></view>
    <view class="card" wx:if="{{!selected && !detailing}}">
      <input class="business-search" value="{{search}}" bindinput="onSearch" placeholder="搜索门店或单据" />
      <view class="row" wx:for="{{visibleRows}}" wx:key="id" data-id="{{item.id}}" bindtap="openRecord"><view class="row-title"><text>{{item.title}}</text><text class="tag">{{labels.status(item.status)}}</text></view><text class="muted">{{item.subtitle}}</text><view class="record-footer"><text class="muted">{{item.dateText}}</text><text>¥{{labels.money(item.amount)}} ›</text></view></view>
      <view class="empty-state" wx:if="{{!visibleRows.length && !loading && !error}}">{{activeView === 'tasks' ? '暂无待确认订货' : activeView === 'books' ? '暂无结算账单' : '暂无订货记录'}}</view>
      <button class="secondary" wx:if="{{moreRows}}" bindtap="nextRows">加载更多</button>
    </view>
    <view class="card" wx:if="{{selected || detailing}}"><view class="back-link" bindtap="backToList">‹ 返回列表</view><text wx:if="{{detailing}}" class="muted">正在加载明细</text><block wx:if="{{selected}}"><text class="card-title">{{selected.title}}</text><text class="muted">{{selected.subtitle}} · {{selected.dateText}}</text><view class="detail-status">{{labels.status(selected.settlementStatus || selected.status)}}</view>
      <block wx:if="{{selectedKind === 'order'}}"><view class="metric-grid"><view class="metric"><text class="metric-label">订货金额</text><text class="metric-value">¥{{labels.money(selected.salesGoodsAmount)}}</text></view><view class="metric"><text class="metric-label">待补货款</text><text class="metric-value">¥{{labels.money(selected.shortfallAmount)}}</text></view></view><view class="row" wx:for="{{selected.items}}" wx:key="id"><view class="row-title"><text>{{item.productName || '商品'}}</text><text>{{item.quantity}}</text></view><text class="muted">销售金额 ¥{{labels.money(item.salesLineAmount)}}</text></view><view class="row" wx:for="{{selected.supplierOrders}}" wx:key="id"><view class="row-title"><text>{{item.supplierOrderNo}}</text><text class="tag">{{labels.status(item.status)}}</text></view><text class="muted">履约 {{labels.status(item.fulfillmentStatus)}}</text></view></block>
<block wx:else><view class="metric-grid"><view class="metric"><text class="metric-label">账单金额</text><text class="metric-value">¥{{labels.money(selected.totalAmount)}}</text></view><view class="metric"><text class="metric-label">已支付</text><text class="metric-value">¥{{labels.money(selected.confirmedPaidAmount)}}</text></view><view class="metric"><text class="metric-label">待支付</text><text class="metric-value">¥{{labels.money(selected.payableAmount)}}</text></view><view class="metric"><text class="metric-label">调整金额</text><text class="metric-value">¥{{labels.money(selected.adjustmentAmount)}}</text></view></view><view class="row" wx:for="{{selected.lines}}" wx:key="supplierOrderId"><view class="row-title"><text>{{item.supplierOrderNo}}</text><text>¥{{labels.money(item.totalAmount)}}</text></view><text class="muted">首发 {{item.dateText}}</text></view><evidence-files files="{{selected.evidenceFiles}}" /></block>
    </block></view>
    <view class="button-row action-bar" wx:if="{{canConfirm && selectedKind === 'order' && selected.status === 'PENDING_PROCUREMENT'}}"><button class="secondary" data-action="reject" bindtap="submitDecision" disabled="{{saving || pendingCommand || blockedCommand}}">取消订货</button><button class="primary" data-action="confirm" bindtap="submitDecision" loading="{{saving}}" disabled="{{saving || pendingCommand || blockedCommand}}">确认并推送</button></view>
  </block>

  <block wx:if="{{activeView === 'reports'}}"><view class="card"><view class="date-controls"><picker mode="date" value="{{range.from}}" data-field="from" bindchange="onDate"><view>{{range.from}}</view></picker><text>至</text><picker mode="date" value="{{range.to}}" data-field="to" bindchange="onDate"><view>{{range.to}}</view></picker><button class="primary" bindtap="loadWork" disabled="{{loading}}">查询</button></view></view><block wx:if="{{report}}"><view class="card"><text class="card-title">订货汇总</text><view class="row" wx:for="{{report.months}}" wx:key="month"><view class="row-title"><text>{{item.month}}</text><text>¥{{labels.money(item.totalAmount)}}</text></view><text class="muted">完成 {{item.orderCount}} 单</text></view><view class="empty-state" wx:if="{{!report.months.length}}">暂无完成订单</view></view><view class="card"><text class="card-title">商品订货数量</text><view class="row" wx:for="{{report.products}}" wx:key="productId"><view class="row-title"><text>{{item.productName}}</text><text>{{item.quantity}} {{item.unit}}</text></view></view><view class="empty-state" wx:if="{{!report.products.length}}">暂无商品统计</view></view></block></block>
  <block wx:if="{{activeView === 'mine'}}"><view class="card"><text class="card-title">{{user.displayName}}</text><text class="muted">{{roleText}}</text></view><view class="card"><text class="card-title">授权门店 · {{stores.length}}</text><view class="row" wx:for="{{stores}}" wx:key="id"><text>{{item.name}}</text></view></view><button class="account-logout" bindtap="logout" disabled="{{saving}}">退出登录</button></block>
  <view class="business-nav"><view wx:if="{{canConfirm}}" class="nav-item {{activeView === 'tasks' ? 'is-active' : ''}}" data-view="tasks" bindtap="changeView">待办</view><view class="nav-item {{activeView === 'orders' ? 'is-active' : ''}}" data-view="orders" bindtap="changeView">订单</view><view class="nav-item {{activeView === 'books' ? 'is-active' : ''}}" data-view="books" bindtap="changeView">结算</view><view class="nav-item {{activeView === 'reports' ? 'is-active' : ''}}" data-view="reports" bindtap="changeView">报表</view><view class="nav-item {{activeView === 'mine' ? 'is-active' : ''}}" data-view="mine" bindtap="changeView">我的</view></view>
</view>
