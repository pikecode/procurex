.evidence-list { display: flex; flex-wrap: wrap; gap: 20rpx; padding: 16rpx 0; }
.evidence-file { width: 144rpx; color: var(--ink-2); font-size: 22rpx; }
.thumbnail { width: 144rpx; height: 144rpx; border-radius: 12rpx; background: var(--sunken); }
.placeholder { display: flex; align-items: center; justify-content: center; color: var(--ink-4); }
.evidence-file text {
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  padding-top: 8rpx;
}
.error { color: var(--danger); font-size: 24rpx; }
.compact { gap: 12rpx; padding: 12rpx 0 0; }
.compact .evidence-file { width: 104rpx; }
.compact .thumbnail { width: 104rpx; height: 104rpx; border-radius: 8rpx; }
