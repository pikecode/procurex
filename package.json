{
  "name": "procurex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start:api": "node --env-file-if-exists=.env dist/apps/api/main.js",
    "start:web": "python3 -m http.server 4173 --directory apps/web",
    "start:worker": "node --env-file-if-exists=.env dist/apps/worker/main.js",
    "db:up": "docker compose -f infra/compose/compose.yaml up -d --wait",
    "db:stop": "docker compose -f infra/compose/compose.yaml stop",
    "db:check": "node --env-file-if-exists=.env scripts/check-local-db.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "test": "node --test dist/tests/unit/*.test.js",
    "test:integration": "node --env-file-if-exists=.env --test --test-concurrency=1 dist/tests/integration/*.test.js",
    "contract:check": "node scripts/check-contract.mjs",
    "web:check": "node scripts/check-web-workbenches.mjs",
    "mini:check": "node scripts/check-miniprogram-surface.mjs",
    "mini:flow-check": "npm run build && npm run main-flow:seed-demo && node --env-file-if-exists=.env scripts/check-miniprogram-flow.mjs",
    "acceptance:main-flow": "node --env-file-if-exists=.env scripts/run-main-flow-acceptance.mjs",
    "reports:seed-acceptance": "node --env-file-if-exists=.env scripts/seed-reports-acceptance.mjs",
    "reports:check-acceptance": "node --env-file-if-exists=.env scripts/check-reports-acceptance.mjs",
    "notifications:seed-acceptance": "node --env-file-if-exists=.env scripts/seed-notifications-acceptance.mjs",
    "notifications:send-overdue-receipt-reminders": "node --env-file-if-exists=.env scripts/send-overdue-receipt-reminders.mjs",
    "notifications:check-acceptance": "node --env-file-if-exists=.env scripts/check-notifications-acceptance.mjs",
    "acceptance:m5-browserless": "npm run build && npm run reports:seed-acceptance && npm run notifications:seed-acceptance && npm run notifications:send-overdue-receipt-reminders -- --hours=24 && npm run reports:check-acceptance && npm run notifications:check-acceptance && npm run web:check",
    "m5:capture-browser-evidence": "node scripts/capture-m5-browser-evidence.mjs",
    "m5:capture-ops-evidence": "node scripts/capture-m5-ops-evidence.mjs",
    "m5:capture-all-evidence": "node scripts/capture-m5-all-evidence.mjs",
    "m5:status": "node --env-file-if-exists=.env scripts/report-m5-status.mjs",
    "m5:gate-status": "node scripts/check-m5-gate-status.mjs",
    "m6:performance": "npm run build && npm run reports:seed-acceptance && node --env-file-if-exists=.env scripts/check-m6-performance.mjs",
    "m6:rollback-check": "node --env-file-if-exists=.env scripts/check-m6-rollback.mjs",
    "m6:initialization-check": "npm run build && node --env-file-if-exists=.env scripts/check-m6-initialization.mjs",
    "m6:pilot-check": "node --env-file-if-exists=.env scripts/check-m6-pilot.mjs",
    "m6:external-evidence": "node --env-file-if-exists=.env scripts/check-m6-external-evidence.mjs",
    "m6:external-evidence:strict": "node --env-file-if-exists=.env scripts/check-m6-external-evidence.mjs --strict",
    "m6:write-external-templates": "node scripts/write-m6-external-evidence-templates.mjs",
    "m6:check-external-templates": "node scripts/write-m6-external-evidence-templates.mjs --check",
    "m6:capture-readiness-evidence": "node scripts/capture-m6-readiness-evidence.mjs",
    "m6:package-local-evidence": "node scripts/package-m6-local-evidence.mjs",
    "m6:readiness": "node --env-file-if-exists=.env scripts/report-m6-readiness.mjs",
    "m6:readiness:strict": "node --env-file-if-exists=.env scripts/report-m6-readiness.mjs --strict",
    "acceptance:m5-close": "npm run acceptance:m5-browserless && npm run main-flow:seed-demo && npm run main-flow:check-demo && npm run m5:status && npm run m5:capture-all-evidence && npm run main-flow:capture-demo-evidence && npm run main-flow:capture-interactive-demo && npm run m5:gate-status && npm run m5:status",
    "billing:seed-acceptance": "node --env-file-if-exists=.env scripts/seed-billing-acceptance.mjs",
    "billing:check-acceptance": "node --env-file-if-exists=.env scripts/check-billing-acceptance.mjs",
    "acceptance:m4-browserless": "npm run build && npm run billing:seed-acceptance && npm run billing:check-acceptance && npm run m4:gate-status && npm run m4:check-manual-checklist && npm run main-flow:seed-demo && npm run main-flow:check-demo && npm run acceptance:main-flow && npm run web:check",
    "acceptance:m4-close": "npm run acceptance:m4-browserless && npm run m4:check-manual-evidence",
    "m4:check-browser-runtime": "node scripts/check-browser-runtime.mjs",
    "m4:capture-browser-evidence": "node scripts/capture-m4-browser-evidence.mjs",
    "m4:capture-manual-evidence": "node scripts/capture-m4-manual-evidence.mjs",
    "m4:manual-evidence-status": "node scripts/check-m4-manual-evidence.mjs --allow-missing",
    "m4:check-manual-evidence": "node scripts/check-m4-manual-evidence.mjs",
    "m4:prepare-manual-acceptance": "node --env-file-if-exists=.env scripts/prepare-m4-manual-acceptance.mjs",
    "m4:status": "node --env-file-if-exists=.env scripts/report-m4-status.mjs",
    "m4:start-manual-acceptance": "node scripts/start-m4-manual-acceptance.mjs",
    "m4:gate-status": "node scripts/check-m4-gate-status.mjs",
    "m4:write-manual-checklist": "node scripts/write-m4-manual-checklist.mjs",
    "m4:check-manual-checklist": "node scripts/write-m4-manual-checklist.mjs --check",
    "main-flow:seed-demo": "node --env-file-if-exists=.env scripts/seed-main-flow-demo.mjs",
    "main-flow:check-demo": "node --env-file-if-exists=.env scripts/check-main-flow-demo.mjs",
    "main-flow:capture-demo-evidence": "node scripts/capture-main-flow-demo-evidence.mjs",
    "main-flow:capture-interactive-demo": "node scripts/capture-main-flow-interactive-demo.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-express": "12.1.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "decimal.js": "10.6.0",
    "dotenv": "18.0.3",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "prisma": "7.10.0",
    "typescript": "5.9.2"
  }
}
