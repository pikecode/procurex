/* ===========================================================================
   工作区外壳 · 采购 / 供应商 / 财务 / 授权门店 共用
   页头、角色导航、卡片、列表行、详情头、底部操作条只在这里定义一次。
   =========================================================================== */

.page {
  min-height: 100vh;
  padding: 0 0 calc(150rpx + env(safe-area-inset-bottom));
  background: var(--canvas);
}

/* ---------- 页头 ---------- */

/* 页头与原生导航栏同为 --brand-deep，两段拼成一条完整的品牌色带。 */
.business-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 30rpx 28rpx 28rpx;
  background: var(--brand-deep);
  color: #fff;
}
.business-heading > view:first-child { min-width: 0; flex: 1; }
.business-title {
  display: block;
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.3;
}
/* 页头上的次要文字用半透明白，保持层级同时不牺牲可读性 */
.business-heading .muted { margin-top: 8rpx; display: block; color: rgba(255, 255, 255, .78); }
.heading-actions { display: flex; gap: 16rpx; flex-shrink: 0; }
.heading-actions .ghost, .business-heading > button { margin: 0; }
/* 深底上的次要操作改成描边幽灵按钮，而不是白底绿字 */
.business-heading .ghost {
  background: transparent;
  color: #fff;
  border-color: rgba(255, 255, 255, .45);
}

/* ---------- 角色导航 ---------- */

.business-nav {
  position: fixed;
  z-index: var(--z-nav);
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  /* 全局 box-sizing 是 border-box，所以安全区必须显式加到高度上，
     否则导航会被安全区吃掉一段，下方的固定条就会悬空。 */
  height: calc(96rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: var(--surface);
  border-top: 1rpx solid var(--line);
}
.business-nav .nav-item {
  position: relative;
  flex: 1;
  min-width: 0;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
  color: var(--ink-3);
  font-size: 26rpx;
  line-height: 1.4;
  border-top: 4rpx solid transparent;
}
.business-nav .nav-item.is-active {
  color: var(--brand);
  font-weight: 700;
  border-top-color: var(--brand);
  background: var(--brand-soft);
}
/* 待办角标：把「有多少事要做」从页面内容提到导航层。 */
.nav-badge {
  position: absolute;
  top: 8rpx;
  left: 50%;
  margin-left: 22rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: var(--danger);
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 32rpx;
  text-align: center;
  box-sizing: border-box;
}

/* ---------- 卡片与列表 ---------- */

.page .card {
  margin: var(--space-section-y) var(--space-page-x) 0;
  padding: var(--space-content-x);
  border-radius: 20rpx;
  background: var(--surface);
}
.page .card-title { font-size: 30rpx; }
.page .row { padding: 24rpx 0; }
.page .row .muted { display: block; margin-top: 8rpx; }
.page .metric { padding: 22rpx; border-radius: 16rpx; background: var(--sunken); }
.page .metric-value { font-size: 30rpx; }
.page .button-row > button { min-width: 0; font-size: 27rpx; white-space: normal; }

/* ---------- 返回与详情头 ---------- */

.back-link {
  display: block;
  color: var(--brand);
  font-size: 26rpx;
  padding: 8rpx 0 20rpx;
}
.detail-heading { margin-bottom: 20rpx; }
.detail-status {
  display: inline-block;
  margin: 16rpx 0 4rpx;
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
  background: var(--brand-soft);
  color: var(--brand-ink);
  font-size: 23rpx;
  font-weight: 600;
}
.task-detail-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--line);
  color: var(--ink-3);
  font-size: 25rpx;
}
.task-detail-toolbar .back-link { padding: 0; }
.task-detail-identity {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}
.request-store {
  min-width: 0;
  flex: 1;
  color: var(--ink-1);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.35;
  overflow-wrap: anywhere;
}
.task-detail-metric {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  background: var(--sunken);
  color: var(--ink-3);
  font-size: 25rpx;
}
.task-detail-metric > text:last-child {
  color: var(--ink-1);
  font-size: 38rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  text-align: right;
}
.task-detail-facts { margin-top: 8rpx; padding-top: 12rpx; border-top: 1rpx solid var(--line-soft); }
.task-detail-facts > view {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 24rpx;
  padding: 12rpx 0;
  font-size: 24rpx;
}
.task-detail-facts > view > text:first-child { flex: 0 0 140rpx; color: var(--ink-3); }
.task-detail-facts > view > text:last-child,
.task-detail-facts document-no { min-width: 0; color: var(--ink-2); text-align: right; overflow-wrap: anywhere; }

/* ---------- 任务列表 ---------- */

.task-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
  margin: var(--space-section-y) var(--space-page-x) 4rpx;
  color: var(--ink-1);
  font-size: 30rpx;
  font-weight: 700;
}
.task-heading > text:last-child { color: var(--ink-3); font-size: 24rpx; font-weight: 400; }
.task-list-card { padding-top: 8rpx !important; padding-bottom: 8rpx !important; }

.task-tabs {
  display: flex;
  gap: 32rpx;
  padding: 10rpx 24rpx 4rpx;
}
.task-tabs > view {
  padding: 22rpx 0;
  color: var(--ink-3);
  font-size: 26rpx;
  border-bottom: 4rpx solid transparent;
}
.task-tabs .selected { color: var(--brand); font-weight: 700; border-bottom-color: var(--brand); }
.task-count { margin-left: 8rpx; color: var(--warn); font-size: 24rpx; }

.task-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 96rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
}
.task-entry:last-child { border-bottom: 0; }
.task-entry > view { min-width: 0; flex: 1; }
.task-entry > view > text { display: block; }
.task-entry > text:last-child { flex-shrink: 0; max-width: 45%; color: var(--brand); font-size: 25rpx; }
.task-entry .muted { display: block; margin-top: 8rpx; font-size: 24rpx; }

/* ---------- 我的 / 账号菜单 ---------- */

.account-menu { margin: var(--space-section-y) var(--space-page-x) 0; padding: 0 var(--space-content-x); border-radius: 20rpx; background: var(--surface); }
.account-menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 100rpx;
  border-bottom: 1rpx solid var(--line-soft);
  font-size: 28rpx;
}
.account-menu-item:last-child { border-bottom: 0; }
/* 标签区纵向排列。用 <view> 而不是 <text>：<text> 是行内盒子，
   拿它做纵向 flex 在小程序里不可靠，长地址会横向溢出卡片。 */
.account-menu-item > text:first-child,
.account-menu-item > view:first-child {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
  min-width: 0;
  color: var(--ink-1);
}
.account-menu-item > text:last-child { flex-shrink: 0; color: var(--ink-faint); font-size: 32rpx; }
/* 选择器提到与箭头规则同级，靠源码顺序取胜，避免说明文字被当成箭头渲染 */
.account-menu-note,
.account-menu-item > text.account-menu-note {
  min-width: 0;
  color: var(--ink-3);
  font-size: 23rpx;
  line-height: 1.45;
  overflow-wrap: anywhere;
}
.account-logout { margin: 24rpx var(--space-page-x) 0; background: var(--surface); color: var(--danger); }

.command-history { margin: var(--space-section-y) var(--space-page-x) 0; padding: var(--space-content-x); border-radius: 20rpx; background: var(--surface); }
.command-recovery {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: var(--space-section-y) var(--space-page-x) 0;
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  background: var(--warn-soft);
}
.command-recovery > view { min-width: 0; flex: 1; }
.command-recovery text { display: block; overflow-wrap: anywhere; }
.command-recovery .muted { margin-top: 6rpx; }
.command-recovery button { flex: 0 0 auto; margin: 0; font-size: 24rpx; }

/* ---------- 搜索与状态筛选 ---------- */

.business-search {
  height: 80rpx;
  padding: 0 24rpx;
  border-radius: 12rpx;
  background: var(--sunken);
  font-size: 27rpx;
}
/* 列表头部的搜索 + 状态筛选，整条吸顶（sticky-bar 提供定位与满幅）。 */
.order-list-controls { padding-top: 16rpx; padding-bottom: 8rpx; }
.status-filters {
  display: flex;
  flex-wrap: nowrap;
  white-space: nowrap;
  gap: 32rpx;
  color: var(--ink-3);
  font-size: 26rpx;
}
.status-filters > text { flex-shrink: 0; padding: 14rpx 0; }
.status-filters .selected {
  color: var(--brand);
  font-weight: 700;
  border-bottom: 4rpx solid var(--brand);
}

/* ---------- 底部固定操作条 ---------- */

/* Fixed above the role nav so long forms never hide their own submit control. */
.page .action-bar { position: fixed; left: 0; right: 0; bottom: calc(96rpx + env(safe-area-inset-bottom)); z-index: var(--z-action); display: flex; align-items: center; gap: var(--space-control-gap); margin: 0; padding: 18rpx var(--space-content-x); background: rgba(255, 255, 255, .97); border-top: 1rpx solid var(--line); }
.page .action-bar > button { flex: 1; min-width: 0; margin: 0; font-size: 27rpx; }
.page .action-bar .action-secondary { flex: 0 0 150rpx; }

.page.has-action-bar { padding-bottom: calc(280rpx + env(safe-area-inset-bottom)); }
.page.has-test-workbench-root { padding-bottom: calc(280rpx + env(safe-area-inset-bottom)); }
.has-test-workbench-root .business-nav { bottom: calc(104rpx + env(safe-area-inset-bottom)); height: 96rpx; padding-bottom: 0; }
.page.has-test-workbench-root .action-bar { bottom: calc(200rpx + env(safe-area-inset-bottom)); }

/* ---------- 商品行 / 价格明细 ---------- */

.price-details-control {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  color: var(--ink-3);
  font-size: 24rpx;
}
.price-details-control switch { zoom: .7; }

.product-line-summary {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 8rpx;
}
.product-quantity { min-width: 0; color: var(--ink-2); font-size: 26rpx; overflow-wrap: anywhere; }
.product-line-amount { flex-shrink: 0; color: var(--ink-3); font-size: 25rpx; font-variant-numeric: tabular-nums; }

.assignment-caption { margin: 24rpx 0 4rpx; color: var(--ink-3); font-size: 24rpx; }
.assignment-group { margin-top: 20rpx; }
.assignment-group-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 22rpx;
  border-radius: 14rpx 14rpx 0 0;
  background: var(--sunken);
  font-size: 27rpx;
  font-weight: 600;
}
.assignment-group-heading > text:first-child { min-width: 0; flex: 1; color: var(--ink-1); overflow-wrap: anywhere; }
.assignment-group-heading .muted { flex-shrink: 0; font-weight: 400; }
.assignment-group-totals {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 28rpx;
  padding: 0 22rpx 18rpx;
  border-radius: 0 0 14rpx 14rpx;
  background: var(--sunken);
  font-size: 25rpx;
  color: var(--ink-2);
}
.assignment-product, .generated-order-product-block, .procurement-product-row { min-height: 96rpx; }
.page .assignment-product { padding: 24rpx 0; }
.assignment-product-heading { align-items: flex-start; }
.assignment-change { flex-shrink: 0; }
.assignment-change-label {
  min-height: 48rpx;
  padding: 4rpx 16rpx;
  border: 1rpx solid var(--line);
  border-radius: 10rpx;
  color: var(--brand);
  font-size: 24rpx;
  white-space: nowrap;
}
.assignment-change-label.is-disabled { color: var(--ink-faint); border-color: var(--line-soft); }

.assignment-price-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx 24rpx;
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 14rpx;
  background: var(--sunken);
}
.assignment-price-grid > view { min-width: 0; }
.price-label { display: block; color: var(--ink-3); font-size: 22rpx; }
.price-value { display: block; color: var(--ink-2); font-size: 27rpx; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
.price-unit { color: var(--ink-3); font-size: 22rpx; }
.amount-value { color: var(--ink-1); font-weight: 700; }

/* ---------- 供应商订单分组 ---------- */

.supplier-order-summary { margin-top: 24rpx; padding-top: 24rpx; border-top: 1rpx solid var(--line); }
.generated-order-products { margin-top: 12rpx; }
.generated-order-product-block { padding: 10rpx 0 14rpx; border-bottom: 1rpx solid var(--line-soft); }
.generated-order-product-block:last-child { border-bottom: 0; }
.generated-order-product {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 8rpx 0;
  color: var(--ink-1);
  font-size: 26rpx;
}
.generated-order-product text:first-child { min-width: 0; overflow-wrap: anywhere; }
.generated-order-product text:last-child { flex-shrink: 0; color: var(--ink-3); font-variant-numeric: tabular-nums; }
.generated-order-product-meta {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 8rpx 20rpx;
  color: var(--ink-3);
  font-size: 24rpx;
}
.order-count { flex-shrink: 0; color: var(--brand); font-size: 25rpx; font-weight: 600; }
.supplier-order-toggle { padding: 8rpx 0; }
.supplier-order-overview {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
  color: var(--ink-2);
  font-size: 24rpx;
}
.supplier-order-fold { flex-shrink: 0; color: var(--brand); font-weight: 600; }
.original-request-toggle {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 24rpx 0 4rpx;
  border-top: 1rpx solid var(--line);
  color: var(--brand);
  font-size: 25rpx;
}

/* ---------- 决策区 ---------- */

.task-rejection-note {
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 14rpx;
  background: var(--warn-soft);
  color: var(--warn);
  font-size: 25rpx;
}
.task-rejection-note text { display: block; margin: 6rpx 0; line-height: 1.5; overflow-wrap: anywhere; }
.task-rejection-note text:first-child { font-weight: 700; }

.task-decision-section { margin-top: 28rpx; padding-top: 24rpx; border-top: 1rpx solid var(--line); }
.task-decision-section .field-label { color: var(--ink-2); font-weight: 600; }

.funding-shortfall {
  margin-top: 24rpx;
  padding: 20rpx 22rpx;
  border-radius: 14rpx;
  background: var(--warn-soft);
  color: var(--warn);
  font-size: 27rpx;
  font-weight: 600;
}

.request-list-total {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 14rpx;
  color: var(--ink-3);
  font-size: 24rpx;
}
.request-list-total > text { color: var(--ink-1); font-size: 30rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.list-amount { display: block; margin-top: 10rpx; color: var(--ink-1); font-size: 30rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.procurement-summary {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 24rpx;
  margin-top: 12rpx;
  color: var(--ink-3);
  font-size: 25rpx;
}
.product-list-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }

/* ---------- 工作区切换栏让位 ----------

   切换栏（custom-tab-bar）和角色导航都锚在 bottom: 0，而切换栏层级更高。
   多工作区用户（兼任两个以上角色）会看到切换栏把角色导航完全盖住，
   「待办 / 订单 / 我的」就消失了。custom-tab-bar 把可见性回传给页面，
   页面加上 .has-workspace-tabbar 后，这里把角色导航、底部操作条和结算栏
   整体抬高一层，并给内容留出等量的滚动空间。

   放在 workspace.wxss 而非 app.wxss：页面样式优先级高于全局样式，
   这些规则必须能压过 .page.has-action-bar 和 .catalog-page.has-checkout。
   置于文件末尾，同优先级时靠源码顺序取胜。 */

.has-workspace-tabbar { --workspace-tabbar: calc(104rpx + env(safe-area-inset-bottom)); }
.has-workspace-tabbar .business-nav,
.has-workspace-tabbar .store-nav { bottom: var(--workspace-tabbar); }
.has-workspace-tabbar .action-bar,
.has-workspace-tabbar .order-bar { bottom: calc(var(--workspace-tabbar) + 96rpx + env(safe-area-inset-bottom)); }

.page.has-workspace-tabbar,
.store-page.has-workspace-tabbar { padding-bottom: calc(280rpx + env(safe-area-inset-bottom)); }
.page.has-workspace-tabbar.has-action-bar { padding-bottom: calc(410rpx + env(safe-area-inset-bottom)); }
/* 商品目录页高度固定，滚动区在页内，需要单独补足底部空间 */
.store-page.has-workspace-tabbar.catalog-page { padding-bottom: calc(330rpx + env(safe-area-inset-bottom)); }
.store-page.has-workspace-tabbar.catalog-page.has-checkout { padding-bottom: calc(430rpx + env(safe-area-inset-bottom)); }
