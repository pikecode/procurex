@import "../finance/index.wxss";

/* 门店账户页没有底部角色导航，内容可贴近屏幕底部。 */
.page { padding: 0 24rpx calc(48rpx + env(safe-area-inset-bottom)); }

/* ---------- 区块 ---------- */

.band {
  margin-top: 20rpx;
  padding: 28rpx;
  border-radius: 20rpx;
  background: var(--surface);
}
.band .form-title {
  display: block;
  margin-bottom: 24rpx;
  color: var(--ink-1);
  font-size: 30rpx;
  font-weight: 700;
}
.form-title { display: block; margin-bottom: 24rpx; font-weight: 600; }

.business-heading { margin: 0 -24rpx; border-radius: 0; }

/* ---------- 余额四宫格 ---------- */

.balance-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin: 20rpx 0;
}
.balance-grid > view {
  min-width: 0;
  padding: 22rpx;
  border-radius: 16rpx;
  background: var(--sunken);
}
.balance-grid text { display: block; }
.balance-grid .muted { color: var(--ink-3); font-size: 22rpx; }
.amount {
  display: block;
  margin-top: 8rpx;
  color: var(--ink-1);
  font-size: 32rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

/* ---------- 表单 ---------- */

.field { display: block; margin-bottom: 22rpx; }
.field-label { display: block; margin-bottom: 10rpx; color: var(--ink-3); font-size: 23rpx; }
.field input, .picker-value {
  min-height: 80rpx;
  border-radius: 12rpx;
  background: var(--sunken);
  padding: 0 20rpx;
}
.filters { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin: 18rpx 0; }
.filters picker { min-width: 0; }
.filters .supplier { grid-column: 1 / -1; }

/* ---------- 销账多选 ---------- */

.credit-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
}
.credit-row > view { min-width: 0; flex: 1; }
.credit-row > text { flex-shrink: 0; color: var(--ink-1); font-weight: 600; font-variant-numeric: tabular-nums; }

/* ---------- 按钮组 ---------- */

.operations { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 24rpx; }
.operations button {
  flex: 1;
  min-width: 180rpx;
  margin: 0;
  padding: 0 12rpx;
  font-size: 26rpx;
  white-space: nowrap;
}
.submit-actions { display: flex; gap: 16rpx; margin-top: 28rpx; }
.submit-actions button { flex: 1; min-width: 0; margin: 0; }

.menu-chevron { flex-shrink: 0; color: var(--ink-faint); font-size: 32rpx; }
