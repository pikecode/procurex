page {
  background: #f7f9f8;
  color: #18231f;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 160rpx;
  box-sizing: border-box;
}

.hero {
  padding: 18rpx 0 28rpx;
}

.eyebrow {
  color: #167e5a;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.title {
  display: block;
  margin-top: 10rpx;
  color: #1d2c24;
  font-size: 46rpx;
  font-weight: 800;
  line-height: 1.18;
}

.subtitle {
  margin-top: 12rpx;
  color: #75827a;
  font-size: 25rpx;
  line-height: 1.5;
}

.card {
  margin-top: 18rpx;
  padding: 26rpx;
  border: 1rpx solid #e8eeea;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 4rpx 18rpx rgba(33, 55, 45, .04);
}

.card-title {
  display: block;
  color: #24342c;
  font-size: 29rpx;
  font-weight: 750;
}

.muted {
  color: #7f8b85;
  font-size: 23rpx;
  line-height: 1.45;
}

.metric-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 18rpx;
}

.metric {
  padding: 20rpx;
  border: 1rpx solid #edf1ef;
  border-radius: 14rpx;
  background: #fbfcfb;
}

.metric-label {
  color: #8a9690;
  font-size: 21rpx;
}

.metric-value {
  display: block;
  margin-top: 8rpx;
  color: #187b59;
  font-size: 31rpx;
  font-weight: 800;
}

.field {
  margin-top: 18rpx;
}

.field-label {
  display: block;
  margin-bottom: 8rpx;
  color: #66736c;
  font-size: 23rpx;
}

input {
  height: 76rpx;
  padding: 0 22rpx;
  border: 1rpx solid #e2e9e5;
  border-radius: 12rpx;
  background: #fff;
  color: #24342c;
  font-size: 26rpx;
  box-sizing: border-box;
}

.button-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 22rpx;
}

button {
  height: 76rpx;
  border-radius: 12rpx;
  font-size: 25rpx;
  font-weight: 700;
}

.primary {
  background: #167e5a;
  color: #fff;
}

.secondary {
  background: #eef6f1;
  color: #167e5a;
}

.danger {
  background: #fff0ed;
  color: #b34a40;
}

.list {
  margin-top: 18rpx;
}

.row {
  padding: 22rpx 0;
  border-top: 1rpx solid #edf1ef;
}

.row:first-child {
  border-top: 0;
}

.row-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.row-title text:first-child {
  color: #24342c;
  font-size: 27rpx;
  font-weight: 700;
}

.tag {
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  background: #eaf5ef;
  color: #318363;
  font-size: 20rpx;
  font-weight: 700;
  white-space: nowrap;
}

.tag-warn {
  background: #fff3e9;
  color: #a85d22;
}

.tag-fail {
  background: #fff0ed;
  color: #b34a40;
}

.footer-action {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e8eeea;
  background: rgba(255, 255, 255, .96);
}
