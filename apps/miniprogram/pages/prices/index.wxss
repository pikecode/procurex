/* 快速改价（该目录不在小程序打包范围内，样式与全局体系保持一致） */

.prices-page { padding: 24rpx; }
.prices-title {
  display: block;
  padding: 12rpx 4rpx 24rpx;
  color: var(--ink-1);
  font-size: 38rpx;
  font-weight: 700;
}
.price-form, .price-section {
  margin-top: 20rpx;
  padding: 28rpx;
  border-radius: 20rpx;
  background: var(--surface);
}
.price-section { border-bottom: 0; }
.price-pair { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 20rpx; }
.price-pair .field, .price-pair picker { min-width: 0; }
.price-form input, .price-form textarea { box-sizing: border-box; width: 100%; min-width: 0; }
.price-form textarea { min-height: 180rpx; }
.price-summary, .price-record { display: flex; flex-direction: column; gap: 12rpx; padding: 20rpx 0; overflow-wrap: anywhere; }
.price-record { border-bottom: 1rpx solid var(--line-soft); }
.price-section-head { display: flex; align-items: center; justify-content: space-between; }
.price-notice { margin-top: 20rpx; padding: 22rpx; border-radius: 16rpx; background: var(--brand-soft); color: var(--brand-ink); font-size: 25rpx; }
.price-pending { margin-top: 20rpx; padding: 22rpx; border-radius: 16rpx; background: var(--warn-soft); }
.price-pending > text { display: block; padding-bottom: 16rpx; color: var(--warn); font-size: 25rpx; }
.price-pending button { width: 100%; }