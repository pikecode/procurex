.workspace-navigation {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: var(--z-tabbar);
  background: var(--surface);
  border-top: 1rpx solid var(--line);
  padding-bottom: env(safe-area-inset-bottom);
}
.workspace-items { display: flex; }
.workspace-tab {
  flex: 1;
  min-width: 0;
  height: 104rpx;
  margin: 0;
  padding: 0 6rpx;
  border-radius: 0;
  background: transparent;
  color: var(--ink-3);
  font-size: 26rpx;
  font-weight: 500;
  line-height: 104rpx;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  letter-spacing: 0;
  transition: color .15s ease;
}
.workspace-tab::after { border: 0; }
.workspace-tab:active { color: var(--brand); }
.workspace-tab.is-active {
  color: var(--brand);
  font-weight: 700;
  background: var(--brand-soft);
  box-shadow: inset 0 4rpx var(--brand);
}
.test-label {
  padding: 8rpx 20rpx;
  background: var(--warn-soft);
  color: var(--warn);
  font-size: 22rpx;
  text-align: center;
}
