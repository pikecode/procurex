@import "../finance/index.wxss";
.page { padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.band { background: #fff; padding: 24rpx; margin-bottom: 16rpx; }
.field { display: block; margin-bottom: 20rpx; }
.field-label { display: block; font-size: 26rpx; color: #59645f; margin-bottom: 8rpx; }
.field input, .picker-value { min-height: 72rpx; background: #f1f4f2; padding: 0 16rpx; border-radius: 8rpx; box-sizing: border-box; }
.picker-value { display: flex; align-items: center; justify-content: space-between; }
.filters { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; margin: 16rpx 0; }
.filters picker { min-width: 0; }
.filters .supplier { grid-column: 1 / -1; }
.balance-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; margin: 20rpx 0; }
.balance-grid text { display: block; }
.amount { font-size: 32rpx; font-weight: 600; }
.credit-row { display: flex; align-items: center; gap: 12rpx; padding: 20rpx 0; border-bottom: 1rpx solid #e5eae7; }
.credit-row > view { flex: 1; min-width: 0; }
.operations { display: flex; flex-wrap: wrap; gap: 12rpx; }
.operations button { flex: 1; margin: 0; font-size: 26rpx; white-space: nowrap; padding: 0 12rpx; }
.submit-actions { display: flex; gap: 16rpx; margin-top: 24rpx; }
.submit-actions button { flex: 1; margin: 0; }
.form-title { display: block; font-weight: 600; margin-bottom: 24rpx; }
