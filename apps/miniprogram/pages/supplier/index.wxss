@import "../../styles/workspace.wxss";


/* ---------- 对账标签组 ---------- */

.reconcile-tabs {
  display: flex;
  gap: 40rpx;
  padding: 10rpx var(--space-page-x) 4rpx;
}
.reconcile-tabs > view {
  padding: 22rpx 0;
  color: var(--ink-3);
  font-size: 27rpx;
  border-bottom: 4rpx solid transparent;
}
.reconcile-tabs .selected { color: var(--brand); font-weight: 700; border-bottom-color: var(--brand); }
.supplier-mine-menu { margin-top: var(--space-section-y); }
.reconcile-count { color: var(--ink-4); font-size: 22rpx; }
.supplier-bill-list, .supplier-payment-list { display: flex; flex-direction: column; gap: 14rpx; }
.supplier-bill-item, .supplier-payment-item {
  padding: 20rpx;
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  background: var(--surface);
}
.supplier-finance-item-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 14rpx; }
.supplier-finance-item-head > view { min-width: 0; display: flex; flex-direction: column; gap: 5rpx; }
.supplier-finance-title { color: var(--ink-1); font-size: 27rpx; font-weight: 700; }
.supplier-finance-period { color: var(--ink-4); font-size: 21rpx; overflow-wrap: anywhere; }
.supplier-bill-payable { display: flex; align-items: baseline; justify-content: space-between; gap: 12rpx; margin-top: 18rpx; padding: 14rpx 16rpx; border-radius: 10rpx; background: var(--sunken); }
.supplier-bill-payable text:first-child { color: var(--ink-3); font-size: 22rpx; }
.supplier-bill-payable text:last-child { color: var(--ink-1); font-size: 31rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.supplier-bill-breakdown { display: flex; gap: 20rpx; margin-top: 14rpx; }
.supplier-bill-breakdown view { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.supplier-bill-breakdown text:first-child { color: var(--ink-4); font-size: 20rpx; }
.supplier-bill-breakdown text:last-child { color: var(--ink-2); font-size: 23rpx; font-variant-numeric: tabular-nums; }
.supplier-payment-amount { display: flex; align-items: baseline; justify-content: space-between; gap: 12rpx; margin-top: 16rpx; }
.supplier-payment-amount text:first-child { color: var(--ink-1); font-size: 31rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.supplier-payment-amount text:last-child { flex-shrink: 0; color: var(--ink-4); font-size: 21rpx; }
.supplier-finance-open { margin-top: 14rpx; padding-top: 12rpx; border-top: 1rpx solid var(--line-soft); color: var(--brand); font-size: 22rpx; text-align: right; }
.finance-empty { padding: 28rpx 0; color: var(--ink-4); font-size: 24rpx; text-align: center; }

.source-return {
  padding: 22rpx var(--space-content-x);
  border-bottom: 1rpx solid var(--line);
  background: var(--surface);
  color: var(--brand);
  font-size: 26rpx;
}

/* ---------- 待发货任务卡 ---------- */

.supplier-task-entry { align-items: stretch; gap: 12rpx; }
.supplier-task-main { min-width: 0; flex: 1; }
.supplier-task-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.supplier-task-store {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  color: var(--ink-1);
  font-size: 30rpx;
  font-weight: 700;
}
.supplier-task-amount {
  flex-shrink: 0;
  color: var(--ink-1);
  font-size: 30rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}
.supplier-task-products, .supplier-order-products {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  min-width: 0;
  margin-top: 12rpx;
  padding: 10rpx 14rpx;
  border-radius: 12rpx;
  background: var(--sunken);
  color: var(--ink-3);
  font-size: 24rpx;
  line-height: 1.45;
}
.supplier-task-count { flex-shrink: 0; color: var(--ink-2); }
.supplier-task-preview,
.supplier-order-products > text:nth-child(2) {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.supplier-task-more, .supplier-order-products > text:last-child { flex-shrink: 0; color: var(--ink-4); }
.supplier-task-meta {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 12rpx;
  color: var(--ink-4);
  font-size: 22rpx;
}
.supplier-task-meta text:first-child { min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.supplier-task-meta text:last-child { flex-shrink: 0; }
.supplier-task-chevron { display: flex; align-items: center; color: var(--ink-faint); font-size: 36rpx; }
.supplier-exception-heading { margin-top: 20rpx; }
.supplier-exception-card { padding-top: 0 !important; padding-bottom: 0 !important; }
.supplier-exception-empty { padding: 18rpx 0; color: var(--ink-4); font-size: 24rpx; }
.supplier-history-link { display: flex; align-items: center; justify-content: space-between; min-height: 76rpx; border-top: 1rpx solid var(--line-soft); color: var(--brand); font-size: 24rpx; }
.supplier-history-link text:last-child { color: var(--ink-3); }

/* ---------- 订单详情 ---------- */

.detail-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.detail-heading .back-link { margin: 0; }
.detail-heading .card-title { margin: 0; font-size: 26rpx; color: var(--ink-3); }
.destination {
  margin-bottom: 20rpx;
  padding: 22rpx var(--space-content-x);
  border-radius: 16rpx;
  background: var(--sunken);
  overflow-wrap: anywhere;
}
.destination-label { display: block; color: var(--ink-3); font-size: 22rpx; font-weight: 600; }
.supplier-order-summary { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; margin: 8rpx 0 12rpx; }
.supplier-order-summary .summary-store { min-width: 0; flex: 1; overflow-wrap: anywhere; }
.supplier-order-summary .status { flex-shrink: 0; }
.supplier-detail-number, .shipment-record-number { display: flex; align-items: baseline; gap: 12rpx; color: var(--ink-3); font-size: 24rpx; line-height: 1.5; }
.supplier-detail-number { margin-bottom: 20rpx; }
.supplier-detail-number > text, .shipment-record-number > text { flex-shrink: 0; }
.supplier-detail-number document-no, .shipment-record-number document-no { min-width: 0; color: var(--ink-2); }
.summary-store { display: block; color: var(--ink-1); font-size: 34rpx; font-weight: 700; line-height: 1.35; }
.operation-title { margin: 22rpx 0 12rpx; color: var(--ink-1); font-size: 30rpx; font-weight: 700; }
.detail-section-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 26rpx; padding: 18rpx 0 10rpx; border-top: 1rpx solid var(--line); color: var(--ink-1); font-size: 28rpx; font-weight: 700; }
.detail-section-heading > text:last-child { color: var(--ink-3); font-size: 22rpx; font-weight: 400; }
.shipment-history { margin-top: 8rpx; }
.shipment-history .detail-section-heading { margin-top: 0; }
.shipment-history-row { padding: 20rpx 0; }
.shipment-record-heading { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-bottom: 10rpx; font-size: 24rpx; color: var(--ink-2); }
.shipment-record-heading .status { flex-shrink: 0; }
.shipment-record-actions { display: flex; align-items: center; justify-content: flex-end; gap: 16rpx; margin-top: 14rpx; }
.shipment-record-actions button.secondary { flex: none; width: auto; margin: 0; padding: 0 20rpx; }
.shipment-products { margin-top: 8rpx; color: var(--ink-2); font-size: 24rpx; }

.supplier-orders-list { display: flex; flex-direction: column; gap: 14rpx; }
.page .supplier-order-list-item {
  display: block;
  margin: 0;
  padding: 20rpx;
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  background: var(--surface);
}
.supplier-order-topline { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.supplier-order-store { min-width: 0; color: var(--ink-1); font-size: 29rpx; font-weight: 700; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.supplier-order-topline .status { flex-shrink: 0; }
.supplier-order-meta { display: flex; align-items: baseline; flex-wrap: wrap; gap: 4rpx 8rpx; margin-top: 10rpx; color: var(--ink-3); font-size: 21rpx; }
.supplier-order-no-label { flex-shrink: 0; color: var(--ink-4); }
.supplier-order-meta document-no { min-width: 0; color: var(--ink-2); }
.supplier-order-date { margin-left: auto; flex-shrink: 0; color: var(--ink-4); }
.supplier-order-list-item .supplier-order-products { display: block; margin-top: 14rpx; padding: 12rpx 14rpx; border-radius: 10rpx; background: var(--sunken); color: var(--ink-2); font-size: 23rpx; line-height: 1.5; }
.supplier-order-products-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 4rpx; color: var(--ink-3); font-size: 21rpx; }
.supplier-order-preview { display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow-wrap: anywhere; }
.supplier-order-more { display: block; margin-top: 4rpx; color: var(--ink-4); font-size: 21rpx; }
.order-list-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--line-soft);
}
.supplier-order-total { display: flex; align-items: baseline; gap: 10rpx; min-width: 0; }
.supplier-order-total text:first-child { color: var(--ink-3); font-size: 22rpx; }
.supplier-order-total text:last-child { color: var(--ink-1); font-size: 29rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.order-open { flex-shrink: 0; color: var(--brand); font-size: 24rpx; font-weight: 600; }
.order-empty { padding: 64rpx 0; text-align: center; color: var(--ink-3); font-size: 27rpx; }
.supplier-order-sort-hint { padding: 0 0 12rpx; color: var(--ink-4); font-size: 21rpx; }

.supplier-shipment-item { padding: 22rpx 0; }
.supplier-product-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 8rpx;
  color: var(--ink-1);
  font-size: 29rpx;
  font-weight: 600;
}
.supplier-product-heading > text:first-child { min-width: 0; flex: 1; overflow-wrap: anywhere; }
.supplier-shipment-item .muted { margin-top: 6rpx; font-size: 23rpx; }
.supplier-shipment-item .field { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid var(--line-soft); }
.supplier-shipment-item .field .field-label { color: var(--brand-ink); font-weight: 600; }
.shipment-quantity-error { display: block; margin-top: 8rpx; color: var(--danger); font-size: 24rpx; }

.revision-line { padding: 18rpx 0; border-bottom: 1rpx solid var(--line-soft); }
.revision-evidence-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 12rpx;
}
.revision-evidence-tile { position: relative; height: 176rpx; min-width: 0; overflow: hidden; border-radius: 12rpx; }
.revision-evidence-tile image { width: 100%; height: 100%; }
.evidence-remove {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 40rpx;
  height: 40rpx;
  padding: 0;
  line-height: 38rpx;
  font-size: 26rpx;
  color: #fff;
  background: rgba(20, 30, 24, .55);
  border-radius: 20rpx;
}
.evidence-add {
  height: 176rpx;
  width: 100%;
  margin: 0;
  line-height: 176rpx;
  font-size: 36rpx;
  color: var(--brand);
  background: var(--brand-soft);
  border-radius: 12rpx;
}
.freight-picker { display: block; }
.freight-amount, .freight-reason { width: 100%; }

/* ---------- 账单 ---------- */

.statement-stores { margin: 28rpx 0; padding-top: 24rpx; border-top: 1rpx solid var(--line); }
.statement-order { padding-bottom: 20rpx; border-bottom: 1rpx solid var(--line-soft); }
.statement-order .statement-order-source { border-bottom: 0; }
.statement-products-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
  color: var(--brand);
  font-size: 25rpx;
}
.statement-products-toggle {
  width: 56rpx;
  height: 56rpx;
  margin: 0;
  padding: 0;
  line-height: 56rpx;
  font-size: 34rpx;
  border-radius: 0;
  background: transparent;
  color: var(--brand);
  transform: rotate(90deg);
  transition: transform .18s ease;
}
.statement-products-toggle.is-expanded { transform: rotate(-90deg); }
.statement-products { padding: 4rpx 0 20rpx 20rpx; border-left: 4rpx solid var(--line); }
.statement-products .muted { font-size: 24rpx; }
.statement-adjustment-source, .statement-payment-source { transition: background-color .15s ease; }
/* 额外运费申请：与主操作区之间保持明确的分隔 */
.freight-request { margin-top: 28rpx; padding-top: 24rpx; border-top: 1rpx solid var(--line); }
/* Phone numbers are the contact action; no separate call-to-contact button. */
.contact-phone { color: var(--brand, #167e5a); text-decoration: underline; }
.shipment-selection { display: flex; align-items: center; gap: 12rpx; margin-bottom: 12rpx; font-size: 26rpx; }
.delivery-finish-option { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 0; border-bottom: 1rpx solid #e6e9e8; }
.delivery-progress { padding: 24rpx 0; border-top: 1rpx solid #e6e9e8; }
.delivery-progress > text { display: block; margin-bottom: 12rpx; }
.exception-reply-form { margin-top: 20rpx; padding: 20rpx 0; border-top: 1rpx solid #dce3df; }
.exception-reply-form textarea { box-sizing: border-box; width: 100%; height: 160rpx; padding: 18rpx; border: 1rpx solid #dce3df; border-radius: 8rpx; font-size: 28rpx; }
.exception-reply-history { padding: 18rpx 0; border-bottom: 1rpx dashed #dce3df; }
