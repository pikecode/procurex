/* The date carries the visual weight; the sequence recedes so adjacent rows stay distinguishable. */
.doc-no, .doc-no-plain {
  color: inherit;
  font-variant-numeric: tabular-nums;
  overflow-wrap: anywhere;
}
.doc-no-date { font-weight: 600; }
.doc-no-seq { font-weight: 400; color: var(--ink-4); }