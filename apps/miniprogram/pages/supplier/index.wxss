@import "../../styles/workspace.wxss";

/* ---------- 对账标签组 ---------- */

.reconcile-tabs {
  display: flex;
  gap: 40rpx;
  padding: 10rpx var(--space-page-x) 4rpx;
}
.reconcile-tabs > view {
  padding: 22rpx 0;
  color: var(--ink-3);
  font-size: 27rpx;
  border-bottom: 4rpx solid transparent;
}
.reconcile-tabs .selected { color: var(--brand); font-weight: 700; border-bottom-color: var(--brand); }
.reconcile-guide {
  margin: var(--space-section-y) var(--space-page-x) 0;
  padding: 20rpx 22rpx;
  border-left: 5rpx solid var(--brand);
  border-radius: 12rpx;
  background: var(--brand-soft);
  color: var(--ink-3);
  font-size: 23rpx;
  line-height: 1.55;
}
.reconcile-guide text { display: block; }
.reconcile-guide-title { margin-bottom: 4rpx; color: var(--brand-ink); font-size: 26rpx; font-weight: 700; }
.supplier-mine-menu { margin-top: var(--space-section-y); }

.source-return {
  padding: 22rpx var(--space-content-x);
  border-bottom: 1rpx solid var(--line);
  background: var(--surface);
  color: var(--brand);
  font-size: 26rpx;
}

/* ---------- 待发货任务卡 ---------- */

.supplier-task-entry { align-items: stretch; gap: 12rpx; }
.supplier-task-main { min-width: 0; flex: 1; }
.supplier-task-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.supplier-task-store {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  color: var(--ink-1);
  font-size: 30rpx;
  font-weight: 700;
}
.supplier-task-amount {
  flex-shrink: 0;
  color: var(--ink-1);
  font-size: 30rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}
.supplier-task-products, .supplier-order-products {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  min-width: 0;
  margin-top: 12rpx;
  padding: 10rpx 14rpx;
  border-radius: 12rpx;
  background: var(--sunken);
  color: var(--ink-3);
  font-size: 24rpx;
  line-height: 1.45;
}
.supplier-task-count { flex-shrink: 0; color: var(--ink-2); }
.supplier-task-preview,
.supplier-order-products > text:nth-child(2) {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.supplier-task-more, .supplier-order-products > text:last-child { flex-shrink: 0; color: var(--ink-4); }
.supplier-task-meta {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 12rpx;
  color: var(--ink-4);
  font-size: 22rpx;
}
.supplier-task-meta text:first-child { min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.supplier-task-meta text:last-child { flex-shrink: 0; }
.supplier-task-chevron { display: flex; align-items: center; color: var(--ink-faint); font-size: 36rpx; }

/* ---------- 订单详情 ---------- */

.destination {
  margin-bottom: 20rpx;
  padding: 22rpx var(--space-content-x);
  border-radius: 16rpx;
  background: var(--sunken);
  overflow-wrap: anywhere;
}
.destination-label { display: block; color: var(--ink-3); font-size: 22rpx; font-weight: 600; }
.supplier-order-summary { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; margin: 8rpx 0 22rpx; }
.supplier-order-summary > view { min-width: 0; flex: 1; }
.supplier-order-summary .muted { display: block; margin-top: 8rpx; }
.summary-store { display: block; color: var(--ink-1); font-size: 34rpx; font-weight: 700; line-height: 1.35; }
.operation-title { margin: 22rpx 0 12rpx; color: var(--ink-1); font-size: 30rpx; font-weight: 700; }
.detail-section-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 26rpx; padding: 18rpx 0 10rpx; border-top: 1rpx solid var(--line); color: var(--ink-1); font-size: 28rpx; font-weight: 700; }
.detail-section-heading > text:last-child { color: var(--ink-3); font-size: 22rpx; font-weight: 400; }
.shipment-history { margin-top: 8rpx; }
.shipment-history .detail-section-heading { margin-top: 0; }
.shipment-history-row { padding: 20rpx 0; }
.shipment-products { margin-top: 8rpx; color: var(--ink-2); font-size: 24rpx; }

.supplier-order-list-item { padding: 24rpx 0; }
.order-list-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line-soft);
}
.order-list-footer .list-amount { margin-top: 0; }
.order-open { flex-shrink: 0; color: var(--brand); font-size: 24rpx; font-weight: 600; }
.order-empty { padding: 64rpx 0; text-align: center; color: var(--ink-3); font-size: 27rpx; }

.supplier-shipment-item { padding: 22rpx 0; }
.supplier-product-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 8rpx;
  color: var(--ink-1);
  font-size: 29rpx;
  font-weight: 600;
}
.supplier-product-heading > text:first-child { min-width: 0; flex: 1; overflow-wrap: anywhere; }
.supplier-shipment-item .muted { margin-top: 6rpx; font-size: 23rpx; }
.supplier-shipment-item .field { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid var(--line-soft); }
.supplier-shipment-item .field .field-label { color: var(--brand-ink); font-weight: 600; }
.shipment-quantity-error { display: block; margin-top: 8rpx; color: var(--danger); font-size: 24rpx; }

.revision-line { padding: 18rpx 0; border-bottom: 1rpx solid var(--line-soft); }
.revision-evidence-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 12rpx;
}
.revision-evidence-tile { position: relative; height: 176rpx; min-width: 0; overflow: hidden; border-radius: 12rpx; }
.revision-evidence-tile image { width: 100%; height: 100%; }
.evidence-remove {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 40rpx;
  height: 40rpx;
  padding: 0;
  line-height: 38rpx;
  font-size: 26rpx;
  color: #fff;
  background: rgba(20, 30, 24, .55);
  border-radius: 20rpx;
}
.evidence-add {
  height: 176rpx;
  width: 100%;
  margin: 0;
  line-height: 176rpx;
  font-size: 36rpx;
  color: var(--brand);
  background: var(--brand-soft);
  border-radius: 12rpx;
}
.freight-picker { display: block; }
.freight-amount, .freight-reason { width: 100%; }

/* ---------- 账单 ---------- */

.statement-stores { margin: 28rpx 0; padding-top: 24rpx; border-top: 1rpx solid var(--line); }
.statement-order { padding-bottom: 20rpx; border-bottom: 1rpx solid var(--line-soft); }
.statement-order .statement-order-source { border-bottom: 0; }
.statement-products-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
  color: var(--brand);
  font-size: 25rpx;
}
.statement-products-toggle {
  width: 56rpx;
  height: 56rpx;
  margin: 0;
  padding: 0;
  line-height: 56rpx;
  font-size: 34rpx;
  border-radius: 0;
  background: transparent;
  color: var(--brand);
  transform: rotate(90deg);
  transition: transform .18s ease;
}
.statement-products-toggle.is-expanded { transform: rotate(-90deg); }
.statement-products { padding: 4rpx 0 20rpx 20rpx; border-left: 4rpx solid var(--line); }
.statement-products .muted { font-size: 24rpx; }
.statement-adjustment-source, .statement-payment-source { transition: background-color .15s ease; }
/* 额外运费申请：与主操作区之间保持明确的分隔 */
.freight-request { margin-top: 28rpx; padding-top: 24rpx; border-top: 1rpx solid var(--line); }
/* Phone numbers are the contact action; no separate call-to-contact button. */
.contact-phone { color: var(--brand, #167e5a); text-decoration: underline; }
