<view class="evidence-list"><view class="evidence-file" wx:for="{{rows}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><image wx:if="{{item.path}}" class="thumbnail" src="{{item.path}}" mode="aspectFill" /><view wx:else class="thumbnail placeholder">{{item.loading ? '加载中' : item.failed ? '点击重试' : '文件'}}</view><text>{{item.filename || '凭证'}}</text></view></view><text wx:if="{{error}}" class="error">{{error}}</text>
