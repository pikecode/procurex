/* 门店 / 供应商资料页 */

.profile-page { padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }

/* 资料页页头同样接住原生导航栏。 */
.profile-heading {
  padding: 30rpx var(--space-content-x) 28rpx;
  background: var(--brand-deep);
}
.profile-heading-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.profile-title {
  min-width: 0;
  flex: 1;
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.35;
  overflow-wrap: anywhere;
}
.profile-caption { display: block; margin-top: 12rpx; color: rgba(255, 255, 255, .78); font-size: 24rpx; }
.profile-refresh {
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.4;
  flex: 0 0 auto;
  margin: 0;
  height: 64rpx;
  font-size: 24rpx;
  font-weight: 600;
  background: transparent;
  color: #fff;
  border: 1rpx solid rgba(255, 255, 255, .45);
}

.profile-fields {
  margin: var(--space-section-y) var(--space-page-x) 0;
  padding: 8rpx var(--space-content-x);
  border-radius: 20rpx;
  background: var(--surface);
}
.profile-field {
  display: grid;
  grid-template-columns: 180rpx minmax(0, 1fr);
  gap: 20rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
  line-height: 1.5;
}
.profile-field:last-child { border-bottom: 0; }
.profile-label { color: var(--ink-3); font-size: 24rpx; }
.profile-value { min-width: 0; color: var(--ink-1); font-size: 27rpx; overflow-wrap: anywhere; }

.loading-state { padding: 56rpx var(--space-content-x); color: var(--ink-3); font-size: 25rpx; text-align: center; }
.profile-page .error-banner { margin: var(--space-section-y) var(--space-page-x) 0; }
