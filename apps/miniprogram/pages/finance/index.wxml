<wxs src="../../utils/labels.wxs" module="labels" />
<view class="page {{selected.canReview && !pendingCommand ? 'has-action-bar' : ''}}">
  <view class="business-heading"><view><text class="business-title">公司财务</text><text class="muted">{{user.displayName}}</text></view><button class="ghost" bindtap="loadWork" disabled="{{loading || reviewing}}" loading="{{loading}}">刷新</button></view>
  <view class="error-banner" wx:if="{{error}}"><text>{{error}}</text><button class="ghost" bindtap="loadWork" disabled="{{loading || reviewing}}">刷新数据</button></view>
  <view class="workspace-loading" wx:if="{{loading}}">正在读取账款</view>
  <view class="card" wx:if="{{pendingCommand}}"><text class="card-title">上次操作结果待确认</text><button class="secondary" bindtap="recoverCommand" disabled="{{reviewing}}" loading="{{reviewing}}">核对提交结果</button></view>
  <view class="card" wx:if="{{detailLoading}}">正在读取明细</view>
  <view class="card" wx:if="{{selected}}">
    <view class="back-link" bindtap="backToList">返回列表</view>
    <view class="row-title"><text>{{selected.title}}</text><text class="tag">{{labels.status(selected.status || selected.settlementStatus)}}</text></view>
    <block wx:if="{{selectedKind === 'payment'}}">
      <view class="detail-line">{{labels.status(selected.direction)}} · {{selected.businessDate}}</view><text class="finance-amount">¥{{labels.money(selected.amount)}}</text>
      <view class="muted" wx:if="{{selected.remark}}">{{selected.remark}}</view><view class="muted" wx:if="{{selected.rejectedReason}}">驳回原因：{{selected.rejectedReason}}</view>
      <view class="row" wx:for="{{selected.allocations}}" wx:key="id"><view class="row-title"><text>{{item.supplierOrderNo || '关联订单'}}</text><text>¥{{labels.money(item.amount)}}</text></view></view>
      <evidence-files files="{{selected.evidenceFiles}}" />
      <view class="muted" wx:if="{{!selected.evidenceFiles.length}}">未附付款凭证</view>
      <view class="button-row action-bar" wx:if="{{selected.canReview && !reviewMode && !pendingCommand}}"><button class="primary" data-action="confirm" bindtap="startReview">核对收款</button><button class="ghost action-secondary" data-action="reject" bindtap="startReview">驳回</button></view>
      <view wx:if="{{reviewMode}}" class="review-band"><text class="card-title">{{reviewMode === 'confirm' ? '确认收到款项' : '驳回付款记录'}}</text><view class="detail-line">{{selected.paymentNo}} · ¥{{labels.money(selected.amount)}}</view><input wx:if="{{reviewMode === 'reject'}}" class="business-search" maxlength="300" placeholder="驳回原因（必填）" value="{{reason}}" bindinput="onReason" disabled="{{reviewing}}" /></view>
      <view wx:if="{{reviewMode}}" class="action-bar"><button class="secondary action-secondary" bindtap="cancelReview" disabled="{{reviewing}}">取消</button><button class="{{reviewMode === 'reject' ? 'danger' : 'primary'}}" bindtap="submitReview" disabled="{{reviewing || pendingCommand || (reviewMode === 'reject' && !reason)}}" loading="{{reviewing}}">{{reviewMode === 'confirm' ? '确认收款' : '确认驳回'}}</button></view>
    </block>
    <block wx:else><view class="muted">{{selected.periodText}}</view><view class="detail-line">待结算 ¥{{labels.money(selected.payableAmount)}}</view><view class="detail-line">已确认 ¥{{labels.money(selected.confirmedPaidAmount)}} · 待确认 ¥{{labels.money(selected.pendingPaymentAmount)}}</view><view class="row" wx:for="{{selected.lines}}" wx:key="settlementItemId"><view class="row-title"><text>{{item.supplierOrderNo}}</text><text>¥{{labels.money(item.totalAmount)}}</text></view><view class="muted">货款 ¥{{labels.money(item.goodsAmount)}} · 运费 ¥{{labels.money(item.freightAmount)}}</view></view><view class="muted" wx:if="{{!selected.lines.length}}">暂无来源订单</view></block>
  </view>
  <block wx:if="{{!selected && !detailLoading && activeView === 'tasks'}}"><view class="task-heading"><text>待核对门店收款</text><text>{{loading || error ? '—' : tasks.length}}</text></view><view class="card" wx:for="{{tasks}}" wx:key="id" data-id="{{item.id}}" data-kind="payment" bindtap="openRecord"><view class="row-title"><text>{{item.subtitle}}</text><text class="tag">待核对</text></view><view class="muted">{{item.title}} · {{item.dateText}}</view><text class="list-amount">¥{{labels.money(item.amount)}}</text></view><view class="empty-state" wx:if="{{!tasks.length && !loading && !error}}">暂无待核对收款</view></block>
  <block wx:if="{{!selected && !detailLoading && activeView === 'books'}}"><view class="task-tabs"><view class="{{book === 'payments' ? 'selected' : ''}}" data-book="payments" bindtap="chooseBook">收付款</view><view class="{{book === 'stores' ? 'selected' : ''}}" data-book="stores" bindtap="chooseBook">门店账单</view><view class="{{book === 'suppliers' ? 'selected' : ''}}" data-book="suppliers" bindtap="chooseBook">供应商账单</view></view><view class="card"><input class="business-search" placeholder="搜索名称或单号" value="{{search}}" bindinput="onSearch" /><view class="row" wx:for="{{visibleRecords}}" wx:key="id" data-id="{{item.id}}" data-kind="{{item.kind}}" bindtap="openRecord"><view class="row-title"><text>{{item.title}}</text><text>¥{{labels.money(item.amount)}}</text></view><view class="muted">{{item.subtitle || item.periodText}}</view><view class="muted">{{labels.status(item.status)}} ›</view></view><view class="empty-state" wx:if="{{!visibleRecords.length && !loading && !error}}">暂无匹配记录</view></view></block>
  <block wx:if="{{activeView === 'mine'}}"><view class="card"><text class="card-title">{{user.displayName}}</text><text class="muted">公司财务</text></view><button class="account-logout" bindtap="logout">退出登录</button></block>
  <view class="business-nav"><view class="nav-item {{activeView === 'tasks' ? 'is-active' : ''}}" data-view="tasks" bindtap="changeView">待办</view><view class="nav-item {{activeView === 'books' ? 'is-active' : ''}}" data-view="books" bindtap="changeView">账款</view><view class="nav-item {{activeView === 'mine' ? 'is-active' : ''}}" data-view="mine" bindtap="changeView">我的</view></view>
  <button class="secondary" wx:if="{{activeView === 'books' && !selected && moreRecords}}" bindtap="nextRecords">加载更多</button>
</view>
